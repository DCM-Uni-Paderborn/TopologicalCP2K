+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Native character decomposition and metric-aware inversion representations.
+! **************************************************************************************************
+MODULE topology_symmetry
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE kinds,                           ONLY: dp
+
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: character_multiplicities, inversion_representation
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Decompose a character against a complete unitary character table.
+!> \param character One character per group element (not per conjugacy class)
+!> \param table Characters, group element first and irrep second; identity first
+!> \param multiplicities Nonnegative integer multiplicities, invalid unless status=0
+!> \param tolerance Absolute numerical tolerance
+!> \param status Zero on success, negative for invalid/incomplete/nonintegral data
+!> \note All projective irreps must use the same factor system. This kernel does not
+!>       infer a space group or certify the supplied character table's provenance.
+! **************************************************************************************************
+   SUBROUTINE character_multiplicities(CHARACTER, table, multiplicities, tolerance, status)
+      COMPLEX(KIND=dp), INTENT(IN)                       :: character(:), table(:, :)
+      INTEGER, INTENT(OUT)                               :: multiplicities(:)
+      REAL(KIND=dp), INTENT(IN)                          :: tolerance
+      INTEGER, INTENT(OUT)                               :: status
+
+      COMPLEX(KIND=dp)                                   :: value
+      INTEGER                                            :: dimension, i, j, nirrep, order, total
+
+      status = -1
+      multiplicities = -1
+      order = SIZE(CHARACTER)
+      nirrep = SIZE(table, 2)
+      IF (order < 1 .OR. order > 1024 .OR. nirrep < 1 .OR. SIZE(table, 1) /= order) RETURN
+      IF (SIZE(multiplicities) /= nirrep .OR. tolerance <= 0.0_dp) RETURN
+      IF (.NOT. ieee_is_finite(tolerance)) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(CHARACTER, dp)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(AIMAG(CHARACTER)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(table, dp)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(AIMAG(table)))) RETURN
+      IF (MAXVAL(ABS(table)) > REAL(order, dp) + tolerance) RETURN
+      IF (MAXVAL(ABS(CHARACTER)) > 1.e6_dp) RETURN
+      total = 0
+      DO i = 1, nirrep
+         DIMENSION = NINT(REAL(table(1, i), dp))
+         IF (DIMENSION < 1 .OR. DIMENSION > order) RETURN
+         IF (ABS(table(1, i) - DIMENSION) > tolerance) RETURN
+         total = total + DIMENSION**2
+         IF (total > order) RETURN
+         DO j = 1, nirrep
+            value = SUM(CONJG(table(:, i))*table(:, j))/REAL(order, dp)
+            IF (i == j) value = value - 1.0_dp
+            IF (ABS(value) > tolerance) RETURN
+         END DO
+      END DO
+      IF (total /= order) RETURN
+      status = -2
+      DO i = 1, nirrep
+         value = SUM(CONJG(table(:, i))*CHARACTER)/REAL(order, dp)
+         j = NINT(REAL(value, dp))
+         IF (j < 0 .OR. ABS(value - j) > tolerance) RETURN
+         multiplicities(i) = j
+      END DO
+      IF (MAXVAL(ABS(MATMUL(table, CMPLX(multiplicities, 0, dp)) - CHARACTER)) > tolerance) RETURN
+      status = 0
+   END SUBROUTINE character_multiplicities
+
+! **************************************************************************************************
+!> \brief Inversion irreps of an isolated scalar or spinor eigenspace in an AO metric.
+!> \param metric Scalar AO overlap at a TRIM
+!> \param coeff Selected coefficients, spinor components stacked by AO
+!> \param mapping Target AO index under inversion
+!> \param phase Source-AO multiplier, including orbital parity and lattice phase
+!> \param energies Selected eigenvalues in Hartree
+!> \param check_tr Check physical spinful time reversal as well as inversion
+!> \param tolerance Dimensionless metric/subspace/character tolerance
+!> \param energy_tolerance Eigenvalue-commutator tolerance in Hartree
+!> \param counts Multiplicities of even/odd inversion irreps, counting states not pairs
+!> \param error Largest dimensionless residual
+!> \param energy_error Largest projected symmetry/eigenvalue commutator
+!> \param status Zero on success; invalid output for nonzero status
+!> \param diagnostics Optional metric, normalization, inversion and time-reversal residuals
+! **************************************************************************************************
+   SUBROUTINE inversion_representation(metric, coeff, mapping, phase, energies, check_tr, &
+                                       tolerance, energy_tolerance, counts, error, energy_error, status, diagnostics)
+      COMPLEX(KIND=dp), INTENT(IN)                       :: metric(:, :), coeff(:, :)
+      INTEGER, INTENT(IN)                                :: mapping(:)
+      COMPLEX(KIND=dp), INTENT(IN)                       :: phase(:)
+      REAL(KIND=dp), INTENT(IN)                          :: energies(:)
+      LOGICAL, INTENT(IN)                                :: check_tr
+      REAL(KIND=dp), INTENT(IN)                          :: tolerance, energy_tolerance
+      INTEGER, INTENT(OUT)                               :: counts(2)
+      REAL(KIND=dp), INTENT(OUT)                         :: error, energy_error
+      INTEGER, INTENT(OUT)                               :: status
+      REAL(KIND=dp), INTENT(OUT), OPTIONAL               :: diagnostics(4)
+
+      COMPLEX(KIND=dp)                                   :: characters(2), table(2, 2)
+      COMPLEX(KIND=dp), ALLOCATABLE                      :: pc(:, :), projected(:, :), sc(:, :), &
+                                                            trc(:, :), work(:, :)
+      INTEGER                                            :: first, i, j, last, nao, nspin, rank, s
+      REAL(KIND=dp)                                      :: metric_scale
+
+      status = -1
+      counts = -1
+      error = HUGE(1.0_dp)
+      energy_error = HUGE(1.0_dp)
+      IF (PRESENT(diagnostics)) diagnostics = HUGE(1.0_dp)
+      nao = SIZE(metric, 1)
+      rank = SIZE(coeff, 2)
+      IF (nao < 1 .OR. rank < 1 .OR. SIZE(metric, 2) /= nao) RETURN
+      IF (MOD(SIZE(coeff, 1), nao) /= 0) RETURN
+      nspin = SIZE(coeff, 1)/nao
+      IF (nspin < 1 .OR. nspin > 2) RETURN
+      IF (check_tr .AND. (nspin /= 2 .OR. MOD(rank, 2) /= 0)) RETURN
+      IF (SIZE(mapping) /= nao .OR. SIZE(phase) /= nao .OR. SIZE(energies) /= rank) RETURN
+      IF (tolerance <= 0.0_dp .OR. energy_tolerance <= 0.0_dp) RETURN
+      IF (.NOT. ieee_is_finite(tolerance) .OR. .NOT. ieee_is_finite(energy_tolerance)) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(metric, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(metric)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(coeff, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(coeff)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(phase, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(phase)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(energies))) RETURN
+      IF (ANY(mapping < 1) .OR. ANY(mapping > nao)) RETURN
+      IF (ANY(ABS(ABS(phase) - 1.0_dp) > tolerance)) RETURN
+      DO i = 1, nao
+         IF (mapping(mapping(i)) /= i) RETURN
+         IF (ABS(phase(i)*phase(mapping(i)) - 1.0_dp) > tolerance) RETURN
+      END DO
+      metric_scale = MAX(1.0_dp, MAXVAL(ABS(metric)))
+      error = MAXVAL(ABS(metric - CONJG(TRANSPOSE(metric))))/metric_scale
+      DO j = 1, nao
+         DO i = 1, nao
+            error = MAX(error, ABS(CONJG(phase(i))*metric(mapping(i), mapping(j))*phase(j) - metric(i, j))/ &
+                        metric_scale)
+         END DO
+      END DO
+      IF (PRESENT(diagnostics)) diagnostics(1) = error
+      ALLOCATE (sc(nao*nspin, rank), pc(nao*nspin, rank), projected(rank, rank), work(rank, rank))
+      DO s = 1, nspin
+         first = (s - 1)*nao
+         last = s*nao
+         sc(first + 1:last, :) = MATMUL(metric, coeff(first + 1:last, :))
+         DO i = 1, nao
+            pc(first + mapping(i), :) = phase(i)*coeff(first + i, :)
+         END DO
+      END DO
+      work(:, :) = MATMUL(CONJG(TRANSPOSE(coeff)), sc)
+      DO i = 1, rank
+         work(i, i) = work(i, i) - 1.0_dp
+      END DO
+      error = MAX(error, MAXVAL(ABS(work)))
+      IF (PRESENT(diagnostics)) diagnostics(2) = MAXVAL(ABS(work))
+      projected(:, :) = MATMUL(CONJG(TRANSPOSE(sc)), pc)
+      IF (.NOT. ALL(ieee_is_finite(REAL(projected, dp)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(AIMAG(projected)))) RETURN
+      work(:, :) = MATMUL(CONJG(TRANSPOSE(projected)), projected)
+      DO i = 1, rank
+         work(i, i) = work(i, i) - 1.0_dp
+      END DO
+      error = MAX(error, MAXVAL(ABS(work)), MAXVAL(ABS(projected - CONJG(TRANSPOSE(projected)))))
+      IF (PRESENT(diagnostics)) diagnostics(3) = MAX(MAXVAL(ABS(work)), &
+                                                     MAXVAL(ABS(projected - CONJG(TRANSPOSE(projected)))))
+      IF (PRESENT(diagnostics)) THEN
+         IF (.NOT. check_tr) diagnostics(4) = 0.0_dp
+      END IF
+      energy_error = 0.0_dp
+      DO j = 1, rank
+         DO i = 1, rank
+            energy_error = MAX(energy_error, ABS(projected(i, j)*(energies(i) - energies(j))))
+         END DO
+      END DO
+      characters(1) = CMPLX(rank, 0, dp)
+      characters(2) = CMPLX(0, 0, dp)
+      DO i = 1, rank
+         characters(2) = characters(2) + projected(i, i)
+      END DO
+      table(:, 1) = CMPLX([1, 1], 0, dp)
+      table(:, 2) = CMPLX([1, -1], 0, dp)
+      CALL character_multiplicities(characters, table, counts, tolerance*rank, status)
+      IF (status /= 0) RETURN
+      status = -3
+      IF (check_tr) THEN
+         ! In a real Gaussian Bloch basis at a TRIM, Theta=(i sigma_y) K.
+         error = MAX(error, MAXVAL(ABS(AIMAG(metric)))/MAX(1.0_dp, MAXVAL(ABS(metric))))
+         ALLOCATE (trc(2*nao, rank))
+         trc(:nao, :) = CONJG(coeff(nao + 1:, :))
+         trc(nao + 1:, :) = -CONJG(coeff(:nao, :))
+         projected(:, :) = MATMUL(CONJG(TRANSPOSE(sc)), trc)
+         work(:, :) = MATMUL(CONJG(TRANSPOSE(projected)), projected)
+         DO i = 1, rank
+            work(i, i) = work(i, i) - 1.0_dp
+         END DO
+         error = MAX(error, MAXVAL(ABS(work)), MAXVAL(ABS(projected + TRANSPOSE(projected))))
+         IF (PRESENT(diagnostics)) diagnostics(4) = MAX(MAXVAL(ABS(work)), &
+                                                        MAXVAL(ABS(projected + TRANSPOSE(projected))))
+         DO j = 1, rank
+            DO i = 1, rank
+               energy_error = MAX(energy_error, ABS(projected(i, j)*(energies(i) - energies(j))))
+            END DO
+         END DO
+         IF (ANY(MOD(counts, 2) /= 0)) RETURN
+      END IF
+      IF (.NOT. ieee_is_finite(error) .OR. .NOT. ieee_is_finite(energy_error)) RETURN
+      IF (error > tolerance .OR. energy_error > energy_tolerance) RETURN
+      status = 0
+   END SUBROUTINE inversion_representation
+END MODULE topology_symmetry
diff --git a/src/topology_symmetry_unittest.F b/src/topology_symmetry_unittest.F
new file mode 100644
index 0000000..1c6a5cc
--- /dev/null
+++ b/src/topology_symmetry_unittest.F
@@ -0,0 +1,162 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+PROGRAM topology_symmetry_unittest
+   USE ieee_arithmetic,                 ONLY: ieee_quiet_nan,&
+                                              ieee_value
+   USE kinds,                           ONLY: dp
+   USE topology_symmetry,               ONLY: character_multiplicities,&
+                                              inversion_representation
+   USE topology_tqc,                    ONLY: inversion_ebr_signature,&
+                                              inversion_indicators
+
+   IMPLICIT NONE
+   COMPLEX(KIND=dp) :: table(6, 3), CHARACTER(6), metric(2, 2), coeff(4, 4), phase(2), tmp(4)
+   REAL(KIND=dp) :: error, energy_error, energies(4)
+   INTEGER :: multiplicities(3), status, counts(2), odd(8), ebr(2, 8), a, k, sign, strong, weak(3), z4
+   LOGICAL :: signed_atomic, nonnegative_atomic
+
+   ! Complete C3v/S3 character table per element, including a two-dimensional irrep.
+   table(:, 1) = CMPLX([1, 1, 1, 1, 1, 1], 0, dp)
+   table(:, 2) = CMPLX([1, 1, 1, -1, -1, -1], 0, dp)
+   table(:, 3) = CMPLX([2, -1, -1, 0, 0, 0], 0, dp)
+   CHARACTER = table(:, 1) + 2*table(:, 3)
+   CALL character_multiplicities(CHARACTER, table, multiplicities, 1.e-10_dp, status)
+   IF (status /= 0 .OR. ANY(multiplicities /= [1, 0, 2])) ERROR STOP 'C3v decomposition failed'
+   CHARACTER(2) = CHARACTER(2) + 0.1_dp
+   CALL character_multiplicities(CHARACTER, table, multiplicities, 1.e-10_dp, status)
+   IF (status == 0) ERROR STOP 'Invalid character accepted'
+   metric = CMPLX(0, 0, dp)
+   metric(1, 1) = 2.0_dp
+   metric(2, 2) = 0.5_dp
+   coeff = CMPLX(0, 0, dp)
+   coeff(1, 1) = SQRT(0.5_dp)
+   coeff(2, 2) = SQRT(2.0_dp)
+   coeff(3, 3) = SQRT(0.5_dp)
+   coeff(4, 4) = SQRT(2.0_dp)
+   phase = CMPLX([1, -1], 0, dp)
+   energies = 0.0_dp
+   CALL inversion_representation(metric, coeff, [1, 2], phase, energies, .TRUE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status /= 0 .OR. ANY(counts /= [2, 2])) ERROR STOP 'Metric/spinor parity failed'
+   tmp = coeff(:, 1)
+   coeff(:, 1) = (tmp + CMPLX(0, 1, dp)*coeff(:, 2))/SQRT(2.0_dp)
+   coeff(:, 2) = (CMPLX(0, 1, dp)*tmp + coeff(:, 2))/SQRT(2.0_dp)
+   CALL inversion_representation(metric, coeff, [1, 2], phase, energies, .TRUE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status /= 0 .OR. ANY(counts /= [2, 2])) ERROR STOP 'Degenerate-gauge parity failed'
+   CALL inversion_representation(metric, coeff(:, :1), [1, 2], phase, energies(:1), .FALSE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status == 0) ERROR STOP 'Nonclosed parity subspace accepted'
+   CALL inversion_representation(metric, coeff(:, :2), [1, 2], phase, energies(:2), .TRUE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status == 0) ERROR STOP 'Broken physical time reversal accepted'
+   energies(2) = 1.0_dp
+   CALL inversion_representation(metric, coeff, [1, 2], phase, energies, .TRUE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status == 0) ERROR STOP 'Noncommuting eigenspace accepted'
+   ! Scalar two-site inversion with a genuinely off-diagonal AO metric.
+   metric = CMPLX(0.2_dp, 0, dp)
+   metric(1, 1) = 1.0_dp
+   metric(2, 2) = 1.0_dp
+   coeff(:2, 1) = CMPLX([1.0_dp, 1.0_dp]/SQRT(2.4_dp), 0, dp)
+   coeff(:2, 2) = CMPLX([1.0_dp, -1.0_dp]/SQRT(1.6_dp), 0, dp)
+   phase = CMPLX(1, 0, dp)
+   CALL inversion_representation(metric, coeff(:2, :2), [2, 1], phase, energies(:2), .FALSE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status /= 0 .OR. ANY(counts /= [1, 1])) ERROR STOP 'Scalar two-site inversion failed'
+   CALL inversion_representation(metric, coeff(:2, :1), [2, 1], -phase, energies(:1), .FALSE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status /= 0 .OR. ANY(counts /= [0, 1])) ERROR STOP 'Zone-boundary inversion phase failed'
+   metric(1, 2) = CMPLX(0.2_dp, 0.01_dp, dp)
+   CALL inversion_representation(metric, coeff(:2, :2), [2, 1], phase, energies(:2), .FALSE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status == 0) ERROR STOP 'Invalid metric accepted'
+   metric(1, 2) = CMPLX(ieee_value(0.0_dp, ieee_quiet_nan), 0, dp)
+   CALL inversion_representation(metric, coeff(:2, :2), [2, 1], phase, energies(:2), .FALSE., &
+                                 1.e-9_dp, 1.e-9_dp, counts, error, energy_error, status)
+   IF (status == 0) ERROR STOP 'Nonfinite metric accepted'
+   DO a = 0, 7
+      DO sign = -1, 1, 2
+         DO k = 0, 7
+            odd(k + 1) = (1 - sign*(-1)**POPCNT(IAND(a, k)))/2
+         END DO
+         CALL inversion_indicators(odd, 1, 3, strong, weak, z4, status)
+         IF (status /= 0 .OR. strong /= 0 .OR. ANY(weak /= 0) .OR. z4 /= 0) ERROR STOP 'Atomic indicator failed'
+         CALL inversion_ebr_signature(odd, 1, signed_atomic, nonnegative_atomic, ebr, status)
+         IF (status /= 0 .OR. .NOT. nonnegative_atomic .OR. .NOT. signed_atomic) ERROR STOP 'Atomic EBR failed'
+         IF (SUM(ebr) /= 1) ERROR STOP 'EBR rank failed'
+      END DO
+   END DO
+   odd = 0
+   odd(1) = 1
+   CALL inversion_indicators(odd, 1, 3, strong, weak, z4, status)
+   IF (status /= 0 .OR. strong /= 1 .OR. z4 /= 1) ERROR STOP 'Strong index failed'
+   CALL inversion_ebr_signature(odd, 1, signed_atomic, nonnegative_atomic, ebr, status)
+   IF (status /= 0 .OR. signed_atomic .OR. nonnegative_atomic) ERROR STOP 'Stable obstruction missed'
+   odd(1) = 2
+   CALL inversion_indicators(odd, 2, 3, strong, weak, z4, status)
+   IF (status /= 0 .OR. strong /= 0 .OR. z4 /= 2) ERROR STOP 'Inversion Z4=2 missed'
+   odd(1) = 4
+   CALL inversion_ebr_signature(odd, 4, signed_atomic, nonnegative_atomic, ebr, status)
+   IF (status /= 0 .OR. .NOT. signed_atomic .OR. nonnegative_atomic) ERROR STOP 'Signed-only EBR missed'
+   odd = -1
+   CALL inversion_ebr_signature(odd, 4, signed_atomic, nonnegative_atomic, ebr, status)
+   IF (status == 0) ERROR STOP 'Invalid multiplicity accepted'
+   CALL exhaustive_signatures(2)
+   CALL exhaustive_signatures(3)
+   PRINT *, 'Native characters, parity, inversion indicators and EBR tests passed.'
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Compare the exact solver against independent enumeration of rank-two atomic sums.
+!> \param dimension Dimension of the inversion subgroup
+! **************************************************************************************************
+   SUBROUTINE exhaustive_signatures(DIMENSION)
+      INTEGER, INTENT(IN)                                :: dimension
+
+      INTEGER :: code, digit, i, ierr, indicator, indices(3), j, n, nu, x, y, &
+         values(2**DIMENSION), signatures(2**DIMENSION, 2**(DIMENSION + 1)), &
+         reconstructed(2**DIMENSION), coefficients(2, 2**DIMENSION)
+      LOGICAL :: indicators_zero, nonnegative_ok, possible(0:3**(2**DIMENSION) - 1), signed_ok
+
+      n = 2**DIMENSION
+      DO x = 0, n - 1
+         DO i = 0, n - 1
+            signatures(i + 1, 2*x + 1) = (1 - (-1)**POPCNT(IAND(x, i)))/2
+            signatures(i + 1, 2*x + 2) = 1 - signatures(i + 1, 2*x + 1)
+         END DO
+      END DO
+      possible = .FALSE.
+      DO x = 1, 2*n
+         DO y = 1, 2*n
+            code = SUM((signatures(:, x) + signatures(:, y))*[(3**i, i=0, n - 1)])
+            possible(code) = .TRUE.
+         END DO
+      END DO
+      DO code = 0, 3**n - 1
+         digit = code
+         DO i = 1, n
+            values(i) = MOD(digit, 3)
+            digit = digit/3
+         END DO
+         CALL inversion_ebr_signature(values, 2, signed_ok, nonnegative_ok, coefficients, ierr)
+         IF (ierr /= 0 .OR. (nonnegative_ok .NEQV. possible(code))) ERROR STOP 'Enumerated EBR mismatch'
+         CALL inversion_indicators(values, 2, DIMENSION, nu, indices, indicator, ierr)
+         IF (ierr /= 0) ERROR STOP 'Enumerated indicator failure'
+         indicators_zero = nu == 0
+         IF (DIMENSION == 3) indicators_zero = indicator == 0 .AND. ALL(indices == 0)
+         IF (signed_ok .NEQV. indicators_zero) ERROR STOP 'Indicator/atomic-lattice mismatch'
+         IF (.NOT. nonnegative_ok) CYCLE
+         reconstructed = 0
+         DO j = 1, n
+            reconstructed = reconstructed + coefficients(1, j)*signatures(:, 2*j - 1) + &
+                            coefficients(2, j)*signatures(:, 2*j)
+         END DO
+         IF (ANY(reconstructed /= values) .OR. SUM(coefficients) /= 2) ERROR STOP 'EBR reconstruction failed'
+      END DO
+   END SUBROUTINE exhaustive_signatures
+END PROGRAM topology_symmetry_unittest
diff --git a/src/topology_tqc.F b/src/topology_tqc.F
new file mode 100644
index 0000000..bf49576
--- /dev/null
+++ b/src/topology_tqc.F
@@ -0,0 +1,101 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Exact inversion-subgroup EBR and symmetry-indicator analysis (spinful TR).
+!> \note These are symmetry signatures, not a complete topological classification.
+! **************************************************************************************************
+MODULE topology_tqc
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: inversion_indicators, inversion_ebr_signature
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Fu--Kane indices and inversion indicator with an explicit sign convention.
+!> \param odd Number of odd Kramers pairs at each TRIM, x-bit fastest
+!> \param pairs Number of occupied Kramers pairs
+!> \param dimension Two (kz=0 plane) or three (full reciprocal torus)
+!> \param strong Plane index in 2D, strong index in 3D
+!> \param weak Three weak indices in 3D; -1 (unavailable) in 2D
+!> \param z4 sum(odd) mod 4 in 3D; -1 (unavailable) in 2D
+!> \param status Zero on valid input
+! **************************************************************************************************
+   SUBROUTINE inversion_indicators(odd, pairs, DIMENSION, strong, weak, z4, status)
+      INTEGER, INTENT(IN)                                :: odd(:), pairs, DIMENSION
+      INTEGER, INTENT(OUT)                               :: strong, weak(3), z4, status
+
+      INTEGER                                            :: axis, k
+
+      status = -1
+      strong = -1
+      weak = -1
+      z4 = -1
+      IF (DIMENSION < 2 .OR. DIMENSION > 3) RETURN
+      IF (SIZE(odd) /= 2**DIMENSION .OR. pairs < 1 .OR. pairs > 1000000) RETURN
+      IF (ANY(odd < 0) .OR. ANY(odd > pairs)) RETURN
+      strong = MOD(SUM(odd), 2)
+      IF (DIMENSION == 3) THEN
+         z4 = MOD(SUM(odd), 4)
+         weak = 0
+         DO axis = 1, 3
+            DO k = 0, 7
+               IF (BTEST(k, axis - 1)) weak(axis) = weak(axis) + odd(k + 1)
+            END DO
+         END DO
+         weak = MOD(weak, 2)
+      END IF
+      status = 0
+   END SUBROUTINE inversion_indicators
+
+! **************************************************************************************************
+!> \brief Exact signed/nonnegative EBR-signature test for the inversion subgroup.
+!> \param odd Odd Kramers pairs, x-bit fastest, 4 or 8 TRIM
+!> \param pairs Selected number of Kramers pairs
+!> \param signed_atomic Signature belongs to the integer lattice of atomic signatures
+!> \param nonnegative_atomic A physical nonnegative EBR-signature decomposition exists
+!> \param coefficients Even/odd local-parity EBR coefficients at the 2^d inversion centers
+!> \param status Zero on valid input, coefficients valid only if nonnegative_atomic
+!> \note EBR at r=a/2 has inversion character s*(-1)^(a.k). Fourier inversion
+!>       determines the differences between even/odd multiplicities exactly.
+!>       No database or floating-point integer decision is used.
+! **************************************************************************************************
+   SUBROUTINE inversion_ebr_signature(odd, pairs, signed_atomic, nonnegative_atomic, coefficients, status)
+      INTEGER, INTENT(IN)                                :: odd(:), pairs
+      LOGICAL, INTENT(OUT)                               :: signed_atomic, nonnegative_atomic
+      INTEGER, INTENT(OUT)                               :: coefficients(:, :), status
+
+      INTEGER                                            :: a, k, n, numerator, spare, &
+                                                            difference(SIZE(odd))
+
+      status = -1
+      signed_atomic = .FALSE.
+      nonnegative_atomic = .FALSE.
+      coefficients = 0
+      n = SIZE(odd)
+      IF (n /= 4 .AND. n /= 8) RETURN
+      IF (SIZE(coefficients, 1) /= 2 .OR. SIZE(coefficients, 2) /= n) RETURN
+      IF (pairs < 1 .OR. pairs > 1000000 .OR. ANY(odd < 0) .OR. ANY(odd > pairs)) RETURN
+      status = 0
+      DO a = 0, n - 1
+         numerator = 0
+         DO k = 0, n - 1
+            numerator = numerator + (-1)**POPCNT(IAND(a, k))*(pairs - 2*odd(k + 1))
+         END DO
+         IF (MOD(numerator, n) /= 0) RETURN
+         difference(a + 1) = numerator/n
+      END DO
+      IF (MOD(pairs - SUM(difference), 2) /= 0) RETURN
+      signed_atomic = .TRUE.
+      spare = pairs - SUM(ABS(difference))
+      IF (spare < 0) RETURN
+      nonnegative_atomic = .TRUE.
+      coefficients(1, :) = MAX(difference, 0)
+      coefficients(2, :) = MAX(-difference, 0)
+      coefficients(:, 1) = coefficients(:, 1) + spare/2
+   END SUBROUTINE inversion_ebr_signature
+END MODULE topology_tqc
