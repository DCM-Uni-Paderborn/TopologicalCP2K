&GLOBAL
  PROJECT neon
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      FULL_GRID T
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END
    &MGRID
      CUTOFF 200
      REL_CUTOFF 40
    &END
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PPNL 1.0E-14
      EPS_PGF_ORB 1.0E-14
      METHOD GPW
    &END
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END
    &END
    &XC
      &XC_FUNCTIONAL PBE
      &END
    &END
    &PRINT
      &WANNIER90 ON
        KPOINTS_SOURCE WILSON
        SEED_NAME neon
        SOC T
        Z2 T
        TIME_REVERSAL T
        EXCLUDE_BANDS 9 10
        WILSON_MESH 4 3
        WILSON_MAX_REFINEMENT 2
      &END
    &END
  &END
  &SUBSYS
    &CELL
      ABC 5.0 5.0 5.0
    &END
    &COORD
      SCALED
      Ne 0.5 0.5 0.5
    &END
    &KIND Ne
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
      POTENTIAL GTH-PBE-q8
    &END
  &END
&END
