diff --git a/tests/QS/regtest-spectral-localizer/stanene-common.inc b/tests/QS/regtest-spectral-localizer/stanene-common.inc
new file mode 100644
index 0000000000000000000000000000000000000000..524afc41738dfb77ee82612f060820c324aea64b
--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer/stanene-common.inc
@@ -0,0 +1,81 @@
+! Multi-atom SOC image folding; reference checked with the complete Bloch eigensystem.
+&GLOBAL
+  PROJECT stanene-localizer
+  PRINT_LEVEL LOW
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
+    &KPOINTS
+      SCHEME MONKHORST-PACK 2 2 1
+      FULL_GRID T
+      SYMMETRY F
+      WAVEFUNCTIONS COMPLEX
+    &END KPOINTS
+    &POISSON
+      PERIODIC XY
+      POISSON_SOLVER ANALYTIC
+    &END POISSON
+    &MGRID
+      CUTOFF 200
+      REL_CUTOFF 40
+    &END MGRID
+    &QS
+      EPS_DEFAULT 1.0E-12
+      EPS_PGF_ORB 1.0E-14
+      EPS_PPNL 1.0E-14
+      METHOD GPW
+    &END QS
+    &SCF
+      ADDED_MOS -1
+      EPS_SCF 1.0E-9
+      MAX_SCF 150
+      SCF_GUESS ATOMIC
+      &DIAGONALIZATION
+      &END DIAGONALIZATION
+      &MIXING
+        ALPHA 0.15
+        METHOD BROYDEN_MIXING
+      &END MIXING
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL PBE
+      &END XC_FUNCTIONAL
+    &END XC
+  &END DFT
+  &SUBSYS
+    &CELL
+      A 4.674 0 0
+      B 2.337 4.047802737288466 0
+      C 0 0 20
+      PERIODIC XY
+    &END CELL
+    &COORD
+      SCALED
+      Sn 0.3333333333333333 0.3333333333333333 0.5213
+      Sn 0.6666666666666667 0.6666666666666667 0.4787
+    &END COORD
+    &KIND Sn
+      BASIS_SET DZVP-MOLOPT-GGA-GTH-q4
+      POTENTIAL GTH-PBE-q4
+    &END KIND
+  &END SUBSYS
+  &PROPERTIES
+    &SPECTRAL_LOCALIZER
+      FORMULATION PERIODIC
+      INVARIANT Z2
+      SOC T
+      TIME_REVERSAL T
+      SOLVER ${STANENE_SOLVER}
+      SPECTRAL_FLATTENING ${STANENE_FLATTEN}
+      MP_GRID 2 2 1
+      PLANE XY
+      POSITION [angstrom] 0 0 0
+      ENERGY [hartree] -0.1592
+      ETA [hartree] ${STANENE_ETA}
+    &END SPECTRAL_LOCALIZER
+  &END PROPERTIES
+&END FORCE_EVAL
