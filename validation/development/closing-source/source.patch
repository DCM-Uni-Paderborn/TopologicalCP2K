new file mode 100644
index 0000000000000000000000000000000000000000..7f8bc95b3e84a3ecad9562236dc85b6577dc28a0
--- /dev/null
+++ b/tools/toolchain/scripts/stage5/tacho-sk-floating-pivot.patch
@@ -0,0 +1,35 @@
+Use the scalar's magnitude type when selecting skew-LDL pivots.
+
+In the tested tacho-sk revision 02ef047cb4e1e16959714ce50462bb09511d0e9a,
+unqualified abs(double) resolves to integer abs in the compiled double/Serial
+factorization. Subunit candidates are consequently compared as zeros. This
+patch preserves the pivot threshold, candidate rows and permutation handling.
+Rebuild the library after applying it; changing installed headers is not enough.
+
+diff --git a/packages/shylu/shylu_node/tacho/src/impl/Tacho_SkLDL_Internal.hpp b/packages/shylu/shylu_node/tacho/src/impl/Tacho_SkLDL_Internal.hpp
+--- a/packages/shylu/shylu_node/tacho/src/impl/Tacho_SkLDL_Internal.hpp
++++ b/packages/shylu/shylu_node/tacho/src/impl/Tacho_SkLDL_Internal.hpp
+@@ -116,20 +116,20 @@ template <> struct SkLDL<Uplo::Lower, Algo::Internal> {
+           value_type piv = Aj(1,0);
+           P(j) = P(j+1) = -(j+2);
+           //printf( "\n === j = %d (mj = %d) ===\n",j,mj );
++          typedef ArithTraits<value_type> arith_traits;
+           if (pivot) // on/off pivot
+           {
+             ordinal_type piv_inc = 2;
+             for (ordinal_type k=3; k<mj; k+=piv_inc) {
+-              if (abs(piv) < abs(Aj(k,0))) {
++              if (arith_traits::abs(piv) < arith_traits::abs(Aj(k,0))) {
+                 piv = Aj(k,0);
+                 P(j) = P(j+1) = -(j+k+1);
+               }
+             }
+           }
+           // check if we should use the pivot
+-          typedef ArithTraits<value_type> arith_traits;
+           const typename arith_traits::mag_type tol(0.01);
+-          if (tol*abs(piv) < abs(Aj(1,0))) {
++          if (tol*arith_traits::abs(piv) < arith_traits::abs(Aj(1,0))) {
+             // don't use this pivot (not big enough)
+             piv = Aj(1,0);
+             P(j) = P(j+1) = -(j+2);
