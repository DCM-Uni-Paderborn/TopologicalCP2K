diff --git a/tests/QS/regtest-kubo-transport/bloch-common.inc b/tests/QS/regtest-kubo-transport/bloch-common.inc
new file mode 100644
index 0000000000000000000000000000000000000000..acf6b05865bcba83b6ec9bb53a980f5c806206ce
--- /dev/null
+++ b/tests/QS/regtest-kubo-transport/bloch-common.inc
@@ -0,0 +1,88 @@
+&GLOBAL
+  PRINT_LEVEL LOW
+  PROJECT bloch-kubo
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
+    &QS
+      METHOD ${BLOCH_QS}
+      EPS_DEFAULT 1.0E-12
+      EPS_PPNL 1.0E-14
+    &END QS
+    &MGRID
+      CUTOFF ${BLOCH_CUTOFF}
+      NGRIDS 1
+      REL_CUTOFF 40
+    &END MGRID
+    &POISSON
+      PERIODIC ${BLOCH_PERIODIC}
+      POISSON_SOLVER ${BLOCH_POISSON}
+    &END POISSON
+    @IF ${BLOCH_SCF_K} == T
+      &KPOINTS
+        SCHEME MONKHORST-PACK ${BLOCH_GRID}
+        GAMMA_CENTERED T
+        WAVEFUNCTIONS COMPLEX
+        SYMMETRY ${BLOCH_SYMMETRY}
+        INVERSION_SYMMETRY_ONLY T
+      &END KPOINTS
+    @ENDIF
+    &SCF
+      EPS_SCF 1.0E-10
+      MAX_SCF 80
+      SCF_GUESS ATOMIC
+      &DIAGONALIZATION
+      &END DIAGONALIZATION
+      &MIXING
+        METHOD BROYDEN_MIXING
+        ALPHA 0.4
+      &END MIXING
+      &PRINT
+        &RESTART OFF
+        &END RESTART
+      &END PRINT
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL ${BLOCH_XC}
+      &END XC_FUNCTIONAL
+    &END XC
+  &END DFT
+  &PROPERTIES
+    &KUBO_TRANSPORT ON
+      CURRENT_OPERATOR BLOCH
+      SYMMETRY ${BLOCH_PROPERTY_SYMMETRY}
+      SYMMETRY_BACKEND ${BLOCH_PROPERTY_BACKEND}
+      MP_GRID ${BLOCH_GRID}
+      SOC ${BLOCH_SOC}
+      TEMPERATURE 300
+      DISSIPATION [K] 1000
+      NEUTRAL_MU [hartree] -0.1
+      ENERGY_RANGE [hartree] -0.1 -0.09
+      N_MU 1
+    &END KUBO_TRANSPORT
+  &END PROPERTIES
+  &SUBSYS
+    &CELL
+      ABC 6.0 6.0 6.0
+      PERIODIC ${BLOCH_PERIODIC}
+      MULTIPLE_UNIT_CELL ${BLOCH_CELL}
+    &END CELL
+    &TOPOLOGY
+      MULTIPLE_UNIT_CELL ${BLOCH_CELL}
+    &END TOPOLOGY
+    &COORD
+      ${BLOCH_SPECIES} 3.0 3.0 3.0
+      @IF ${BLOCH_PAIR} == T
+        ${BLOCH_SPECIES} 5.8 3.0 3.0
+      @ENDIF
+    &END COORD
+    &KIND ${BLOCH_SPECIES}
+      BASIS_SET DZVP-MOLOPT-GGA-GTH-q${BLOCH_Q}
+      POTENTIAL GTH-PBE-q${BLOCH_Q}
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
