+PROGRAM topology_atomic_unittest
+   USE kinds, ONLY: dp, int_8
+   USE topology_atomic_signatures, ONLY: atomic_signature_type, atomic_signature_construct, atomic_signature_decompose, &
+                                         atomic_signature_from_bands
+   USE topology_compatibility, ONLY: little_group_edge_type, little_group_compatibility, little_group_data_type
+   USE topology_little_group, ONLY: little_group_factor_system
+   USE topology_band_representations, ONLY: atomic_band_type, atomic_site_data_type, atomic_band_site_snapshot, &
+                                            atomic_site_storage
+   USE mathlib, ONLY: inv_3x3
+   USE topology_integer_lattice, ONLY: integer_lattice_type, integer_lattice_factor, &
+                                       integer_lattice_solve, integer_lattice_certificate, nonnegative_integer_solve
+#if defined(__SPGLIB)
+   USE iso_c_binding, ONLY: c_int, c_double
+#endif
+   IMPLICIT NONE
+   CHARACTER(LEN=256) :: argument
+   INTEGER :: iarg
+   LOGICAL :: all_settings
+#if defined(__SPGLIB)
+   INTERFACE
+      FUNCTION spg_get_symmetry_from_database(rotations, translations, hall) RESULT(nsym) BIND(C)
+         IMPORT :: c_int, c_double
+         INTEGER(c_int), INTENT(OUT) :: rotations(3, 3, 192)
+         REAL(c_double), INTENT(OUT) :: translations(3, 192)
+         INTEGER(c_int), VALUE, INTENT(IN) :: hall
+         INTEGER(c_int) :: nsym
+      END FUNCTION spg_get_symmetry_from_database
+   END INTERFACE
+#endif
+   all_settings = .FALSE.
+   DO iarg = 1, COMMAND_ARGUMENT_COUNT()
+      CALL GET_COMMAND_ARGUMENT(iarg, argument)
+      IF (argument == '--all-settings') THEN
+         all_settings = .TRUE.
+      ELSE IF (argument(:1) == '-') THEN
+         ERROR STOP 'Unknown atomic-signature test option'
+      END IF
+   END DO
+   CALL analytic_tests()
+#if defined(__SPGLIB)
+   CALL database_tests(all_settings)
+#else
+   IF (all_settings) ERROR STOP 'Atomic-signature database tests require SPGLIB'
+#endif
+   PRINT *, 'Atomic signature-matrix tests passed.'
+CONTAINS
