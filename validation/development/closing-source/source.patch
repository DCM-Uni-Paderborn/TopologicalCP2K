diff --git a/tests/QS/regtest-spectral-localizer-3d/torus-common.inc b/tests/QS/regtest-spectral-localizer-3d/torus-common.inc
new file mode 100644
index 0000000000000000000000000000000000000000..6952ba947ec6994953ad732039cccaaad80bfc1e
--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer-3d/torus-common.inc
@@ -0,0 +1,78 @@
+&GLOBAL
+  PROJECT torus-3d
+  PRINT_LEVEL LOW
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
+    &QS
+      METHOD ${AO_METHOD}
+      EPS_DEFAULT 1.0E-12
+      EPS_PPNL 1.0E-14
+    &END QS
+    &MGRID
+      CUTOFF 200
+      REL_CUTOFF 40
+    &END MGRID
+    &POISSON
+      PERIODIC XYZ
+      POISSON_SOLVER PERIODIC
+    &END POISSON
+    &KPOINTS
+      SCHEME MONKHORST-PACK 2 2 2
+      GAMMA_CENTERED T
+      WAVEFUNCTIONS COMPLEX
+      SYMMETRY ${SCF_SYMMETRY}
+      INVERSION_SYMMETRY_ONLY T
+    &END KPOINTS
+    &SCF
+      ADDED_MOS -1
+      EPS_SCF 1.0E-11
+      MAX_SCF 100
+      SCF_GUESS ATOMIC
+      &DIAGONALIZATION
+      &END DIAGONALIZATION
+      &MIXING
+        METHOD BROYDEN_MIXING
+        ALPHA 0.4
+      &END MIXING
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL PADE
+      &END XC_FUNCTIONAL
+    &END XC
+  &END DFT
+  &PROPERTIES
+    &SPECTRAL_LOCALIZER ON
+      FORMULATION PERIODIC
+      DIMENSION 3
+      INVARIANT Z2
+      SOC T
+      TIME_REVERSAL T
+      SOLVER DENSE
+      MP_GRID 2 2 2
+      POSITION [angstrom] ${ORIGIN}
+      ENERGY [hartree] -0.1
+      ETA [hartree] 0.5
+      SPECTRAL_FLATTENING ${FLATTEN}
+    &END SPECTRAL_LOCALIZER
+  &END PROPERTIES
+  &SUBSYS
+    &CELL
+      A 6.0 0.0 0.0
+      B 1.2 6.0 0.0
+      C 0.8 0.4 6.0
+      PERIODIC XYZ
+    &END CELL
+    &COORD
+      Ne 3.0 3.0 3.0
+    &END COORD
+    &KIND Ne
+      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
+      POTENTIAL GTH-PBE-q8
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
