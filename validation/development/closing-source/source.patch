index 0000000000000000000000000000000000000000..e416ddc7a51eb7399e99343a09bb44284ec262f4
--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer/bismuth-common.inc
@@ -0,0 +1,74 @@
+&GLOBAL
+  PRINT_LEVEL LOW
+  PROJECT bismuth-localizer
+  RUN_TYPE ENERGY
+&END GLOBAL
+
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
+    &MGRID
+      CUTOFF 150
+      REL_CUTOFF 30
+    &END MGRID
+    &POISSON
+      PERIODIC NONE
+      POISSON_SOLVER MT
+    &END POISSON
+    &QS
+      EPS_DEFAULT 1.0E-12
+      EPS_PPNL 1.0E-14
+      METHOD GPW
+    &END QS
+    &SCF
+      EPS_SCF 1.0E-9
+      MAX_SCF 100
+      SCF_GUESS ATOMIC
+      &OT
+        MINIMIZER DIIS
+        PRECONDITIONER FULL_ALL
+      &END OT
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL PBE
+      &END XC_FUNCTIONAL
+    &END XC
+  &END DFT
+  &PROPERTIES
+    &KUBO_TRANSPORT ON
+      CURRENT_OPERATOR PROJECTED_AO
+      SOC T
+      TEMPERATURE 300
+      DISSIPATION [K] 1000
+      NEUTRAL_MU [hartree] -0.1
+      ENERGY_RANGE [hartree] -0.1 -0.09
+      N_MU 1
+    &END KUBO_TRANSPORT
+    &SPECTRAL_LOCALIZER ON
+      ENERGY [hartree] -0.1
+      INVARIANT ${LOCALIZER_INVARIANT}
+      SOLVER ${LOCALIZER_SOLVER}
+      KAPPA [hartree*bohr^-1] 0.1
+      PLANE XZ
+      POSITION [angstrom] 4.0 4.0 4.0
+      SOC T
+      TIME_REVERSAL T
+    &END SPECTRAL_LOCALIZER
+  &END PROPERTIES
+  &SUBSYS
+    &CELL
+      ABC 8.0 8.0 8.0
+      PERIODIC NONE
+    &END CELL
+    &COORD
+      Bi 2.6 4.0 4.0
+      Bi 5.4 4.0 4.0
+    &END COORD
+    &KIND Bi
+      BASIS_SET DZVP-MOLOPT-GGA-GTH-q5
+      POTENTIAL GTH-PBE-q5
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
