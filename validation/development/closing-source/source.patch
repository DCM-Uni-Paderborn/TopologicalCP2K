diff --git a/tests/QS/regtest-quadratic-pseudospectrum/h2-common.inc b/tests/QS/regtest-quadratic-pseudospectrum/h2-common.inc
new file mode 100644
index 0000000000000000000000000000000000000000..142deb7fc3348429cc4c0f4dc6e1fc52076a2b22
--- /dev/null
+++ b/tests/QS/regtest-quadratic-pseudospectrum/h2-common.inc
@@ -0,0 +1,75 @@
+&GLOBAL
+  PRINT_LEVEL LOW
+  PROJECT quadratic-h2-${QS_METHOD}-${H_POTENTIAL}
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME POTENTIAL_UZH
+    &QS
+      METHOD ${QS_METHOD}
+      EPS_DEFAULT 1.0E-12
+    &END QS
+    &MGRID
+      CUTOFF 150
+      REL_CUTOFF 30
+    &END MGRID
+    &POISSON
+      PERIODIC NONE
+      POISSON_SOLVER MT
+    &END POISSON
+    &SCF
+      EPS_SCF 1.0E-9
+      MAX_SCF 60
+      SCF_GUESS ATOMIC
+      &OT
+        PRECONDITIONER FULL_ALL
+        MINIMIZER DIIS
+      &END OT
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL PBE
+      &END XC_FUNCTIONAL
+    &END XC
+    &PRINT
+      &AO_MATRICES ON
+        NDIGITS 16
+        OVERLAP T
+        KOHN_SHAM_MATRIX T
+        POSITION T
+      &END AO_MATRICES
+    &END PRINT
+  &END DFT
+  &PROPERTIES
+    &QUADRATIC_PSEUDOSPECTRUM ON
+      SOLVER ${QUADRATIC_SOLVER}
+      POSITION [angstrom] 3.0 3.0 3.0
+      POSITION [angstrom] 3.37 3.0 3.0
+      ENERGY [hartree] 0.0 0.1
+      KAPPA [hartree*bohr^-1] 0.1
+      NSTATES 2
+      EPS_EIGEN 1.0E-10
+    &END QUADRATIC_PSEUDOSPECTRUM
+    &SPECTRAL_LOCALIZER ON
+      POSITION [angstrom] 3.37 3.0 3.0
+      ENERGY [hartree] 0.1
+      KAPPA [hartree*bohr^-1] 0.1
+    &END SPECTRAL_LOCALIZER
+  &END PROPERTIES
+  &SUBSYS
+    &CELL
+      ABC 7.0 7.0 7.0
+      PERIODIC NONE
+    &END CELL
+    &COORD
+      H 3.00 3.00 3.00
+      H 3.74 3.00 3.00
+    &END COORD
+    &KIND H
+      BASIS_SET ${H_BASIS}
+      POTENTIAL ${H_POTENTIAL}
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
