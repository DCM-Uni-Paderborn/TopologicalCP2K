+PROGRAM topology_site_unittest
+   USE kinds, ONLY: dp
+   USE topology_band_representations, ONLY: atomic_band_type, atomic_band_construct, &
+                                            atomic_band_characters, atomic_band_site_data
+   USE topology_site_relations, ONLY: site_relation_type, site_specialization, site_reduction_type, site_induction_reduce
+   USE topology_wyckoff, ONLY: wyckoff_family_type, wyckoff_families, wyckoff_match_affine
+#if defined(__SPGLIB)
+   USE iso_c_binding, ONLY: c_int, c_double
+#endif
+   IMPLICIT NONE
+   TYPE band_character_type
+      INTEGER, ALLOCATABLE :: mapping(:)
+      COMPLEX(dp), ALLOCATABLE :: characters(:, :)
+   END TYPE band_character_type
+   TYPE affine_reference_type
+      INTEGER :: group = 0, grey = 0, spin = 0
+      INTEGER, ALLOCATABLE :: directions(:, :, :), multiplicities(:)
+      REAL(dp), ALLOCATABLE :: positions(:, :)
+      CHARACTER(LEN=8), ALLOCATABLE :: labels(:)
+   END TYPE affine_reference_type
+   CHARACTER(LEN=256) :: argument, reference_file
+   INTEGER :: iarg, hall_only, info, maximal_composite, maximal_remaining
+   LOGICAL :: all_settings
+#if defined(__SPGLIB)
+   INTERFACE
+      FUNCTION spg_get_symmetry_from_database(rotations, translations, hall) RESULT(nsym) BIND(C)
+         IMPORT :: c_int, c_double
+         INTEGER(c_int), INTENT(OUT) :: rotations(3, 3, 192)
+         REAL(c_double), INTENT(OUT) :: translations(3, 192)
+         INTEGER(c_int), VALUE, INTENT(IN) :: hall
+         INTEGER(c_int) :: nsym
+      END FUNCTION spg_get_symmetry_from_database
+   END INTERFACE
+#endif
+   all_settings = .FALSE.
+   hall_only = 0
+   reference_file = ''
+   DO iarg = 1, COMMAND_ARGUMENT_COUNT()
+      CALL GET_COMMAND_ARGUMENT(iarg, argument)
+      IF (argument == '--all-settings') THEN
+         all_settings = .TRUE.
+      ELSE IF (INDEX(argument, '--reference=') == 1) THEN
+         reference_file = argument(13:)
+         IF (LEN_TRIM(reference_file) == 0) ERROR STOP 'Missing affine reference file'
+      ELSE IF (INDEX(argument, '--hall=') == 1) THEN
+         READ (argument(8:), *, IOSTAT=info) hall_only
+         IF (info /= 0) ERROR STOP 'Invalid site-induction Hall setting'
+         IF (hall_only < 1 .OR. hall_only > 530) ERROR STOP 'Invalid site-induction Hall setting'
+      ELSE IF (argument(:1) == '-') THEN
+         ERROR STOP 'Unknown site-induction test option'
+      END IF
+   END DO
+   CALL analytic_tests()
+   CALL reduction_tests()
+   IF (LEN_TRIM(reference_file) > 0) CALL reference_tests()
+#if defined(__SPGLIB)
+   CALL database_tests()
+#else
+   IF (all_settings .OR. hall_only /= 0) ERROR STOP 'Site-induction database tests require SPGLIB'
+#endif
+   PRINT *, 'Site-specialization induction tests passed.'
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Transitive direct-sum witnesses, nonunique reductions and rejection of invalid integer data.
+! **************************************************************************************************
+   SUBROUTINE reduction_tests()
+      INTEGER                                            :: status
+      TYPE(site_reduction_type)                          :: reduced
+      TYPE(site_relation_type)                           :: edges(3)
+
+      edges(1)%source = 1
+      edges(1)%destination = 2
+      edges(1)%coefficients = RESHAPE([1], [1, 1])
+      edges(2)%source = 1
+      edges(2)%destination = 3
+      edges(2)%coefficients = RESHAPE([1, 1], [2, 1])
+      edges(3)%source = 3
+      edges(3)%destination = 4
+      edges(3)%coefficients = RESHAPE([1, 1], [1, 2])
+      CALL site_induction_reduce(edges, [1, 2, 3, 5, 6], [2, 2, 1, 1, 1], &
+                                 [.FALSE., .TRUE., .FALSE., .TRUE.], reduced, status)
+      IF (status /= 0) ERROR STOP 'Synthetic transitive induction reduction failed'
+      IF (ANY(reduced%representative /= [2, 2, 5, 5, 5])) ERROR STOP 'Maximal representatives wrong'
+      IF (ANY(reduced%expansion(5, :) /= [2, 2, 1, 1, 1])) ERROR STOP 'Transitive direct sum wrong'
+      IF (ANY(reduced%expansion(:4, :) /= 0)) ERROR STOP 'Composite generator survived expansion'
+      IF (ANY(reduced%witness_edge(:2) /= 2)) ERROR STOP 'Transitive witness provenance lost'
+      edges(2)%coefficients(1, 1) = -1
+      CALL site_induction_reduce(edges, [1, 2, 3, 5, 6], [2, 2, 1, 1, 1], &
+                                 [.FALSE., .TRUE., .FALSE., .TRUE.], reduced, status)
+      IF (status == 0 .OR. ALLOCATED(reduced%expansion)) ERROR STOP 'Negative induction coefficient accepted'
+      edges(2)%coefficients = HUGE(0)
+      CALL site_induction_reduce(edges, [1, 2, 3, 5, 6], [2, 2, 1, 1, 1], &
+                                 [.FALSE., .TRUE., .FALSE., .TRUE.], reduced, status)
+      IF (status == 0 .OR. ALLOCATED(reduced%expansion)) ERROR STOP 'Invalid band dimension accepted'
+      PRINT *, 'Transitive site-induction and malformed-witness tests passed.'
+   END SUBROUTINE reduction_tests
+
+! **************************************************************************************************
+!> \brief Analytic inversion, mirror, shear/origin/coset conventions and magnetic half translations.
+! **************************************************************************************************
+   SUBROUTINE analytic_tests()
+      INTEGER                                            :: grey, i, ident(3, 3), inv(3, 3), n, &
+                                                            r(3, 3, 4), relations, shear(3, 3), &
+                                                            spin, variant
+      LOGICAL                                            :: anti(4)
+      REAL(dp)                                           :: cell(3, 3), origin(3), tau(3, 4)
+
+      ident = 0
+      DO i = 1, 3
+         ident(i, i) = 1
+      END DO
+      shear = RESHAPE([1, 0, 0, 1, 1, 0, 0, 1, 1], [3, 3])
+      inv = RESHAPE([1, 0, 0, -1, 1, 0, 1, -1, 1], [3, 3])
+      origin = [0.123_dp, -0.217_dp, 0.319_dp]
+      DO variant = 1, 5
+         r(:, :, 1) = ident
+         r(:, :, 2) = -ident
+         tau = 0.0_dp
+         cell = REAL(ident, dp)
+         IF (variant >= 2 .AND. variant <= 4) THEN
+            r(:, :, 2) = ident
+            r(3, 3, 2) = -1
+         END IF
+         IF (variant == 3) THEN
+            cell = REAL(shear, dp)
+            r(:, :, 2) = MATMUL(MATMUL(inv, r(:, :, 2)), shear)
+         END IF
+         IF (variant == 4) THEN
+            tau(:, 2) = MATMUL(REAL(r(:, :, 2) - ident, dp), origin) + [1.0_dp, -2.0_dp, 3.0_dp]
+         END IF
+         IF (variant == 5) THEN
+            r(:, :, 2) = ident
+            tau(:, 2) = 0.5_dp
+         END IF
+         r(:, :, 3:4) = r(:, :, :2)
+         tau(:, 3:4) = tau(:, :2)
+         anti = [.FALSE., .FALSE., .TRUE., .TRUE.]
+         DO grey = 1, 2
+            n = 2*grey
+            IF (variant == 5) THEN
+               n = 2
+               anti(2) = .TRUE.
+            END IF
+            DO spin = 0, 1
+               CALL check_group(cell, r(:, :, :n), tau(:, :n), anti(:n), spin == 1, .TRUE., relations)
+               IF (variant == 1 .AND. relations /= 8) ERROR STOP 'Inversion specialization count wrong'
+               IF (variant >= 2 .AND. variant <= 4 .AND. relations /= 2) ERROR STOP 'Mirror specialization count wrong'
+               IF (variant == 5 .AND. relations /= 0) ERROR STOP 'False magnetic specialization'
+            END DO
+            IF (variant == 5) EXIT
+         END DO
+      END DO
+      PRINT *, 'Site induction analytic, path, and convention checks passed.'
+   END SUBROUTINE analytic_tests
+
+! **************************************************************************************************
+!> \brief Verify every geometric specialization against independent whole-band characters.
+!> \param cell Invariant Cartesian cell
+!> \param r Full direct-space rotations
+!> \param tau Full fractional translations
+!> \param anti Full time-reversal flags
+!> \param spinful Physical spin representation
+!> \param check_path Also independently construct intermediate real-space orbit positions
+!> \param relations Number of tested specialization edges
+!> \param reference ...
+! **************************************************************************************************
+   SUBROUTINE check_group(cell, r, tau, anti, spinful, check_path, relations, reference)
+      REAL(dp), INTENT(IN)                               :: cell(3, 3)
+      INTEGER, INTENT(IN)                                :: r(:, :, :)
+      REAL(dp), INTENT(IN)                               :: tau(:, :)
+      LOGICAL, INTENT(IN)                                :: anti(:), spinful, check_path
+      INTEGER, INTENT(OUT)                               :: relations
+      TYPE(affine_reference_type), INTENT(IN), OPTIONAL  :: reference
+
+      COMPLEX(dp), ALLOCATABLE                           :: image(:, :)
+      INTEGER                                            :: a, b, e, j, nc, nr, p, status
+      INTEGER, ALLOCATABLE                               :: dimensions(:), first(:), matched(:), &
+                                                            operations(:)
+      REAL(dp)                                           :: error, points(3, 8)
+      TYPE(atomic_band_type), ALLOCATABLE                :: bands(:)
+      TYPE(band_character_type), ALLOCATABLE             :: data(:, :)
+      TYPE(site_reduction_type)                          :: reduction
+      TYPE(site_relation_type)                           :: relation
+      TYPE(site_relation_type), ALLOCATABLE              :: edges(:)
+      TYPE(wyckoff_family_type), ALLOCATABLE             :: families(:)
+
+      CALL wyckoff_families(cell, r, tau, anti, families, 1.e-8_dp, status)
+      IF (status /= 0) ERROR STOP 'Site-induction families failed'
+      points(:, 1) = 0.0_dp
+      points(:, 2) = 0.5_dp
+      points(:, 3) = [0.5_dp, 0.0_dp, 0.0_dp]
+      points(:, 4) = [1.0_dp/3, 1.0_dp/3, 0.0_dp]
+      points(:, 5) = [0.0_dp, 0.0_dp, 0.25_dp]
+      points(:, 6) = [0.173_dp, 0.217_dp, 0.319_dp]
+      points(:, 7) = [0.0_dp, 0.5_dp, 0.0_dp]
+      points(:, 8) = [1.0_dp/3, 2.0_dp/3, 0.5_dp]
+      ALLOCATE (bands(SIZE(families)), DATA(8, SIZE(families)), first(SIZE(families) + 1))
+      first(1) = 1
+      nr = 0
+      DO a = 1, SIZE(families)
+         CALL atomic_band_construct(cell, r, tau, anti, families(a)%position, spinful, bands(a), 1.e-8_dp, error, status)
+         IF (status /= 0) ERROR STOP 'Site-induction band construction failed'
+         DO p = 1, 8
+            CALL atomic_band_characters(bands(a), points(:, p), DATA(p, a)%mapping, DATA(p, a)%characters, 1.e-8_dp, status)
+            IF (status /= 0) ERROR STOP 'Site-induction band characters failed'
+         END DO
+         first(a + 1) = first(a) + SIZE(DATA(1, a)%characters, 2)
+         nr = nr + SIZE(families(a)%specializations)
+      END DO
+      nc = first(SIZE(first)) - 1
+      ALLOCATE (edges(nr), dimensions(nc))
+      DO a = 1, SIZE(families)
+         dimensions(first(a):first(a + 1) - 1) = NINT(REAL(DATA(1, a)%characters(1, :), dp))
+      END DO
+      relations = 0
+      DO a = 1, SIZE(families)
+         DO e = 1, SIZE(families(a)%specializations)
+            b = families(a)%specializations(e)
+            CALL site_specialization(cell, r, tau, anti, spinful, families, bands, a, b, relation, 1.e-8_dp, status)
+            IF (status /= 0) THEN
+               PRINT *, 'Site relation source/destination/status:', a, b, status
+               PRINT *, 'Source and destination:', families(a)%position, families(b)%position
+               ERROR STOP 'Site specialization failed'
+            END IF
+            DO p = 1, 8
+               IF (ANY(DATA(p, a)%mapping /= DATA(p, b)%mapping)) ERROR STOP 'Global band operation mismatch'
+               ALLOCATE (image(SIZE(DATA(p, a)%characters, 1), SIZE(DATA(p, a)%characters, 2)))
+               image(:, :) = MATMUL(DATA(p, b)%characters, CMPLX(relation%coefficients, 0, dp))
+               error = MAXVAL(ABS(image - DATA(p, a)%characters))
+               IF (error > 1.e-7_dp) THEN
+                  PRINT *, 'Site character source/destination/point/error:', a, b, p, error
+                  ERROR STOP 'Induced character identity failed'
+               END IF
+               DEALLOCATE (image)
+            END DO
+            IF (check_path) CALL intermediate_test(cell, r, tau, anti, spinful, families(a)%position, &
+                                                   relation%image, bands(a), points)
+            relations = relations + 1
+            edges(relations) = relation
+         END DO
+      END DO
+      CALL site_induction_reduce(edges, first, dimensions, families%maximal_site_symmetry, reduction, status)
+      IF (status /= 0) ERROR STOP 'Certified site-induction reduction failed'
+      IF (PRESENT(reference)) THEN
+         CALL wyckoff_match_affine(families, r, tau, reference%positions, reference%directions, &
+                                   reference%multiplicities, matched, operations, 1.e-8_dp, status)
+         IF (status /= 0) THEN
+            PRINT *, 'Affine reference group/status:', reference%group, status
+            ERROR STOP 'Canonical affine reference mismatch'
+         END IF
+         DO b = 1, SIZE(matched)
+            a = matched(b)
+            WRITE (*, '(A,3(1X,I5),1X,A,4(1X,I5),1X,L1)') 'AFFINE_MATCH', &
+               reference%group, reference%grey, reference%spin, TRIM(reference%labels(b)), &
+               a, operations(b), families(a)%dimension, families(a)%multiplicity, families(a)%maximal_site_symmetry
+            DO j = first(a), first(a + 1) - 1
+               WRITE (*, '(A,3(1X,I5),1X,A,3(1X,I5),1X,L1)') 'SITE_COLUMN', &
+                  reference%group, reference%grey, reference%spin, TRIM(reference%labels(b)), &
+                  j - first(a) + 1, dimensions(j), SUM(reduction%expansion(:, j)), families(a)%maximal_site_symmetry
+            END DO
+         END DO
+      END IF
+      maximal_composite = 0
+      maximal_remaining = 0
+      DO a = 1, SIZE(families)
+         DO j = first(a), first(a + 1) - 1
+            IF (families(a)%maximal_site_symmetry) THEN
+               IF (SUM(reduction%expansion(:, j)) > 1) THEN
+                  maximal_composite = maximal_composite + 1
+               ELSE
+                  maximal_remaining = maximal_remaining + 1
+               END IF
+            END IF
+            DO p = 1, 8
+               ALLOCATE (image(SIZE(DATA(p, a)%characters, 1), 1))
+               image = 0
+               DO b = 1, SIZE(families)
+                  image(:, 1) = image(:, 1) + MATMUL(DATA(p, b)%characters, &
+                                                     CMPLX(reduction%expansion(first(b):first(b + 1) - 1, j), 0, dp))
+               END DO
+               IF (MAXVAL(ABS(image(:, 1) - DATA(p, a)%characters(:, j - first(a) + 1))) > 1.e-7_dp) THEN
+                  ERROR STOP 'Transitive site-induction character identity failed'
+               END IF
+               DEALLOCATE (image)
+            END DO
+         END DO
+      END DO
+      ! Invalid and reversed edges must fail without returning a usable witness.
+      CALL site_specialization(cell, r, tau, anti, spinful, families, bands, 0, 1, relation, 1.e-8_dp, status)
+      IF (status == 0 .OR. ALLOCATED(relation%coefficients)) ERROR STOP 'Invalid site accepted'
+      DO a = 1, SIZE(families)
+         CALL site_specialization(cell, r, tau, anti, spinful, families, bands, a, a, relation, 1.e-8_dp, status)
+         IF (status == 0 .OR. ALLOCATED(relation%coefficients)) ERROR STOP 'Self specialization accepted'
+      END DO
+   END SUBROUTINE check_group
+
+! **************************************************************************************************
+!> \brief Independently induce bands at intermediate points along the certified straight path.
+!> \param cell Cartesian cell
+!> \param r Full rotations
+!> \param tau Full translations
+!> \param anti Time-reversal flags
+!> \param spinful Spin representation
+!> \param source Generic source position
+!> \param endpoint Lifted endpoint
+!> \param band Source band representation
+!> \param points Reciprocal sample points
+! **************************************************************************************************
+   SUBROUTINE intermediate_test(cell, r, tau, anti, spinful, source, endpoint, band, points)
+      REAL(dp), INTENT(IN)                               :: cell(3, 3)
+      INTEGER, INTENT(IN)                                :: r(:, :, :)
+      REAL(dp), INTENT(IN)                               :: tau(:, :)
+      LOGICAL, INTENT(IN)                                :: anti(:), spinful
+      REAL(dp), INTENT(IN)                               :: source(3), endpoint(3)
+      TYPE(atomic_band_type), INTENT(IN)                 :: band
+      REAL(dp), INTENT(IN)                               :: points(:, :)
+
+      COMPLEX(dp), ALLOCATABLE                           :: a(:, :), b(:, :)
+      INTEGER                                            :: i, j, p, q, status
+      INTEGER, ALLOCATABLE                               :: map_a(:), map_b(:), order(:)
+      REAL(dp)                                           :: error, position(3)
+      REAL(dp), ALLOCATABLE                              :: positions(:, :)
+      TYPE(atomic_band_type)                             :: moved
+
+      DO q = 1, 2
+         position = source + REAL(q, dp)/3*(endpoint - source)
+         CALL atomic_band_construct(cell, r, tau, anti, position, spinful, moved, 1.e-8_dp, error, status)
+         IF (status /= 0) ERROR STOP 'Intermediate site construction failed'
+         CALL atomic_band_site_data(band, positions, map_a, a)
+         CALL atomic_band_site_data(moved, positions, map_b, b)
+         IF (SIZE(map_a) /= SIZE(map_b)) ERROR STOP 'Intermediate path gained site symmetry'
+         IF (ANY(map_a /= map_b)) ERROR STOP 'Intermediate site group changed'
+         ALLOCATE (order(SIZE(a, 2)))
+         DO i = 1, SIZE(a, 2)
+            order(i) = 0
+            DO j = 1, SIZE(b, 2)
+               IF (MAXVAL(ABS(a(:, i) - b(:, j))) > 1.e-7_dp) CYCLE
+               IF (order(i) /= 0) ERROR STOP 'Ambiguous intermediate irrep'
+               order(i) = j
+            END DO
+            IF (order(i) == 0) ERROR STOP 'Intermediate irrep missing'
+         END DO
+         DO p = 1, SIZE(points, 2)
+            CALL atomic_band_characters(band, points(:, p), map_a, a, 1.e-8_dp, status)
+            IF (status /= 0) ERROR STOP 'Source path characters failed'
+            CALL atomic_band_characters(moved, points(:, p), map_b, b, 1.e-8_dp, status)
+            IF (status /= 0) ERROR STOP 'Intermediate path characters failed'
+            IF (ANY(map_a /= map_b)) ERROR STOP 'Intermediate band operation mismatch'
+            IF (MAXVAL(ABS(a - b(:, order))) > 1.e-7_dp) ERROR STOP 'Intermediate band characters changed'
+         END DO
+         DEALLOCATE (order)
+      END DO
+   END SUBROUTINE intermediate_test
+
+! **************************************************************************************************
+!> \brief Independently supplied group generators/affine catalogues; no SPGLIB database calls.
+!> \note The text fixture starts with a group count, then group/order/family-count headers,
+!>       full rotations and translations, and label/multiplicity/origin/direction records.
+! **************************************************************************************************
+   SUBROUTINE reference_tests()
+      INTEGER                                            :: count_groups, g, grey, i, j, n, nf, &
+                                                            order, relations, spin, status, unit
+      INTEGER, ALLOCATABLE                               :: r(:, :, :)
+      LOGICAL, ALLOCATABLE                               :: anti(:)
+      REAL(dp)                                           :: cell(3, 3)
+      REAL(dp), ALLOCATABLE                              :: tau(:, :)
+      TYPE(affine_reference_type)                        :: reference
+
+      OPEN (NEWUNIT=unit, FILE=TRIM(reference_file), STATUS='OLD', ACTION='READ', IOSTAT=status)
+      IF (status /= 0) ERROR STOP 'Cannot read affine reference file'
+      READ (unit, *, IOSTAT=status) count_groups
+      IF (status /= 0) ERROR STOP 'Invalid affine group count'
+      IF (count_groups < 1 .OR. count_groups > 530) ERROR STOP 'Affine group count out of bounds'
+      DO order = 1, count_groups
+         READ (unit, *, IOSTAT=status) reference%group, n, nf
+         IF (status /= 0) ERROR STOP 'Invalid affine group header'
+         IF (n < 1 .OR. n > 192 .OR. nf < 1 .OR. nf > 100) ERROR STOP 'Affine fixture size out of bounds'
+         ALLOCATE (r(3, 3, 2*n), tau(3, 2*n), anti(2*n))
+         ALLOCATE (reference%labels(nf), reference%multiplicities(nf), &
+                   reference%positions(3, nf), reference%directions(3, 3, nf))
+         cell = 0
+         DO g = 1, n
+            READ (unit, *, IOSTAT=status) r(:, :, g), tau(:, g)
+            IF (status /= 0) ERROR STOP 'Invalid affine operation record'
+            cell = cell + MATMUL(REAL(TRANSPOSE(r(:, :, g)), dp), REAL(r(:, :, g), dp))
+         END DO
+         cell = cell/n
+         CALL dpotrf('U', 3, cell, 3, status)
+         IF (status /= 0) ERROR STOP 'Affine invariant cell failed'
+         DO j = 1, 3
+            DO i = j + 1, 3
+               cell(i, j) = 0
+            END DO
+         END DO
+         DO j = 1, nf
+            READ (unit, *, IOSTAT=status) reference%labels(j), reference%multiplicities(j), &
+               reference%positions(:, j), reference%directions(:, :, j)
+            IF (status /= 0) ERROR STOP 'Invalid affine family record'
+         END DO
+         CALL reference_convention_test(cell, r(:, :, :n), tau(:, :n), reference)
+         r(:, :, n + 1:) = r(:, :, :n)
+         tau(:, n + 1:) = tau(:, :n)
+         anti(:n) = .FALSE.
+         anti(n + 1:) = .TRUE.
+         DO grey = 1, 2
+            reference%grey = grey
+            DO spin = 0, 1
+               reference%spin = spin
+               CALL check_group(cell, r(:, :, :grey*n), tau(:, :grey*n), anti(:grey*n), &
+                                spin == 1, .FALSE., relations, reference)
+            END DO
+         END DO
+         DEALLOCATE (r, tau, anti, reference%labels, reference%multiplicities, &
+                     reference%positions, reference%directions)
+      END DO
+      READ (unit, *, IOSTAT=status) n
+      IF (status >= 0) ERROR STOP 'Unexpected trailing affine fixture data'
+      CLOSE (unit)
+      PRINT *, 'Independent affine-reference groups passed:', count_groups
+   END SUBROUTINE reference_tests
+
+! **************************************************************************************************
+!> \brief Retain named affine families and specialization edges after simultaneous convention changes.
+!> \param cell Reference cell
+!> \param r Reference rotations
+!> \param tau Reference translations
+!> \param reference Independent affine families in the reference convention
+! **************************************************************************************************
+   SUBROUTINE reference_convention_test(cell, r, tau, reference)
+      REAL(dp), INTENT(IN)                               :: cell(3, 3)
+      INTEGER, INTENT(IN)                                :: r(:, :, :)
+      REAL(dp), INTENT(IN)                               :: tau(:, :)
+      TYPE(affine_reference_type), INTENT(IN)            :: reference
+
+      INTEGER                                            :: g, h, i, inverse(3, 3), j, n, nf, &
+                                                            shear(3, 3), status, variant
+      INTEGER, ALLOCATABLE                               :: changed(:, :, :), mapping(:), &
+                                                            operations(:)
+      LOGICAL, ALLOCATABLE                               :: edges(:, :), expected(:, :)
+      REAL(dp)                                           :: lattice(3, 3), origin(3)
+      REAL(dp), ALLOCATABLE                              :: moved(:, :)
+      TYPE(affine_reference_type)                        :: transformed
+      TYPE(wyckoff_family_type), ALLOCATABLE             :: families(:)
+
+      n = SIZE(r, 3)
+      nf = SIZE(reference%multiplicities)
+      ALLOCATE (changed(3, 3, n), moved(3, n), edges(nf, nf), expected(nf, nf))
+      shear = RESHAPE([1, 0, 0, 1, 1, 0, 0, 1, 1], [3, 3])
+      inverse = RESHAPE([1, 0, 0, -1, 1, 0, 1, -1, 1], [3, 3])
+      origin = [0.123_dp, -0.217_dp, 0.319_dp]
+      DO variant = 1, 2
+         transformed = reference
+         changed = r
+         moved = tau
+         lattice = cell
+         IF (variant == 2) THEN
+            lattice = MATMUL(cell, REAL(shear, dp))
+            DO g = 1, n
+               h = n + 1 - g
+               changed(:, :, h) = MATMUL(MATMUL(inverse, r(:, :, g)), shear)
+               moved(:, h) = MATMUL(REAL(inverse, dp), tau(:, g) + MATMUL(REAL(r(:, :, g), dp), origin) - origin)
+               IF (g /= 1) moved(:, h) = moved(:, h) + REAL([g, 1 - g, 2*g], dp)
+            END DO
+            DO j = 1, nf
+               transformed%positions(:, j) = MATMUL(REAL(inverse, dp), reference%positions(:, j) - origin)
+               transformed%directions(:, :, j) = MATMUL(inverse, reference%directions(:, :, j))
+            END DO
+         END IF
+         CALL wyckoff_families(lattice, changed, moved, [(.FALSE., i=1, n)], families, 1.e-8_dp, status)
+         IF (status /= 0) ERROR STOP 'Affine convention enumeration failed'
+         CALL wyckoff_match_affine(families, changed, moved, transformed%positions, transformed%directions, &
+                                   transformed%multiplicities, mapping, operations, 1.e-8_dp, status)
+         IF (status /= 0) ERROR STOP 'Affine convention reference match failed'
+         DO i = 1, nf
+            DO j = 1, nf
+               edges(i, j) = ANY(families(mapping(i))%specializations == mapping(j))
+            END DO
+         END DO
+         IF (variant == 1) expected = edges
+         IF (ANY(edges .NEQV. expected)) ERROR STOP 'Canonical specialization graph changed'
+      END DO
+      PRINT *, 'Affine convention reference passed:', reference%group, nf
+   END SUBROUTINE reference_convention_test
+
+#if defined(__SPGLIB)
+! **************************************************************************************************
+!> \brief Ordinary/grey scalar/spinful induction relations in all 530 Hall settings on request.
+! **************************************************************************************************
+   SUBROUTINE database_tests()
+      INTEGER, PARAMETER                                 :: selected(4) = [2, 6, 358, 430]
+
+      INTEGER                                            :: g, grey, hall, i, j, n, r(3, 3, 384), &
+                                                            relations, spin, status, total
+      INTEGER(c_int)                                     :: nsym, raw_rotations(3, 3, 192)
+      LOGICAL                                            :: anti(384)
+      REAL(c_double)                                     :: raw_tau(3, 192)
+      REAL(dp)                                           :: cell(3, 3), tau(3, 384)
+
+      total = 0
+      DO hall = 1, 530
+         IF (hall_only /= 0 .AND. hall /= hall_only) CYCLE
+         IF (.NOT. all_settings .AND. hall_only == 0 .AND. .NOT. ANY(selected == hall)) CYCLE
+         PRINT *, 'Site induction starting Hall:', hall
+         nsym = spg_get_symmetry_from_database(raw_rotations, raw_tau, INT(hall, c_int))
+         n = INT(nsym)
+         IF (n < 1 .OR. n > 192) ERROR STOP 'Site-induction operation database failed'
+         cell = 0.0_dp
+         DO g = 1, n
+            r(:, :, g) = TRANSPOSE(raw_rotations(:, :, g))
+            cell = cell + MATMUL(REAL(TRANSPOSE(r(:, :, g)), dp), REAL(r(:, :, g), dp))
+         END DO
+         cell = cell/n
+         CALL dpotrf('U', 3, cell, 3, status)
+         IF (status /= 0) ERROR STOP 'Site-induction invariant cell failed'
+         DO j = 1, 3
+            DO i = j + 1, 3
+               cell(i, j) = 0.0_dp
+            END DO
+         END DO
+         r(:, :, n + 1:2*n) = r(:, :, :n)
+         tau(:, :n) = raw_tau(:, :n)
+         tau(:, n + 1:2*n) = tau(:, :n)
+         anti(:n) = .FALSE.
+         anti(n + 1:2*n) = .TRUE.
+         DO grey = 1, 2
+            DO spin = 0, 1
+               CALL check_group(cell, r(:, :, :grey*n), tau(:, :grey*n), anti(:grey*n), spin == 1, .FALSE., relations)
+               PRINT *, 'Site induction Hall/grey/spin/relations:', hall, grey, spin, relations
+               PRINT *, 'Maximal site Hall/grey/spin/composite/remaining:', hall, grey, spin, &
+                  maximal_composite, maximal_remaining
+               IF (grey == 2 .AND. spin == 1 .AND. maximal_composite /= 0) THEN
+                  ERROR STOP 'Spinful grey maximal-site representation incorrectly composite'
+               END IF
+               IF (hall == 523 .AND. grey == 1 .AND. spin == 1 .AND. maximal_composite == 0) THEN
+                  ERROR STOP 'Fm-3m exceptional spinful representation was not reduced'
+               END IF
+               IF (hall == 358 .AND. grey == 2 .AND. spin == 0 .AND. maximal_composite /= 2) THEN
+                  ERROR STOP 'S4 exceptional spinless corepresentations were not reduced'
+               END IF
+               total = total + relations
+            END DO
+         END DO
+      END DO
+      PRINT *, 'Site-induction relations, reciprocal character checks:', total, 8*total
+   END SUBROUTINE database_tests
+#endif
