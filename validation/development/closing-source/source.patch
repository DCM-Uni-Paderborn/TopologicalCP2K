--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer-3d/TEST_FILES.toml
@@ -0,0 +1,19 @@
+# Finite three-dimensional AII with physical GTH spin-orbit coupling.
+# Gaps independently checked by a complex SVD of printed full AO/SOC/position matrices.
+"neon-gpw.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                  {matcher="LOCALIZER_GAP", tol=2e-6, ref=2.904806295377658e-1}]
+"neon-gapw.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                   {matcher="LOCALIZER_GAP", tol=2e-6, ref=2.8747080965025573e-1}]
+"neon-flattened.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                        {matcher="LOCALIZER_GAP", tol=2e-6, ref=9.175700464044804e-1}]
+"neon-unresolved.inp" = [{matcher="LOCALIZER_UNRESOLVED", tol=0, ref=1}]
+# Three-dimensional torus in a skew cell. Full-band SOC/MMN reconstruction and
+# complex SVD independently agree with these gaps within 4e-15 hartree.
+"torus-gpw.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                   {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.7706004429287915e-1}]
+"torus-shifted.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                       {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.7706004429287915e-1}]
+"torus-gapw.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                    {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.772200088639432e-1}]
+"torus-flattened.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                         {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.1322383425700584e-1}]
