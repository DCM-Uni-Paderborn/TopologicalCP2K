+
+! **************************************************************************************************
+!> \brief Distributed block-sparse finite localizers, retaining the covariant AO metric.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE spectral_localizer_dbcsr
+   USE arnoldi_vector,                  ONLY: create_col_vec_from_matrix
+   USE cp_dbcsr_api,                    ONLY: &
+        dbcsr_add, dbcsr_copy, dbcsr_create, dbcsr_desymmetrize, dbcsr_distribution_get, &
+        dbcsr_distribution_new, dbcsr_distribution_release, dbcsr_distribution_type, &
+        dbcsr_finalize, dbcsr_get_info, dbcsr_iterator_blocks_left, dbcsr_iterator_next_block, &
+        dbcsr_iterator_start, dbcsr_iterator_stop, dbcsr_iterator_type, dbcsr_multiply, &
+        dbcsr_p_type, dbcsr_put_block, dbcsr_release, dbcsr_transposed, dbcsr_type, &
+        dbcsr_type_no_symmetry
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE kinds,                           ONLY: dp
+   USE message_passing,                 ONLY: mp_para_env_type
+#include "./base/base_uses.f90"
+
+   IMPLICIT NONE
+   PRIVATE
+   CHARACTER(len=*), PARAMETER, PRIVATE :: moduleN = 'spectral_localizer_dbcsr'
+   PUBLIC :: localizer_dbcsr_build, localizer_dbcsr_dense, localizer_dbcsr_release, localizer_matrix_type
+   PUBLIC :: localizer_dbcsr_pencil, localizer_dbcsr_check
+   PUBLIC :: localizer_ao_operators, localizer_dbcsr_apply
+   PUBLIC :: localizer_dbcsr_realify, localizer_dbcsr_from_real
+   PUBLIC :: localizer_dbcsr_gap_pencil
+   PUBLIC :: localizer_dbcsr_3d_build
+
+   TYPE localizer_matrix_type
+      TYPE(dbcsr_type) :: real_part, imaginary_part
+   END TYPE localizer_matrix_type
+
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Build the 3D AII chiral block in DBCSR; not a Hermitian 2D localizer.
+!> \param h Scalar AO Hamiltonian
+!> \param s Scalar AO overlap
+!> \param positions Three Cartesian AO first moments
+!> \param point Cartesian position query
+!> \param energy Absolute energy query
+!> \param kappa Positive energy/length scale
+!> \param block Chiral block, with auxiliary index outside physical up/down spin
+!> \param metric Block metric I_aux tensor I_spin tensor S
+!> \param soc Three real antisymmetric SOC components
+!> \param shifted_hamiltonian Optional already energy-shifted physical-spin Hamiltonian
+!> \param periodic_cosines Three cos(G.r) matrices. Then positions are sin(G.r), point is
+!>        in radians, and kappa is the periodic energy scale eta.
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_3d_build(h, s, positions, point, energy, kappa, block, metric, soc, &
+                                       shifted_hamiltonian, periodic_cosines)
+      TYPE(dbcsr_type), INTENT(IN)                       :: h, s
+      TYPE(dbcsr_p_type), INTENT(IN)                     :: positions(:)
+      REAL(dp), INTENT(IN)                               :: point(3), energy, kappa
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: block, metric
+      TYPE(dbcsr_p_type), INTENT(IN)                     :: soc(:, :)
+      TYPE(localizer_matrix_type), INTENT(IN), OPTIONAL  :: shifted_hamiltonian
+      TYPE(dbcsr_p_type), INTENT(IN), OPTIONAL           :: periodic_cosines(:)
+
+      COMPLEX(dp), PARAMETER                             :: ii = CMPLX(0.0_dp, 1.0_dp, dp)
+
+      COMPLEX(dp)                                        :: factors(2, 2), identity(4, 4), &
+                                                            pauli(4, 4, 3)
+      INTEGER                                            :: i
+      TYPE(localizer_matrix_type)                        :: physical(1), physical_metric
+
+      CPASSERT(SIZE(positions) == 3)
+      identity = 0.0_dp
+      pauli = 0.0_dp
+      DO i = 1, 4
+         identity(i, i) = 1.0_dp
+      END DO
+      DO i = 1, 2
+         pauli(i, i + 2, 1) = 1.0_dp
+         pauli(i + 2, i, 1) = 1.0_dp
+         pauli(i, i + 2, 2) = -ii
+         pauli(i + 2, i, 2) = ii
+         pauli(i, i, 3) = 1.0_dp
+         pauli(i + 2, i + 2, 3) = -1.0_dp
+      END DO
+      CALL create_operator(s, 4, block)
+      CALL create_operator(s, 4, metric)
+      CALL add_real_blocks(s, identity, metric)
+      factors = 0.0_dp
+      factors(1, 1) = 1.0_dp
+      factors(2, 2) = 1.0_dp
+      IF (PRESENT(shifted_hamiltonian)) THEN
+         CPASSERT(energy == 0.0_dp)
+         CALL add_real_blocks(shifted_hamiltonian%real_part, factors, block)
+         CALL add_real_blocks(shifted_hamiltonian%imaginary_part, ii*factors, block)
+      ELSE
+         CALL localizer_ao_operators(h, s, positions(:0), physical, physical_metric, soc)
+         CALL add_real_blocks(physical(1)%real_part, factors, block)
+         CALL add_real_blocks(physical(1)%imaginary_part, ii*factors, block)
+         CALL localizer_dbcsr_release(physical(1))
+         CALL localizer_dbcsr_release(physical_metric)
+         CALL add_real_blocks(s, -energy*identity, block)
+      END IF
+      IF (PRESENT(periodic_cosines)) THEN
+         CPASSERT(SIZE(periodic_cosines) == 3)
+         CALL add_real_blocks(s, -3.0_dp*kappa*identity, block)
+         DO i = 1, 3
+            CALL add_real_blocks(periodic_cosines(i)%matrix, &
+                                 kappa*(COS(point(i))*identity + ii*SIN(point(i))*pauli(:, :, i)), block)
+            CALL add_real_blocks(positions(i)%matrix, &
+                                 kappa*(SIN(point(i))*identity - ii*COS(point(i))*pauli(:, :, i)), block)
+         END DO
+      ELSE
+         DO i = 1, 3
+            CALL add_real_blocks(positions(i)%matrix, -ii*kappa*pauli(:, :, i), block)
+            CALL add_real_blocks(s, ii*kappa*point(i)*pauli(:, :, i), block)
+         END DO
+      END IF
+   END SUBROUTINE localizer_dbcsr_3d_build
+
+! **************************************************************************************************
+!> \brief Distributed real matrix R(A)=[Re(A),-Im(A);Im(A),Re(A)].
+!> \param matrix Complex operator with full-storage components
+!> \param realified Newly initialized real DBCSR operator
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_realify(matrix, realified)
+      TYPE(localizer_matrix_type), INTENT(IN)            :: matrix
+      TYPE(dbcsr_type), INTENT(OUT)                      :: realified
+
+      COMPLEX(dp)                                        :: factors(2, 2)
+      TYPE(localizer_matrix_type)                        :: expanded
+
+      CALL create_operator(matrix%real_part, 2, expanded)
+      factors = RESHAPE([1.0_dp, 0.0_dp, 0.0_dp, 1.0_dp], [2, 2])
+      CALL add_real_blocks(matrix%real_part, factors, expanded)
+      factors = RESHAPE([0.0_dp, 1.0_dp, -1.0_dp, 0.0_dp], [2, 2])
+      CALL add_real_blocks(matrix%imaginary_part, factors, expanded)
+      CALL dbcsr_create(realified, template=expanded%real_part)
+      CALL dbcsr_copy(realified, expanded%real_part)
+      CALL localizer_dbcsr_release(expanded)
+   END SUBROUTINE localizer_dbcsr_realify
+
+! **************************************************************************************************
+!> \brief Extract the two left quadrants of R(A); does not average away structure errors.
+!> \param realified Fully stored real operator with two repeated component distributions
+!> \param template Original complex operator defining the physical AO block distribution
+!> \param matrix Newly initialized complex operator; caller must check realification residual
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_from_real(realified, template, matrix)
+      TYPE(dbcsr_type), INTENT(INOUT)                    :: realified
+      TYPE(localizer_matrix_type), INTENT(IN)            :: template
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: matrix
+
+      INTEGER                                            :: blocks, col, nblocks, row
+      LOGICAL                                            :: transposed
+      REAL(dp), POINTER                                  :: block(:, :)
+      TYPE(dbcsr_iterator_type)                          :: iterator
+
+      CALL dbcsr_get_info(template%real_part, nblkrows_total=blocks)
+      CALL dbcsr_get_info(realified, nblkrows_total=nblocks)
+      CPASSERT(nblocks == 2*blocks)
+      CALL create_operator(template%real_part, 1, matrix)
+      CALL dbcsr_iterator_start(iterator, realified)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, row, col, block, transposed=transposed)
+         CPASSERT(.NOT. transposed)
+         IF (col > blocks) CYCLE
+         IF (row <= blocks) THEN
+            CALL dbcsr_put_block(matrix%real_part, row, col, block)
+         ELSE
+            CALL dbcsr_put_block(matrix%imaginary_part, row - blocks, col, block)
+         END IF
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL dbcsr_finalize(matrix%real_part)
+      CALL dbcsr_finalize(matrix%imaginary_part)
+   END SUBROUTINE localizer_dbcsr_from_real
+
+! **************************************************************************************************
+!> \brief Create a complex block-sparse operator with component-major scalar AO ordering.
+!> \param source Scalar AO template
+!> \param components Number of spin/auxiliary components
+!> \param matrix Newly initialized operator
+! **************************************************************************************************
+   SUBROUTINE create_operator(source, components, matrix)
+      TYPE(dbcsr_type), INTENT(IN)                       :: source
+      INTEGER, INTENT(IN)                                :: components
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: matrix
+
+      INTEGER                                            :: blocks
+      INTEGER, POINTER                                   :: col_dist(:), expanded_cols(:), &
+                                                            expanded_rows(:), expanded_sizes(:), &
+                                                            row_dist(:), sizes(:)
+      TYPE(dbcsr_distribution_type)                      :: distribution, expanded_distribution
+
+      CALL dbcsr_get_info(source, distribution=distribution, row_blk_size=sizes)
+      CALL dbcsr_distribution_get(distribution, row_dist=row_dist, col_dist=col_dist)
+      blocks = SIZE(sizes)
+      ALLOCATE (expanded_sizes(blocks*components), expanded_rows(blocks*components), expanded_cols(blocks*components))
+      expanded_sizes = RESHAPE(SPREAD(sizes, 2, components), [blocks*components])
+      expanded_rows = RESHAPE(SPREAD(row_dist, 2, components), [blocks*components])
+      expanded_cols = RESHAPE(SPREAD(col_dist, 2, components), [blocks*components])
+      CALL dbcsr_distribution_new(expanded_distribution, template=distribution, &
+                                  row_dist=expanded_rows, col_dist=expanded_cols)
+      CALL dbcsr_create(matrix%real_part, 'FINITE AO RE', expanded_distribution, &
+                        dbcsr_type_no_symmetry, expanded_sizes, expanded_sizes)
+      CALL dbcsr_create(matrix%imaginary_part, template=matrix%real_part, name='FINITE AO IM')
+      CALL dbcsr_distribution_release(expanded_distribution)
+      DEALLOCATE (expanded_sizes, expanded_rows, expanded_cols)
+   END SUBROUTINE create_operator
+
+! **************************************************************************************************
+!> \brief Shared AO Hamiltonian, Hermitian scalar observables and optional GTH physical-spin SOC.
+!> \param h Scalar Hamiltonian
+!> \param s AO metric
+!> \param positions Covariant scalar observables, such as first moments or trigonometric coordinates
+!> \param operators Newly initialized Hamiltonian followed by the supplied observables
+!> \param metric Newly initialized physical-spin metric
+!> \param soc Optional antisymmetric real GTH SOC components
+! **************************************************************************************************
+   SUBROUTINE localizer_ao_operators(h, s, positions, operators, metric, soc)
+      TYPE(dbcsr_type), INTENT(IN)                       :: h, s
+      TYPE(dbcsr_p_type), INTENT(IN)                     :: positions(:)
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: operators(:), metric
+      TYPE(dbcsr_p_type), INTENT(IN), OPTIONAL           :: soc(:, :)
+
+      COMPLEX(dp), ALLOCATABLE                           :: factors(:, :), identity(:, :)
+      INTEGER                                            :: i, nspin
+
+      CPASSERT(SIZE(operators) == SIZE(positions) + 1)
+      nspin = 1
+      IF (PRESENT(soc)) nspin = 2
+      ALLOCATE (identity(nspin, nspin), factors(nspin, nspin))
+      identity = CMPLX(0.0_dp, 0.0_dp, dp)
+      DO i = 1, nspin
+         identity(i, i) = 1.0_dp
+      END DO
+      CALL create_operator(s, nspin, metric)
+      CALL add_real_blocks(s, identity, metric)
+      DO i = 1, SIZE(operators)
+         CALL create_operator(s, nspin, operators(i))
+      END DO
+      CALL add_real_blocks(h, identity, operators(1))
+      DO i = 1, SIZE(positions)
+         CALL add_real_blocks(positions(i)%matrix, identity, operators(i + 1))
+      END DO
+      IF (PRESENT(soc)) THEN
+         factors = CMPLX(0.0_dp, 0.0_dp, dp)
+         factors(1, 2) = CMPLX(0.0_dp, 1.0_dp, dp)
+         factors(2, 1) = CMPLX(0.0_dp, 1.0_dp, dp)
+         CALL add_real_blocks(soc(1, 1)%matrix, factors, operators(1))
+         factors(1, 2) = -1.0_dp
+         factors(2, 1) = 1.0_dp
+         CALL add_real_blocks(soc(2, 1)%matrix, factors, operators(1))
+         factors = CMPLX(0.0_dp, 0.0_dp, dp)
+         factors(1, 1) = CMPLX(0.0_dp, 1.0_dp, dp)
+         factors(2, 2) = CMPLX(0.0_dp, -1.0_dp, dp)
+         CALL add_real_blocks(soc(3, 1)%matrix, factors, operators(1))
+      END IF
+   END SUBROUTINE localizer_ao_operators
+
+! **************************************************************************************************
+!> \brief Apply complex AO matrices with DBCSR skinny-matrix products; no dense AO matrix.
+!> \param matrix Fully stored real/imaginary DBCSR operator
+!> \param v Replicated input coefficient block
+!> \param y Replicated output block (linear in AO dimension times block size)
+!> \param para_env Communicator
+!> \param adjoint Apply the conjugate transpose instead of the forward operator
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_apply(matrix, v, y, para_env, adjoint)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: matrix
+      COMPLEX(dp), INTENT(IN)                            :: v(:, :)
+      COMPLEX(dp), INTENT(OUT)                           :: y(:, :)
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      LOGICAL, INTENT(IN), OPTIONAL                      :: adjoint
+
+      CHARACTER                                          :: transpose_mode
+      INTEGER                                            :: last, nv, row
+      REAL(dp)                                           :: imaginary_sign
+      REAL(dp), POINTER                                  :: block(:, :)
+      TYPE(dbcsr_iterator_type)                          :: iterator
+      TYPE(dbcsr_type)                                   :: imaginary_image, real_image, vectors
+
+      nv = SIZE(v, 2)
+      transpose_mode = 'N'
+      imaginary_sign = 1.0_dp
+      IF (PRESENT(adjoint)) THEN
+         IF (adjoint) THEN
+            transpose_mode = 'T'
+            imaginary_sign = -1.0_dp
+         END IF
+      END IF
+      CALL create_col_vec_from_matrix(vectors, matrix%real_part, 2*nv)
+      CALL create_col_vec_from_matrix(real_image, matrix%real_part, 2*nv)
+      CALL create_col_vec_from_matrix(imaginary_image, matrix%real_part, 2*nv)
+      CALL dbcsr_iterator_start(iterator, vectors)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row)
+         last = row + SIZE(block, 1) - 1
+         block(:, :nv) = REAL(v(row:last, :), dp)
+         block(:, nv + 1:) = AIMAG(v(row:last, :))
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL dbcsr_multiply(transpose_mode, 'N', 1.0_dp, matrix%real_part, vectors, 0.0_dp, real_image)
+      CALL dbcsr_multiply(transpose_mode, 'N', 1.0_dp, matrix%imaginary_part, vectors, 0.0_dp, imaginary_image)
+      y = CMPLX(0.0_dp, 0.0_dp, dp)
+      CALL dbcsr_iterator_start(iterator, real_image)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row)
+         last = row + SIZE(block, 1) - 1
+         y(row:last, :) = CMPLX(block(:, :nv), block(:, nv + 1:), dp)
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL dbcsr_iterator_start(iterator, imaginary_image)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row)
+         last = row + SIZE(block, 1) - 1
+         y(row:last, :) = y(row:last, :) + imaginary_sign*CMPLX(-block(:, nv + 1:), block(:, :nv), dp)
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL para_env%sum(y)
+      CALL dbcsr_release(vectors)
+      CALL dbcsr_release(real_image)
+      CALL dbcsr_release(imaginary_image)
+   END SUBROUTINE localizer_dbcsr_apply
+
+! **************************************************************************************************
+!> \brief Pair H-E*S with its negative to reuse the metric-aware localizer gap solvers.
+!> \param h Complex physical Hamiltonian, including spin if present
+!> \param s Complex physical metric with the same AO block layout
+!> \param energy Reference energy
+!> \param pencil Newly allocated diag(H-E*S,-H+E*S)
+!> \param metric Newly allocated diag(S,S)
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_gap_pencil(h, s, energy, pencil, metric)
+      TYPE(localizer_matrix_type), INTENT(IN)            :: h, s
+      REAL(dp), INTENT(IN)                               :: energy
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: pencil, metric
+
+      COMPLEX(dp), PARAMETER :: imaginary = CMPLX(0.0_dp, 1.0_dp, dp)
+
+      COMPLEX(dp)                                        :: factors(2, 2)
+
+      CALL create_operator(s%real_part, 2, pencil)
+      CALL create_operator(s%real_part, 2, metric)
+      factors = RESHAPE([1.0_dp, 0.0_dp, 0.0_dp, -1.0_dp], [2, 2])
+      CALL add_real_blocks(h%real_part, factors, pencil)
+      CALL add_real_blocks(h%imaginary_part, imaginary*factors, pencil)
+      CALL add_real_blocks(s%real_part, -energy*factors, pencil)
+      CALL add_real_blocks(s%imaginary_part, -energy*imaginary*factors, pencil)
+      factors(2, 2) = 1.0_dp
+      CALL add_real_blocks(s%real_part, factors, metric)
+      CALL add_real_blocks(s%imaginary_part, imaginary*factors, metric)
+   END SUBROUTINE localizer_dbcsr_gap_pencil
+
+! **************************************************************************************************
+!> \brief Assemble L and B=diag(S,S), including optional physical spin and SOC, without dense AOs.
+!> \param h Real scalar Hamiltonian
+!> \param s Real AO overlap
+!> \param x First oriented real AO position
+!> \param y Second oriented real AO position
+!> \param point Two Cartesian coordinates
+!> \param energy Reference energy
+!> \param kappa Energy/length scale
+!> \param localizer Newly created complex DBCSR localizer
+!> \param metric Newly created complex DBCSR metric
+!> \param soc Real antisymmetric SOC components from V_SOC_xyz_from_pseudopotential
+!> \param periodic_cosines Optional two cos(G.r) matrices. Then x,y are sin(G.r), point is
+!>        G.r0, and kappa is the energy scale eta (not the finite energy/length scale).
+!> \param shifted_hamiltonian Optional replacement for the physical H-E*S including SOC.
+!>        Requires energy=0; the scalar h and SOC contributions are then not added again.
+!> \note Component-major ordering: auxiliary index, physical spin, then atomic AO blocks.
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_build(h, s, x, y, point, energy, kappa, localizer, metric, soc, periodic_cosines, &
+                                    shifted_hamiltonian)
+      TYPE(dbcsr_type), INTENT(IN)                       :: h, s, x, y
+      REAL(KIND=dp), INTENT(IN)                          :: point(2), energy, kappa
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: localizer, metric
+      TYPE(dbcsr_p_type), INTENT(IN), OPTIONAL           :: soc(:, :), periodic_cosines(:)
+      TYPE(localizer_matrix_type), INTENT(IN), OPTIONAL  :: shifted_hamiltonian
+
+      COMPLEX(KIND=dp), PARAMETER :: imaginary = CMPLX(0.0_dp, 1.0_dp, dp)
+
+      COMPLEX(dp)                                        :: signs(2, 2)
+      COMPLEX(KIND=dp), ALLOCATABLE                      :: factors(:, :), identity(:, :), sx(:, :), &
+                                                            sy(:, :), sz(:, :)
+      INTEGER                                            :: blocks, component, components, nspin, &
+                                                            physical_blocks
+      INTEGER, POINTER                                   :: col_dist(:), expanded_cols(:), &
+                                                            expanded_rows(:), expanded_sizes(:), &
+                                                            row_dist(:), sizes(:)
+      TYPE(dbcsr_distribution_type)                      :: distribution, expanded_distribution
+
+      nspin = 1
+      IF (PRESENT(soc)) nspin = 2
+      components = 2*nspin
+      CALL dbcsr_get_info(s, distribution=distribution, row_blk_size=sizes)
+      CALL dbcsr_distribution_get(distribution, row_dist=row_dist, col_dist=col_dist)
+      blocks = SIZE(sizes)
+      ALLOCATE (expanded_sizes(blocks*components), expanded_rows(blocks*components), expanded_cols(blocks*components))
+      expanded_sizes = RESHAPE(SPREAD(sizes, 2, components), [blocks*components])
+      expanded_rows = RESHAPE(SPREAD(row_dist, 2, components), [blocks*components])
+      expanded_cols = RESHAPE(SPREAD(col_dist, 2, components), [blocks*components])
+      CALL dbcsr_distribution_new(expanded_distribution, template=distribution, &
+                                  row_dist=expanded_rows, col_dist=expanded_cols)
+      CALL dbcsr_create(localizer%real_part, 'SPECTRAL LOCALIZER RE', expanded_distribution, &
+                        dbcsr_type_no_symmetry, expanded_sizes, expanded_sizes)
+      CALL dbcsr_create(localizer%imaginary_part, template=localizer%real_part, name='SPECTRAL LOCALIZER IM')
+      CALL dbcsr_create(metric%real_part, template=localizer%real_part, name='LOCALIZER METRIC RE')
+      CALL dbcsr_create(metric%imaginary_part, template=localizer%real_part, name='LOCALIZER METRIC IM')
+      CALL dbcsr_distribution_release(expanded_distribution)
+      DEALLOCATE (expanded_sizes, expanded_rows, expanded_cols)
+      ALLOCATE (factors(components, components), identity(components, components), &
+                sx(components, components), sy(components, components), sz(components, components))
+      identity = 0.0_dp
+      sx = 0.0_dp
+      sy = 0.0_dp
+      sz = 0.0_dp
+      DO component = 1, nspin
+         identity(component, component) = 1.0_dp
+         identity(nspin + component, nspin + component) = 1.0_dp
+         sz(component, component) = 1.0_dp
+         sz(nspin + component, nspin + component) = -1.0_dp
+         sx(component, nspin + component) = 1.0_dp
+         sx(nspin + component, component) = 1.0_dp
+         sy(component, nspin + component) = -imaginary
+         sy(nspin + component, component) = imaginary
+      END DO
+      CALL add_real_blocks(s, identity, metric)
+      IF (PRESENT(shifted_hamiltonian)) THEN
+         CPASSERT(energy == 0.0_dp)
+         CALL dbcsr_get_info(shifted_hamiltonian%real_part, nblkrows_total=physical_blocks)
+         CPASSERT(physical_blocks == nspin*blocks)
+         signs = RESHAPE([1.0_dp, 0.0_dp, 0.0_dp, -1.0_dp], [2, 2])
+         CALL add_real_blocks(shifted_hamiltonian%real_part, signs, localizer)
+         CALL add_real_blocks(shifted_hamiltonian%imaginary_part, imaginary*signs, localizer)
+      ELSE
+         CALL add_real_blocks(h, sz, localizer)
+      END IF
+      IF (PRESENT(periodic_cosines)) THEN
+         CPASSERT(SIZE(periodic_cosines) == 2)
+         CALL add_real_blocks(s, -(energy + 2.0_dp*kappa)*sz, localizer)
+         CALL add_real_blocks(periodic_cosines(1)%matrix, kappa*(COS(point(1))*sz - SIN(point(1))*sx), localizer)
+         CALL add_real_blocks(periodic_cosines(2)%matrix, kappa*(COS(point(2))*sz - SIN(point(2))*sy), localizer)
+         CALL add_real_blocks(x, kappa*(SIN(point(1))*sz + COS(point(1))*sx), localizer)
+         CALL add_real_blocks(y, kappa*(SIN(point(2))*sz + COS(point(2))*sy), localizer)
+      ELSE
+         CALL add_real_blocks(s, -energy*sz - kappa*(point(1)*sx + point(2)*sy), localizer)
+         CALL add_real_blocks(x, kappa*sx, localizer)
+         CALL add_real_blocks(y, kappa*sy, localizer)
+      END IF
+      IF (PRESENT(soc) .AND. .NOT. PRESENT(shifted_hamiltonian)) THEN
+         ! The real spherical-harmonic SOC matrices carry the missing factor i explicitly.
+         factors = 0.0_dp
+         factors(1, 2) = imaginary
+         factors(2, 1) = imaginary
+         factors(3, 4) = -imaginary
+         factors(4, 3) = -imaginary
+         CALL add_real_blocks(soc(1, 1)%matrix, factors, localizer)
+         factors = 0.0_dp
+         factors(1, 2) = -1.0_dp
+         factors(2, 1) = 1.0_dp
+         factors(3, 4) = 1.0_dp
+         factors(4, 3) = -1.0_dp
+         CALL add_real_blocks(soc(2, 1)%matrix, factors, localizer)
+         factors = 0.0_dp
+         factors(1, 1) = imaginary
+         factors(2, 2) = -imaginary
+         factors(3, 3) = -imaginary
+         factors(4, 4) = imaginary
+         CALL add_real_blocks(soc(3, 1)%matrix, factors, localizer)
+      END IF
+   END SUBROUTINE localizer_dbcsr_build
+
+! **************************************************************************************************
+!> \brief Add a small Kronecker factor times distributed real AO blocks, preserving their union.
+!> \param source Real symmetric or antisymmetric AO matrix
+!> \param factors Small component matrix
+!> \param destination Complex block-sparse destination
+! **************************************************************************************************
+   SUBROUTINE add_real_blocks(source, factors, destination)
+      TYPE(dbcsr_type), INTENT(IN)                       :: source
+      COMPLEX(KIND=dp), INTENT(IN)                       :: factors(:, :)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: destination
+
+      COMPLEX(KIND=dp), ALLOCATABLE                      :: values(:, :)
+      INTEGER                                            :: blocks, col, i, j, row
+      LOGICAL                                            :: transposed
+      REAL(KIND=dp), POINTER                             :: block(:, :)
+      TYPE(dbcsr_iterator_type)                          :: iterator
+      TYPE(dbcsr_type)                                   :: full
+
+      CALL dbcsr_get_info(source, nblkrows_total=blocks)
+      CALL dbcsr_create(full, template=source, matrix_type=dbcsr_type_no_symmetry)
+      CALL dbcsr_desymmetrize(source, full)
+      CALL dbcsr_iterator_start(iterator, full)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, row, col, block, transposed=transposed)
+         CPASSERT(.NOT. transposed)
+         ALLOCATE (values(SIZE(block, 1), SIZE(block, 2)))
+         DO j = 1, SIZE(factors, 2)
+            DO i = 1, SIZE(factors, 1)
+               IF (ABS(factors(i, j)) == 0.0_dp) CYCLE
+               values = factors(i, j)*block
+               IF (REAL(factors(i, j), dp) /= 0.0_dp) THEN
+                  CALL dbcsr_put_block(destination%real_part, row + (i - 1)*blocks, col + (j - 1)*blocks, &
+                                       REAL(values, dp), summation=.TRUE.)
+               END IF
+               IF (AIMAG(factors(i, j)) /= 0.0_dp) THEN
+                  CALL dbcsr_put_block(destination%imaginary_part, row + (i - 1)*blocks, col + (j - 1)*blocks, &
+                                       AIMAG(values), summation=.TRUE.)
+               END IF
+            END DO
+         END DO
+         DEALLOCATE (values)
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL dbcsr_release(full)
+      CALL dbcsr_finalize(destination%real_part)
+      CALL dbcsr_finalize(destination%imaginary_part)
+   END SUBROUTINE add_real_blocks
+
+! **************************************************************************************************
+!> \brief Collect the size-limited dense oracle; sparse solvers must not call this routine.
+!> \param matrix Fully stored complex block-sparse matrix
+!> \param para_env Matrix communicator
+!> \param dense Replicated matrix
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_dense(matrix, para_env, dense)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: matrix
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      COMPLEX(KIND=dp), ALLOCATABLE, INTENT(OUT)         :: dense(:, :)
+
+      INTEGER                                            :: col, n, row
+      LOGICAL                                            :: transposed
+      REAL(KIND=dp), POINTER                             :: block(:, :)
+      TYPE(dbcsr_iterator_type)                          :: iterator
+
+      CALL dbcsr_get_info(matrix%real_part, nfullrows_total=n)
+      ALLOCATE (dense(n, n))
+      dense = 0.0_dp
+      CALL dbcsr_iterator_start(iterator, matrix%real_part)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row, col_offset=col, &
+                                        transposed=transposed)
+         CPASSERT(.NOT. transposed)
+         dense(row:row + SIZE(block, 1) - 1, col:col + SIZE(block, 2) - 1) = block
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL dbcsr_iterator_start(iterator, matrix%imaginary_part)
+      DO WHILE (dbcsr_iterator_blocks_left(iterator))
+         CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row, col_offset=col, &
+                                        transposed=transposed)
+         CPASSERT(.NOT. transposed)
+         dense(row:row + SIZE(block, 1) - 1, col:col + SIZE(block, 2) - 1) = &
+            dense(row:row + SIZE(block, 1) - 1, col:col + SIZE(block, 2) - 1) + CMPLX(0.0_dp, 1.0_dp, dp)*block
+      END DO
+      CALL dbcsr_iterator_stop(iterator)
+      CALL para_env%sum(dense)
+   END SUBROUTINE localizer_dbcsr_dense
+
+! **************************************************************************************************
+!> \brief Check both components before a sparse solver discards the upper triangle.
+!> \param matrix Fully stored complex matrix
+!> \param para_env Matrix communicator
+!> \param tolerance Relative Hermiticity tolerance
+!> \param valid Whether all entries are finite and the matrix is Hermitian
+!> \param relative_error Largest component transpose residual divided by the largest component entry;
+!>        HUGE for nonfinite entries or residuals
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_check(matrix, para_env, tolerance, valid, relative_error)
+      TYPE(localizer_matrix_type), INTENT(INOUT) :: matrix
+      TYPE(mp_para_env_type), POINTER :: para_env
+      REAL(KIND=dp), INTENT(IN) :: tolerance
+      LOGICAL, INTENT(OUT) :: valid
+      REAL(KIND=dp), INTENT(OUT), OPTIONAL :: relative_error
+
+      LOGICAL :: valid_real, valid_imaginary
+      REAL(KIND=dp) :: real_norm, imaginary_norm, real_error, imaginary_error
+
+      CALL check_component(matrix%real_part, -1.0_dp, real_norm, real_error, valid_real)
+      CALL check_component(matrix%imaginary_part, 1.0_dp, imaginary_norm, imaginary_error, valid_imaginary)
+      valid = valid_real .AND. valid_imaginary
+      valid = valid .AND. MAX(real_error, imaginary_error) <= &
+         tolerance*MAX(TINY(1.0_dp), real_norm, imaginary_norm)
+      IF (PRESENT(relative_error)) THEN
+         relative_error = HUGE(1.0_dp)
+         IF (valid_real .AND. valid_imaginary) THEN
+            relative_error = MAX(real_error, imaginary_error)/MAX(TINY(1.0_dp), real_norm, imaginary_norm)
+         END IF
+      END IF
+
+   CONTAINS
+
+! **************************************************************************************************
+!> \brief Check real symmetry or imaginary antisymmetry using a distributed transpose.
+!> \param component Fully stored real matrix
+!> \param sign Sign multiplying the transpose
+!> \param norm Largest absolute entry
+!> \param error Largest transpose residual
+!> \param ok Whether all entries and residuals are finite
+! **************************************************************************************************
+      SUBROUTINE check_component(component, sign, norm, error, ok)
+      TYPE(dbcsr_type), INTENT(INOUT)                    :: component
+      REAL(KIND=dp), INTENT(IN)                          :: sign
+      REAL(KIND=dp), INTENT(OUT)                         :: norm, error
+      LOGICAL, INTENT(OUT)                               :: ok
+
+      INTEGER                                            :: invalid
+      REAL(KIND=dp), POINTER                             :: block(:, :)
+      TYPE(dbcsr_distribution_type)                      :: distribution
+      TYPE(dbcsr_iterator_type)                          :: iterator
+      TYPE(dbcsr_type)                                   :: difference
+
+         invalid = 0
+         norm = 0.0_dp
+         error = 0.0_dp
+         CALL dbcsr_iterator_start(iterator, component)
+         DO WHILE (dbcsr_iterator_blocks_left(iterator))
+            CALL dbcsr_iterator_next_block(iterator, block=block)
+            IF (.NOT. ALL(ieee_is_finite(block))) THEN
+               invalid = 1
+            ELSE
+               norm = MAX(norm, MAXVAL(ABS(block)))
+            END IF
+         END DO
+         CALL dbcsr_iterator_stop(iterator)
+         CALL para_env%max(invalid)
+         ok = .FALSE.
+         IF (invalid /= 0) RETURN
+         CALL para_env%max(norm)
+         CALL dbcsr_get_info(component, distribution=distribution)
+         CALL dbcsr_transposed(difference, component, shallow_data_copy=.FALSE., use_distribution=distribution)
+         CALL dbcsr_add(difference, component, sign, 1.0_dp)
+         error = 0.0_dp
+         CALL dbcsr_iterator_start(iterator, difference)
+         DO WHILE (dbcsr_iterator_blocks_left(iterator))
+            CALL dbcsr_iterator_next_block(iterator, block=block)
+            IF (.NOT. ALL(ieee_is_finite(block))) THEN
+               invalid = 1
+            ELSE
+               error = MAX(error, MAXVAL(ABS(block)))
+            END IF
+         END DO
+         CALL dbcsr_iterator_stop(iterator)
+         CALL dbcsr_release(difference)
+         CALL para_env%max(invalid)
+         CALL para_env%max(error)
+         ok = invalid == 0
+      END SUBROUTINE check_component
+
+   END SUBROUTINE localizer_dbcsr_check
+
+! **************************************************************************************************
+!> \brief Release both real components of a complex sparse operator.
+!> \param matrix Sparse operator
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_release(matrix)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: matrix
+
+      CALL dbcsr_release(matrix%real_part)
+      CALL dbcsr_release(matrix%imaginary_part)
+   END SUBROUTINE localizer_dbcsr_release
+
+! **************************************************************************************************
+!> \brief Distributed lower COO for realification R(A)=[Re(A),-Im(A);Im(A),Re(A)].
+!> \param localizer Hermitian complex sparse matrix
+!> \param metric Positive complex sparse metric
+!> \param para_env Matrix communicator
+!> \param order Realified dimension; each complex eigenvalue occurs twice
+!> \param rows Local lower row coordinates
+!> \param cols Local lower column coordinates
+!> \param a Local localizer values (duplicate coordinates are additive)
+!> \param b Local metric values
+!> \param identity Local identity values for conditioning checks
+! **************************************************************************************************
+   SUBROUTINE localizer_dbcsr_pencil(localizer, metric, para_env, order, rows, cols, a, b, identity)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: localizer, metric
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      INTEGER, INTENT(OUT)                               :: order
+      INTEGER, ALLOCATABLE, INTENT(OUT)                  :: rows(:), cols(:)
+      REAL(KIND=dp), ALLOCATABLE, INTENT(OUT)            :: a(:), b(:), identity(:)
+
+      INTEGER                                            :: i, n, nb, ni, nl, total
+      INTEGER, ALLOCATABLE                               :: bc(:), bi(:), bj(:), br(:), lc(:), &
+                                                            li(:), lj(:), lr(:)
+      REAL(KIND=dp), ALLOCATABLE                         :: biv(:), bv(:), liv(:), lv(:)
+
+      CALL dbcsr_get_info(localizer%real_part, nfullrows_total=n)
+      order = 2*n
+      CALL realified_coo(localizer%real_part, .FALSE., n, lr, lc, lv)
+      CALL realified_coo(localizer%imaginary_part, .TRUE., n, li, lj, liv)
+      CALL realified_coo(metric%real_part, .FALSE., n, br, bc, bv)
+      CALL realified_coo(metric%imaginary_part, .TRUE., n, bi, bj, biv)
+      nl = SIZE(lv) + SIZE(liv)
+      nb = SIZE(bv) + SIZE(biv)
+      ni = 0
+      IF (para_env%is_source()) ni = order
+      total = nl + nb + ni
+      ALLOCATE (rows(total), cols(total), a(total), b(total), identity(total))
+      rows(:nl + nb) = [lr, li, br, bi]
+      cols(:nl + nb) = [lc, lj, bc, bj]
+      a = 0.0_dp
+      b = 0.0_dp
+      identity = 0.0_dp
+      a(:nl) = [lv, liv]
+      b(nl + 1:nl + nb) = [bv, biv]
+      DO i = 1, ni
+         rows(nl + nb + i) = i
+         cols(nl + nb + i) = i
+         identity(nl + nb + i) = 1.0_dp
+      END DO
+   END SUBROUTINE localizer_dbcsr_pencil
+
+! **************************************************************************************************
+!> \brief Expand one real/imaginary component directly to a distributed lower real triangle.
+!> \param source Fully stored real component
+!> \param imaginary Whether this is the antisymmetric imaginary component
+!> \param n Complex matrix order
+!> \param rows Local realified rows
+!> \param cols Local realified columns
+!> \param values Local realified values
+! **************************************************************************************************
+   SUBROUTINE realified_coo(source, imaginary, n, rows, cols, values)
+      TYPE(dbcsr_type), INTENT(INOUT)                    :: source
+      LOGICAL, INTENT(IN)                                :: imaginary
+      INTEGER, INTENT(IN)                                :: n
+      INTEGER, ALLOCATABLE, INTENT(OUT)                  :: rows(:), cols(:)
+      REAL(KIND=dp), ALLOCATABLE, INTENT(OUT)            :: values(:)
+
+      INTEGER                                            :: col, count, i, ir, j, jc, pass, row
+      LOGICAL                                            :: transposed
+      REAL(KIND=dp), POINTER                             :: block(:, :)
+      TYPE(dbcsr_iterator_type)                          :: iterator
+
+      DO pass = 1, 2
+         count = 0
+         CALL dbcsr_iterator_start(iterator, source)
+         DO WHILE (dbcsr_iterator_blocks_left(iterator))
+            CALL dbcsr_iterator_next_block(iterator, block=block, row_offset=row, col_offset=col, &
+                                           transposed=transposed)
+            CPASSERT(.NOT. transposed)
+            DO j = 1, SIZE(block, 2)
+               DO i = 1, SIZE(block, 1)
+                  IF (block(i, j) == 0.0_dp) CYCLE
+                  ir = row + i - 1
+                  jc = col + j - 1
+                  IF (imaginary) THEN
+                     count = count + 1
+                     IF (pass == 2) THEN
+                        rows(count) = ir + n
+                        cols(count) = jc
+                        values(count) = block(i, j)
+                     END IF
+                  ELSE IF (ir >= jc) THEN
+                     count = count + 2
+                     IF (pass == 2) THEN
+                        rows(count - 1:count) = [ir, ir + n]
+                        cols(count - 1:count) = [jc, jc + n]
+                        values(count - 1:count) = block(i, j)
+                     END IF
+                  END IF
+               END DO
+            END DO
+         END DO
+         CALL dbcsr_iterator_stop(iterator)
+         IF (pass == 1) ALLOCATE (rows(count), cols(count), values(count))
+      END DO
+   END SUBROUTINE realified_coo
+
+END MODULE spectral_localizer_dbcsr
diff --git a/src/spectral_localizer_flatten.F b/src/spectral_localizer_flatten.F
new file mode 100644
index 0000000000000000000000000000000000000000..4aefe5b2532a639ffd17e950b85c10e7be475501
--- /dev/null
+++ b/src/spectral_localizer_flatten.F
@@ -0,0 +1,211 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Metric-covariant spectral flattening with existing distributed matrix iterations.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE spectral_localizer_flatten
+   USE cp_dbcsr_api,                    ONLY: dbcsr_add,&
+                                              dbcsr_create,&
+                                              dbcsr_get_info,&
+                                              dbcsr_multiply,&
+                                              dbcsr_release,&
+                                              dbcsr_type
+   USE cp_dbcsr_contrib,                ONLY: dbcsr_add_on_diag,&
+                                              dbcsr_frobenius_norm
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE iterate_matrix,                  ONLY: invert_Hotelling,&
+                                              matrix_sign_Newton_Schulz
+   USE kinds,                           ONLY: dp
+   USE localizer_sparse_inertia,        ONLY: sparse_inertia_type
+   USE message_passing,                 ONLY: mp_para_env_type
+   USE spectral_localizer,              ONLY: localizer_matrix_evaluate
+   USE spectral_localizer_dbcsr,        ONLY: localizer_dbcsr_check,&
+                                              localizer_dbcsr_dense,&
+                                              localizer_dbcsr_from_real,&
+                                              localizer_dbcsr_gap_pencil,&
+                                              localizer_dbcsr_pencil,&
+                                              localizer_dbcsr_realify,&
+                                              localizer_dbcsr_release,&
+                                              localizer_matrix_type
+   USE spectral_localizer_sparse,       ONLY: localizer_sparse_evaluate
+
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: localizer_flatten_dbcsr, localizer_flatten_checked
+
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Establish a positive AO metric and electronic gap before iterating the matrix sign.
+!> \param h Covariant physical Hamiltonian, unchanged
+!> \param s Covariant physical metric, unchanged
+!> \param energy Reference energy
+!> \param scale Positive flattened-band energy
+!> \param tolerance Matrix-sign residual and Hermiticity tolerance
+!> \param metric_tolerance Minimum overlap eigenvalue ratio
+!> \param gap_tolerance Absolute minimum original electronic gap
+!> \param sparse Use MUMPS shifted inertia instead of a dense spectral reference
+!> \param para_env Communicator
+!> \param flattened Newly initialized shifted Hamiltonian only on success
+!> \param gap Original electronic gap lower and upper bounds, not the flattened localizer gap
+!> \param metric_ratio Overlap eigenvalue ratio, or a conservative lower bound for MUMPS
+!> \param residuals Four matrix-sign residuals
+!> \param status 0 success, 1 unresolved input gap, -1 input, -2 metric, -4 solver,
+!>        -5 unavailable sparse backend, -6 matrix-sign iteration or structure failure
+! **************************************************************************************************
+   SUBROUTINE localizer_flatten_checked(h, s, energy, scale, tolerance, metric_tolerance, gap_tolerance, sparse, &
+                                        para_env, flattened, gap, metric_ratio, residuals, status)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: h, s
+      REAL(dp), INTENT(IN)                               :: energy, scale, tolerance, &
+                                                            metric_tolerance, gap_tolerance
+      LOGICAL, INTENT(IN)                                :: sparse
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: flattened
+      REAL(dp), INTENT(OUT)                              :: gap(2), metric_ratio, residuals(4)
+      INTEGER, INTENT(OUT)                               :: status
+
+      COMPLEX(dp), ALLOCATABLE                           :: dense(:, :), dense_metric(:, :)
+      INTEGER                                            :: invariant, n, ns, order
+      INTEGER, ALLOCATABLE                               :: cols(:), rows(:)
+      LOGICAL                                            :: valid
+      REAL(dp), ALLOCATABLE                              :: a(:), b(:), identity(:)
+      TYPE(localizer_matrix_type)                        :: metric, pencil
+      TYPE(sparse_inertia_type)                          :: statistics
+
+      status = -1
+      gap = 0.0_dp
+      metric_ratio = 0.0_dp
+      residuals = HUGE(1.0_dp)
+      IF (.NOT. ALL(ieee_is_finite([energy, scale, tolerance, metric_tolerance, gap_tolerance]))) RETURN
+      IF (scale <= 0.0_dp .OR. tolerance <= 0.0_dp .OR. tolerance >= 1.0_dp) RETURN
+      IF (metric_tolerance <= 0.0_dp .OR. metric_tolerance >= 1.0_dp .OR. gap_tolerance < 0.0_dp) RETURN
+      CALL dbcsr_get_info(h%real_part, nfullrows_total=n)
+      CALL dbcsr_get_info(s%real_part, nfullrows_total=ns)
+      IF (n < 1 .OR. n /= ns) RETURN
+      CALL localizer_dbcsr_check(h, para_env, tolerance, valid)
+      IF (.NOT. valid) RETURN
+      CALL localizer_dbcsr_check(s, para_env, tolerance, valid)
+      IF (.NOT. valid) RETURN
+      CALL localizer_dbcsr_gap_pencil(h, s, energy, pencil, metric)
+      IF (sparse) THEN
+         CALL localizer_dbcsr_pencil(pencil, metric, para_env, order, rows, cols, a, b, identity)
+         CALL localizer_sparse_evaluate(order, rows, cols, a, b, identity, para_env, metric_tolerance, gap_tolerance, &
+                                        invariant, gap(1), gap(2), metric_ratio, statistics, status)
+      ELSE
+         CALL localizer_dbcsr_dense(pencil, para_env, dense)
+         CALL localizer_dbcsr_dense(metric, para_env, dense_metric)
+         IF (para_env%is_source()) THEN
+            CALL localizer_matrix_evaluate(dense, dense_metric(:n, :n), .FALSE., tolerance, metric_tolerance, &
+                                           gap_tolerance, invariant, gap(1), metric_ratio, status)
+            IF (status > 1) status = -4
+            gap(2) = gap(1)
+         END IF
+      END IF
+      CALL localizer_dbcsr_release(pencil)
+      CALL localizer_dbcsr_release(metric)
+      CALL para_env%bcast(status, para_env%source)
+      CALL para_env%bcast(gap, para_env%source)
+      CALL para_env%bcast(metric_ratio, para_env%source)
+      IF (status /= 0) RETURN
+      CALL para_env%bcast(invariant, para_env%source)
+      IF (invariant /= 0) THEN
+         status = -4
+         RETURN
+      END IF
+      CALL localizer_flatten_dbcsr(h, s, energy, scale, tolerance, para_env, flattened, residuals, status)
+      IF (status /= 0) status = -6
+   END SUBROUTINE localizer_flatten_checked
+
+! **************************************************************************************************
+!> \brief Form scale*S*sign(S^-1*(H-energy*S)) without dense AO matrices or S^-1/2.
+!> \param h Covariant Hermitian Hamiltonian; unchanged
+!> \param s Positive definite AO metric; must be validated by the caller
+!> \param energy Reference energy, separated from the generalized spectrum at input accuracy
+!> \param scale Positive energy scale of the flattened bands
+!> \param tolerance Residual tolerance, not a certificate of the original Hamiltonian gap
+!> \param para_env DBCSR communicator
+!> \param flattened Newly initialized covariant operator only on success
+!> \param residuals Inverse, sign-square, complex-structure and Hermiticity residuals
+!> \param status 0 success, -1 invalid input, 1 unconverged sign/inverse, 2 broken structure
+!> \note Caller must establish a positive metric and a resolved electronic gap independently.
+!>       Matrix-sign convergence alone cannot certify the occupied subspace near a gap closing.
+! **************************************************************************************************
+   SUBROUTINE localizer_flatten_dbcsr(h, s, energy, scale, tolerance, para_env, flattened, residuals, status)
+      TYPE(localizer_matrix_type), INTENT(INOUT)         :: h, s
+      REAL(dp), INTENT(IN)                               :: energy, scale, tolerance
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: flattened
+      REAL(dp), INTENT(OUT)                              :: residuals(4)
+      INTEGER, INTENT(OUT)                               :: status
+
+      INTEGER                                            :: n, ns
+      LOGICAL                                            :: valid
+      REAL(dp)                                           :: filter, norm
+      TYPE(dbcsr_type)                                   :: a, b, inverse, sign_matrix, trial, work
+
+      status = -1
+      residuals = HUGE(1.0_dp)
+      IF (.NOT. ALL(ieee_is_finite([energy, scale, tolerance]))) RETURN
+      IF (scale <= 0.0_dp .OR. tolerance <= 0.0_dp .OR. tolerance >= 1.0_dp) RETURN
+      CALL dbcsr_get_info(h%real_part, nfullrows_total=n)
+      CALL dbcsr_get_info(s%real_part, nfullrows_total=ns)
+      IF (n < 1 .OR. n /= ns) RETURN
+      CALL localizer_dbcsr_check(h, para_env, tolerance, valid)
+      IF (.NOT. valid) RETURN
+      CALL localizer_dbcsr_check(s, para_env, tolerance, valid)
+      IF (.NOT. valid) RETURN
+      CALL localizer_dbcsr_realify(h, a)
+      CALL localizer_dbcsr_realify(s, b)
+      CALL dbcsr_add(a, b, 1.0_dp, -energy)
+      CALL dbcsr_create(inverse, template=b)
+      CALL dbcsr_create(sign_matrix, template=b)
+      CALL dbcsr_create(trial, template=b)
+      CALL dbcsr_create(work, template=b)
+      filter = MIN(1.e-16_dp, 0.01_dp*tolerance**2)
+      DO
+         norm = dbcsr_frobenius_norm(a)
+         status = 1
+         IF (.NOT. ieee_is_finite(norm) .OR. norm == 0.0_dp) EXIT
+         CALL invert_Hotelling(inverse, b, 0.1_dp*tolerance, filter_eps=filter, &
+                               accelerator_order=0, silent=.TRUE.)
+         CALL dbcsr_multiply('N', 'N', 1.0_dp, b, inverse, 0.0_dp, work)
+         CALL dbcsr_add_on_diag(work, -1.0_dp)
+         residuals(1) = dbcsr_frobenius_norm(work)
+         IF (.NOT. ieee_is_finite(residuals(1)) .OR. residuals(1) > tolerance) EXIT
+         CALL dbcsr_multiply('N', 'N', 1.0_dp, inverse, a, 0.0_dp, trial)
+         CALL matrix_sign_Newton_Schulz(sign_matrix, trial, filter, sign_order=2, iounit=-1)
+         CALL dbcsr_multiply('N', 'N', 1.0_dp, sign_matrix, sign_matrix, 0.0_dp, work)
+         CALL dbcsr_add_on_diag(work, -1.0_dp)
+         residuals(2) = dbcsr_frobenius_norm(work)
+         IF (.NOT. ieee_is_finite(residuals(2)) .OR. residuals(2) > tolerance) EXIT
+         CALL dbcsr_multiply('N', 'N', scale, b, sign_matrix, 0.0_dp, trial)
+         CALL localizer_dbcsr_from_real(trial, h, flattened)
+         CALL dbcsr_release(work)
+         CALL localizer_dbcsr_realify(flattened, work)
+         norm = MAX(dbcsr_frobenius_norm(trial), TINY(1.0_dp))
+         CALL dbcsr_add(work, trial, 1.0_dp, -1.0_dp)
+         residuals(3) = dbcsr_frobenius_norm(work)/norm
+         CALL localizer_dbcsr_check(flattened, para_env, tolerance, valid, residuals(4))
+         status = 2
+         IF (.NOT. valid .OR. .NOT. ALL(ieee_is_finite(residuals)) .OR. MAXVAL(residuals) > tolerance) THEN
+            CALL localizer_dbcsr_release(flattened)
+            EXIT
+         END IF
+         status = 0
+         EXIT
+      END DO
+      CALL dbcsr_release(a)
+      CALL dbcsr_release(b)
+      CALL dbcsr_release(inverse)
+      CALL dbcsr_release(sign_matrix)
+      CALL dbcsr_release(trial)
+      CALL dbcsr_release(work)
+   END SUBROUTINE localizer_flatten_dbcsr
+
+END MODULE spectral_localizer_flatten
diff --git a/src/spectral_localizer_flatten_unittest.F b/src/spectral_localizer_flatten_unittest.F
new file mode 100644
index 0000000000000000000000000000000000000000..d405d8dc6d25750065ae89310038be346c29ea34
--- /dev/null
+++ b/src/spectral_localizer_flatten_unittest.F
@@ -0,0 +1,394 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Complex metric-covariant matrix sign against exact spectral constructions.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+PROGRAM spectral_localizer_flatten_unittest
+   USE cp_dbcsr_api,                    ONLY: &
+        dbcsr_create, dbcsr_distribution_new, dbcsr_distribution_release, dbcsr_distribution_type, &
+        dbcsr_finalize, dbcsr_finalize_lib, dbcsr_init_lib, dbcsr_put_block, dbcsr_type_no_symmetry
+   USE cp_log_handling,                 ONLY: cp_add_default_logger,&
+                                              cp_logger_create,&
+                                              cp_logger_release,&
+                                              cp_logger_type,&
+                                              cp_rm_default_logger
+   USE fft_tools,                       ONLY: finalize_fft,&
+                                              init_fft
+   USE ieee_arithmetic,                 ONLY: ieee_quiet_nan,&
+                                              ieee_value
+   USE kinds,                           ONLY: dp
+   USE machine,                         ONLY: default_output_unit
+   USE mathconstants,                   ONLY: twopi
+   USE message_passing,                 ONLY: mp_para_env_type,&
+                                              mp_world_finalize,&
+                                              mp_world_init
+   USE spectral_localizer_bloch,        ONLY: localizer_flatten_bloch
+   USE spectral_localizer_dbcsr,        ONLY: localizer_dbcsr_dense,&
+                                              localizer_dbcsr_release,&
+                                              localizer_matrix_type
+   USE spectral_localizer_flatten,      ONLY: localizer_flatten_checked,&
+                                              localizer_flatten_dbcsr
+#include "./base/base_uses.f90"
+
+   IMPLICIT NONE
+   INTEGER, PARAMETER :: n = 12, nb = 6, bs = 2
+   TYPE(mp_para_env_type), POINTER :: para_env
+   TYPE(cp_logger_type), POINTER :: logger
+   TYPE(dbcsr_distribution_type) :: distribution
+   TYPE(localizer_matrix_type) :: h, s, flat
+   INTEGER, POINTER :: process_grid(:, :), row_dist(:), col_dist(:), sizes(:)
+   COMPLEX(dp) :: transform(n, n), u(n, n), rotation(n, n), scaled(n, n), hdense(n, n), sdense(n, n), exact(n, n)
+   COMPLEX(dp), ALLOCATABLE :: result(:, :)
+   REAL(dp) :: energies(n), residuals(4), difference, maximum_error, energy, scale, gap(2), metric_ratio, exact_gap
+   INTEGER :: i, j, mode, nr, nc, io, status
+   LOGICAL :: sparse
+   CHARACTER(LEN=32) :: argument
+
+   ALLOCATE (para_env)
+   CALL mp_world_init(para_env)
+   io = -1
+   IF (para_env%is_source()) io = default_output_unit
+   CALL cp_logger_create(logger, para_env=para_env, default_global_unit_nr=io, close_global_unit_on_dealloc=.FALSE.)
+   CALL cp_add_default_logger(logger)
+   CALL dbcsr_init_lib(para_env%get_handle(), io)
+   CALL init_fft('FFTSG', alltoall=.FALSE., pool_limit=4, wisdom_file='', plan_style=1)
+   nr = para_env%num_pe
+   nc = 1
+   sparse = .FALSE.
+   DO i = 1, command_argument_count()
+      CALL get_command_argument(i, argument)
+      IF (TRIM(argument) == '--column-grid') THEN
+         nr = 1
+         nc = para_env%num_pe
+      END IF
+      IF (TRIM(argument) == '--sparse') sparse = .TRUE.
+   END DO
+   ALLOCATE (process_grid(0:nr - 1, 0:nc - 1), row_dist(nb), col_dist(nb), sizes(nb))
+   process_grid = RESHAPE([(i, i=0, para_env%num_pe - 1)], [nr, nc])
+   row_dist = [(MODULO(i - 1, nr), i=1, nb)]
+   col_dist = [(MODULO(i - 1, nc), i=1, nb)]
+   sizes = bs
+   CALL dbcsr_distribution_new(distribution, group=para_env%get_handle(), pgrid=process_grid, &
+                               row_dist=row_dist, col_dist=col_dist)
+   energy = 0.002_dp
+   scale = 1.7_dp
+   maximum_error = 0.0_dp
+   DO mode = 0, 5
+      u = 0.0_dp
+      transform = 0.0_dp
+      DO i = 1, n
+         energies(i) = 0.01_dp*(i - n/2) - 0.005_dp
+         transform(i, i) = 1.0_dp
+         DO j = 1, n
+            u(i, j) = EXP(CMPLX(0.0_dp, twopi*REAL((i - 1)*(j - 1), dp)/n, dp))/SQRT(REAL(n, dp))
+         END DO
+         IF (mode == 0) CYCLE
+         transform(i, i) = 0.5_dp + 0.1_dp*i
+         IF (i < n) transform(i, i + 1) = CMPLX(0.13_dp, -0.08_dp, dp)
+      END DO
+      IF (mode == 2) transform(n, n) = 0.1_dp
+      IF (mode == 4) energies = energies + 0.5_dp
+      IF (mode == 5) energies = energies - 0.5_dp
+      IF (mode == 3) THEN
+         u = 0.0_dp
+         rotation = 0.0_dp
+         transform(:n/2, n/2 + 1:) = 0.0_dp
+         transform(n/2 + 1:, :n/2) = 0.0_dp
+         transform(n/2 + 1:, n/2 + 1:) = CONJG(transform(:n/2, :n/2))
+         DO i = 1, n/2
+            energies(i) = 0.01_dp*(i - n/4) - 0.005_dp
+            energies(n/2 + i) = energies(i)
+            rotation(i, i) = COS(0.37_dp)
+            rotation(n/2 + i, n/2 + i) = COS(0.37_dp)
+            rotation(i, n/2 + i) = SIN(0.37_dp)
+            rotation(n/2 + i, i) = -SIN(0.37_dp)
+            DO j = 1, n/2
+               u(i, j) = EXP(CMPLX(0.0_dp, twopi*REAL((i - 1)*(j - 1), dp)/(n/2), dp))/SQRT(REAL(n/2, dp))
+            END DO
+         END DO
+         u(n/2 + 1:, n/2 + 1:) = CONJG(u(:n/2, :n/2))
+         u = MATMUL(rotation, u)
+      END IF
+      scaled = u*SPREAD(energies, 1, n)
+      hdense = MATMUL(CONJG(TRANSPOSE(transform)), MATMUL(MATMUL(scaled, CONJG(TRANSPOSE(u))), transform))
+      sdense = MATMUL(CONJG(TRANSPOSE(transform)), transform)
+      scaled = u*SPREAD(SIGN(scale, energies - energy), 1, n)
+      exact = MATMUL(CONJG(TRANSPOSE(transform)), MATMUL(MATMUL(scaled, CONJG(TRANSPOSE(u))), transform))
+      CALL make_operator(hdense, h)
+      CALL make_operator(sdense, s)
+      CALL localizer_flatten_dbcsr(h, s, energy, scale, 1.e-9_dp, para_env, flat, residuals, status)
+      IF (status /= 0) THEN
+         IF (io > 0) WRITE (io, *) 'Flatten failure: ', mode, status, residuals
+         CPABORT('Distributed spectral flattening failed')
+      END IF
+      CALL localizer_dbcsr_dense(flat, para_env, RESULT)
+      difference = MAXVAL(ABS(RESULT - exact))
+      maximum_error = MAX(maximum_error, difference)
+      IF (difference > 1.e-9_dp) THEN
+         CPABORT('Covariant sign differs from exact eigensystem')
+      END IF
+      IF (mode == 3) THEN
+         IF (MAXVAL(ABS(RESULT(:n/2, :n/2) - CONJG(RESULT(n/2 + 1:, n/2 + 1:)))) > 1.e-9_dp) THEN
+            CPABORT('Flattening broke physical TR diagonal blocks')
+         END IF
+         IF (MAXVAL(ABS(RESULT(:n/2, n/2 + 1:) + CONJG(RESULT(n/2 + 1:, :n/2)))) > 1.e-9_dp) THEN
+            CPABORT('Flattening broke physical TR spin mixing')
+         END IF
+      END IF
+      DEALLOCATE (RESULT)
+      CALL localizer_dbcsr_dense(h, para_env, RESULT)
+      IF (MAXVAL(ABS(RESULT - hdense)) > 1.e-14_dp) THEN
+         CPABORT('Flattening modified input Hamiltonian')
+      END IF
+      DEALLOCATE (RESULT)
+      CALL localizer_dbcsr_dense(s, para_env, RESULT)
+      IF (MAXVAL(ABS(RESULT - sdense)) > 1.e-14_dp) THEN
+         CPABORT('Flattening modified input metric')
+      END IF
+      DEALLOCATE (RESULT)
+      CALL localizer_dbcsr_release(flat)
+      CALL localizer_flatten_checked(h, s, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                     para_env, flat, gap, metric_ratio, residuals, status)
+      IF (status /= 0) CPABORT('Checked flattening failed')
+      exact_gap = MINVAL(ABS(energies - energy))
+      IF (gap(1) > exact_gap + 1.e-10_dp .OR. gap(2) < exact_gap - 1.e-10_dp) THEN
+         CPABORT('Input electronic gap differs from reference')
+      END IF
+      IF (metric_ratio <= 1.e-10_dp) CPABORT('Invalid positive metric bound')
+      CALL localizer_dbcsr_dense(flat, para_env, RESULT)
+      difference = MAXVAL(ABS(RESULT - exact))
+      maximum_error = MAX(maximum_error, difference)
+      IF (difference > 1.e-9_dp) THEN
+         CPABORT('Checked flattening changed the exact result')
+      END IF
+      DEALLOCATE (RESULT)
+      CALL localizer_dbcsr_release(flat)
+      CALL localizer_dbcsr_release(h)
+      CALL localizer_dbcsr_release(s)
+   END DO
+
+   hdense = 0.0_dp
+   sdense = 0.0_dp
+   DO i = 1, n
+      sdense(i, i) = 1.0_dp
+      hdense(i, i) = 1.0_dp
+   END DO
+   hdense(1, 1) = 0.0_dp
+   CALL make_operator(hdense, h)
+   CALL make_operator(sdense, s)
+   CALL localizer_flatten_dbcsr(h, s, 0.0_dp, scale, 1.e-9_dp, para_env, flat, residuals, status)
+   IF (status /= 1) CPABORT('Singular spectral sign was accepted')
+   CALL localizer_flatten_checked(h, s, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                  para_env, flat, gap, metric_ratio, residuals, status)
+   IF (status /= 1) CPABORT('Checked flattening accepted a zero spectral mode')
+   CALL localizer_flatten_dbcsr(h, s, energy, -scale, 1.e-9_dp, para_env, flat, residuals, status)
+   IF (status /= -1) CPABORT('Negative flattening scale was accepted')
+   CALL localizer_flatten_dbcsr(h, s, ieee_value(energy, ieee_quiet_nan), scale, 1.e-9_dp, &
+                                para_env, flat, residuals, status)
+   IF (status /= -1) CPABORT('Nonfinite energy was accepted')
+   CALL localizer_dbcsr_release(h)
+   hdense = 0.0_dp
+   CALL make_operator(hdense, h)
+   CALL localizer_flatten_dbcsr(h, s, 0.0_dp, scale, 1.e-9_dp, para_env, flat, residuals, status)
+   IF (status /= 1) CPABORT('Zero Hamiltonian sign was accepted')
+   CALL localizer_dbcsr_release(h)
+   hdense(1, 2) = 1.0_dp
+   CALL make_operator(hdense, h)
+   CALL localizer_flatten_dbcsr(h, s, energy, scale, 1.e-9_dp, para_env, flat, residuals, status)
+   IF (status /= -1) CPABORT('Non-Hermitian Hamiltonian was accepted')
+   CALL localizer_dbcsr_release(h)
+   CALL localizer_dbcsr_release(s)
+   hdense = sdense
+   hdense(1, 1) = 1.e-11_dp
+   CALL make_operator(hdense, h)
+   CALL make_operator(sdense, s)
+   CALL localizer_flatten_checked(h, s, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                  para_env, flat, gap, metric_ratio, residuals, status)
+   IF (status /= 1) CPABORT('Unresolved near-zero spectral mode was accepted')
+   CALL localizer_dbcsr_release(s)
+   sdense(1, 1) = -1.0_dp
+   CALL make_operator(sdense, s)
+   CALL localizer_flatten_checked(h, s, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                  para_env, flat, gap, metric_ratio, residuals, status)
+   IF (status /= -2) CPABORT('Indefinite metric was accepted')
+   CALL localizer_dbcsr_release(s)
+   sdense(1, 1) = 1.e-12_dp
+   CALL make_operator(sdense, s)
+   CALL localizer_flatten_checked(h, s, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                  para_env, flat, gap, metric_ratio, residuals, status)
+   IF (status /= -2) CPABORT('Ill-conditioned metric was accepted')
+   CALL localizer_dbcsr_release(h)
+   CALL localizer_dbcsr_release(s)
+   CALL check_bloch()
+   IF (io > 0) WRITE (io, '(A,ES14.5)') 'Spectral flattening exact-matrix maximum error: ', maximum_error
+   CALL dbcsr_distribution_release(distribution)
+   DEALLOCATE (process_grid, row_dist, col_dist, sizes)
+   CALL dbcsr_finalize_lib()
+   CALL finalize_fft(para_env, '')
+   CALL cp_rm_default_logger()
+   CALL cp_logger_release(logger)
+   DEALLOCATE (para_env)
+   CALL mp_world_finalize()
+
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Complex nonorthogonal full-band Fourier references in spin/cell/atom order.
+! **************************************************************************************************
+   SUBROUTINE check_bloch()
+      INTEGER                                            :: band, grid(3), k, kr(3), m, ncell, &
+                                                            nscalar, nsmall, nspin, p, pnext, &
+                                                            r(3), rnext, row, t, tnext
+      REAL(dp)                                           :: bloch_error, bloch_gap, norm_error, &
+                                                            phase, ref_gap
+
+      bloch_error = 0.0_dp
+      DO m = 1, 7
+         sizes = bs
+         grid = [3, 1, 1]
+         nspin = 2
+         IF (m == 2) grid = [1, 3, 1]
+         IF (m == 3) grid = [1, 1, 3]
+         IF (m == 4) THEN
+            grid = [2, 3, 1]
+            nspin = 1
+         END IF
+         IF (m == 5) THEN
+            nspin = 1
+            sizes = [1, 3, 1, 3, 1, 3]
+         END IF
+         IF (m == 6) grid = 1
+         ncell = PRODUCT(grid)
+         nscalar = n/(nspin*ncell)
+         nsmall = nscalar*nspin
+         u = 0.0_dp
+         transform = 0.0_dp
+         DO row = 1, n
+            t = MODULO((row - 1)/nscalar, ncell)
+            p = ((row - 1)/(ncell*nscalar))*nscalar + MODULO(row - 1, nscalar)
+            r = [MODULO(t, grid(1)), MODULO(t/grid(1), grid(2)), t/(grid(1)*grid(2))]
+            transform(row, row) = 1.0_dp + 0.03_dp*p
+            pnext = MODULO(p + 1, nsmall)
+            rnext = (pnext/nscalar)*ncell*nscalar + t*nscalar + MODULO(pnext, nscalar) + 1
+            transform(row, rnext) = transform(row, rnext) + CMPLX(0.07_dp, -0.04_dp, dp)
+            tnext = MODULO(t + 1, ncell)
+            rnext = (p/nscalar)*ncell*nscalar + tnext*nscalar + MODULO(p, nscalar) + 1
+            ! A 1D cyclic displacement is a lattice translation for these first-axis-fast grids.
+            IF (m /= 4) transform(row, rnext) = transform(row, rnext) + CMPLX(0.05_dp, 0.02_dp, dp)
+            DO k = 0, ncell - 1
+               kr = [MODULO(k, grid(1)), MODULO(k/grid(1), grid(2)), k/(grid(1)*grid(2))]
+               DO band = 0, nsmall - 1
+                  phase = twopi*(SUM(REAL(kr*r, dp)/REAL(grid, dp)) + REAL(p*band, dp)/REAL(nsmall, dp))
+                  u(row, k*nsmall + band + 1) = EXP(CMPLX(0.0_dp, phase, dp))/SQRT(REAL(n, dp))
+                  energies(k*nsmall + band + 1) = 0.2_dp + 0.03_dp*band + 0.01_dp*COS(REAL(k, dp))
+                  IF (m == 7) energies(k*nsmall + band + 1) = 0.25_dp + 0.01_dp*COS(REAL(k, dp))
+                  IF (band < nsmall/2) energies(k*nsmall + band + 1) = -energies(k*nsmall + band + 1)
+               END DO
+            END DO
+         END DO
+         scaled = u*SPREAD(energies, 1, n)
+         hdense = MATMUL(CONJG(TRANSPOSE(transform)), MATMUL(MATMUL(scaled, CONJG(TRANSPOSE(u))), transform))
+         sdense = MATMUL(CONJG(TRANSPOSE(transform)), transform)
+         scaled = u*SPREAD(SIGN(scale, energies - energy), 1, n)
+         exact = MATMUL(CONJG(TRANSPOSE(transform)), MATMUL(MATMUL(scaled, CONJG(TRANSPOSE(u))), transform))
+         CALL make_operator(hdense, h)
+         CALL make_operator(sdense, s)
+         CALL localizer_flatten_bloch(h, s, grid, nspin, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                      para_env, flat, bloch_gap, metric_ratio, residuals, status)
+         IF (status /= 0) CPABORT('Bloch flattening failed')
+         CALL localizer_dbcsr_dense(flat, para_env, RESULT)
+         norm_error = MAXVAL(ABS(RESULT - exact))
+         bloch_error = MAX(bloch_error, norm_error)
+         maximum_error = MAX(maximum_error, norm_error)
+         ref_gap = MINVAL(ABS(energies - energy))
+         IF (norm_error > 1.e-11_dp .OR. ABS(bloch_gap - ref_gap) > 1.e-12_dp) THEN
+            CPABORT('Bloch flattening differs from exact full-torus reference')
+         END IF
+         CALL localizer_dbcsr_release(flat)
+         CALL localizer_flatten_checked(h, s, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, sparse, &
+                                        para_env, flat, gap, metric_ratio, residuals, status)
+         IF (status /= 0) CPABORT('Full-torus reference flattening failed')
+         CALL localizer_dbcsr_dense(flat, para_env, RESULT)
+         IF (MAXVAL(ABS(RESULT - exact)) > 1.e-10_dp) THEN
+            CPABORT('Full-torus/Bloch sign mismatch')
+         END IF
+         CALL localizer_dbcsr_release(flat)
+         CALL localizer_dbcsr_release(h)
+         IF (m /= 6) THEN
+            hdense(1, 1) = hdense(1, 1) + 0.01_dp
+            CALL make_operator(hdense, h)
+            CALL localizer_flatten_bloch(h, s, grid, nspin, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                         para_env, flat, bloch_gap, metric_ratio, residuals, status)
+            IF (status /= -7) CPABORT('Broken translations accepted')
+            CALL localizer_dbcsr_release(h)
+         END IF
+         CALL make_operator(energy*sdense, h)
+         CALL localizer_flatten_bloch(h, s, grid, nspin, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                      para_env, flat, bloch_gap, metric_ratio, residuals, status)
+         IF (status /= 1) CPABORT('Closed Bloch gap accepted')
+         CALL localizer_dbcsr_release(s)
+         CALL make_operator(-sdense, s)
+         CALL localizer_flatten_bloch(h, s, grid, nspin, energy, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                      para_env, flat, bloch_gap, metric_ratio, residuals, status)
+         IF (status /= -2) CPABORT('Bloch flattening accepted an indefinite metric')
+         CALL localizer_dbcsr_release(h)
+         CALL localizer_dbcsr_release(s)
+      END DO
+      sizes = bs
+      ! Each Bloch metric is well conditioned, but their union has an unacceptable ratio.
+      hdense = 0.0_dp
+      sdense = 0.0_dp
+      DO row = 1, n
+         hdense(row, row) = 1.0_dp
+         sdense(row, row) = 0.5_dp*(1.0_dp + 1.e-12_dp)
+         rnext = 1 + MODULO(row - 1 + n/2, n)
+         sdense(row, rnext) = 0.5_dp*(1.0_dp - 1.e-12_dp)
+      END DO
+      CALL make_operator(hdense, h)
+      CALL make_operator(sdense, s)
+      CALL localizer_flatten_bloch(h, s, [2, 1, 1], 1, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                   para_env, flat, bloch_gap, metric_ratio, residuals, status)
+      IF (status /= -2) CPABORT('Global Bloch metric bound failed')
+      CALL localizer_flatten_bloch(h, s, [0, 1, 1], 1, 0.0_dp, scale, 1.e-9_dp, 1.e-10_dp, 1.e-8_dp, &
+                                   para_env, flat, bloch_gap, metric_ratio, residuals, status)
+      IF (status /= -1) CPABORT('Invalid Bloch grid accepted')
+      CALL localizer_dbcsr_release(h)
+      CALL localizer_dbcsr_release(s)
+      IF (io > 0) WRITE (io, '(A,ES14.5)') 'Seven Bloch flattening pencils; maximum error: ', bloch_error
+   END SUBROUTINE check_bloch
+
+! **************************************************************************************************
+!> \brief Insert only locally owned dense-reference blocks.
+!> \param dense Reference matrix
+!> \param matrix New complex DBCSR operator
+! **************************************************************************************************
+   SUBROUTINE make_operator(dense, matrix)
+      COMPLEX(dp), INTENT(IN)                            :: dense(:, :)
+      TYPE(localizer_matrix_type), INTENT(OUT)           :: matrix
+
+      INTEGER                                            :: col, first, last, left, right, row
+
+      CALL dbcsr_create(matrix%real_part, 'FLATTEN REAL', distribution, dbcsr_type_no_symmetry, sizes, sizes)
+      CALL dbcsr_create(matrix%imaginary_part, template=matrix%real_part)
+      DO row = 1, nb
+         first = SUM(sizes(:row - 1)) + 1
+         last = SUM(sizes(:row))
+         DO col = 1, nb
+            IF (process_grid(row_dist(row), col_dist(col)) /= para_env%mepos) CYCLE
+            left = SUM(sizes(:col - 1)) + 1
+            right = SUM(sizes(:col))
+            CALL dbcsr_put_block(matrix%real_part, row, col, REAL(dense(first:last, left:right), dp))
+            CALL dbcsr_put_block(matrix%imaginary_part, row, col, AIMAG(dense(first:last, left:right)))
+         END DO
+      END DO
+      CALL dbcsr_finalize(matrix%real_part)
+      CALL dbcsr_finalize(matrix%imaginary_part)
+   END SUBROUTINE make_operator
+
+END PROGRAM spectral_localizer_flatten_unittest
