index 0000000000000000000000000000000000000000..3e953ce29ee9f1d0f93378ea0635b37bd1d007e5
--- /dev/null
+++ b/tests/QS/regtest-gamma-frozen-density/helium-common.inc
@@ -0,0 +1,71 @@
+&GLOBAL
+  PROJECT frozen-density
+  PRINT_LEVEL LOW
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME POTENTIAL_UZH
+    @IF ${SCF_K} == T
+      &KPOINTS
+        SCHEME GAMMA
+        SYMMETRY F
+        WAVEFUNCTIONS COMPLEX
+      &END KPOINTS
+    @ENDIF
+    &QS
+      METHOD ${QS_METHOD}
+      EPS_DEFAULT 1.0E-12
+      EPS_PGF_ORB 1.0E-12
+      EPS_PPNL 1.0E-14
+    &END QS
+    &MGRID
+      CUTOFF 300
+      NGRIDS 1
+    &END MGRID
+    &SCF
+      EPS_SCF 1.0E-11
+      MAX_SCF 100
+      &DIAGONALIZATION
+      &END DIAGONALIZATION
+      &MIXING
+        METHOD BROYDEN_MIXING
+        ALPHA 0.3
+      &END MIXING
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL ${FUNCTIONAL}
+      &END XC_FUNCTIONAL
+      &XC_GRID
+        USE_FINER_GRID F
+        XC_DERIV PW
+      &END XC_GRID
+    &END XC
+    &PRINT
+      &BAND_STRUCTURE
+        ADDED_MOS 10
+        &KPOINT_SET
+          SPECIAL_POINT 0.0 0.0 0.0
+          SPECIAL_POINT 0.0 0.0 0.0
+          NPOINTS 1
+        &END KPOINT_SET
+      &END BAND_STRUCTURE
+    &END PRINT
+  &END DFT
+  &SUBSYS
+    &CELL
+      ABC 5 5 5
+      PERIODIC XYZ
+    &END CELL
+    &COORD
+      He 2.0 2.0 2.0
+      He 2.9 2.1 2.2
+    &END COORD
+    &KIND He
+      BASIS_SET TZVP-MOLOPT-GGA-GTH-q2
+      POTENTIAL GTH-PBE-q2
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
diff --git a/tests/QS/regtest-kubo-hall/TEST_FILES.toml b/tests/QS/regtest-kubo-hall/TEST_FILES.toml
new file mode 100644
index 0000000000000000000000000000000000000000..7ad82bc8d8944961b4feca93d012ce6da8540e4a
--- /dev/null
+++ b/tests/QS/regtest-kubo-hall/TEST_FILES.toml
@@ -0,0 +1,18 @@
+# Time-reversal-invariant SOC Hamiltonians must not acquire a charge Hall response.
+# Nonzero Hall signs and Chern limits are covered by kubo_hall_unittest.
+# Hall tolerances are absolute S/m, below 1e-10 of the dissipative response.
+"projected-gpw.inp" = [{matcher="Kubo_hall_max", tol=1e-9, ref=0.0}]
+"projected-gapw.inp" = [{matcher="Kubo_hall_max", tol=1e-9, ref=0.0}]
+"bloch-full.inp" = [{matcher="Kubo_hall_max", tol=1e-9, ref=0.0},
+                    {matcher="Kubo_sigma_iso", tol=2e-6, ref=1.07057468e-1}]
+"bloch-k290.inp" = [{matcher="Kubo_hall_max", tol=1e-9, ref=0.0},
+                    {matcher="Kubo_sigma_iso", tol=2e-6, ref=1.07057468e-1},
+                    {matcher="Kubo_symmetry_points", tol=0.0, ref=4}]
+"bloch-gapw.inp" = [{matcher="Kubo_hall_max", tol=1e-9, ref=0.0},
+                    {matcher="Kubo_symmetry_points", tol=0.0, ref=4}]
+# Sheet Hall units are S; a strictly 1D projected tensor has no Hall component.
+"bloch-sheet.inp" = [{matcher="Kubo_hall_max", tol=1e-18, ref=0.0},
+                     {matcher="Kubo_sigma_iso_2d", tol=2e-6, ref=6.42389197e-9}]
+"bloch-chain.inp" = [{matcher="Kubo_hall_max", tol=0.0, ref=0.0},
+                     {matcher="Kubo_sigma_iso_1d", tol=2e-6, ref=3.85441018e-18}]
+#EOF
