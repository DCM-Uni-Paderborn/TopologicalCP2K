+PROGRAM topology_reciprocal_unittest
+   USE ieee_arithmetic, ONLY: ieee_value, ieee_quiet_nan
+   USE kinds, ONLY: dp, int_8
+   USE mathlib, ONLY: inv_3x3
+   USE topology_reciprocal, ONLY: reciprocal_stratum_type, reciprocal_strata, &
+                                  reciprocal_sampling_type, reciprocal_sampling, reciprocal_refine
+   USE topology_little_group, ONLY: little_group_factor_system
+   USE topology_integer_lattice, ONLY: integer_lattice_type, integer_lattice_factor, integer_lattice_certificate
+   USE topology_atomic_signatures, ONLY: atomic_signature_type, atomic_signature_construct, atomic_signature_star_map
+   USE topology_star_transport, ONLY: star_operation
+   USE topology_compatibility_lattice, ONLY: compatibility_lattice_type, compatibility_lattice_construct
+   USE topology_integer_lattice, ONLY: integer_quotient_class
+   USE topology_compatibility, ONLY: little_group_edge_type, little_group_compatibility
+#if defined(__SPGLIB)
+   USE iso_c_binding, ONLY: c_int, c_double
+#endif
+   IMPLICIT NONE
+   CHARACTER(LEN=256) :: argument
+   INTEGER :: iarg
+   LOGICAL :: all_settings
+#if defined(__SPGLIB)
+   INTERFACE
+      FUNCTION spg_get_symmetry_from_database(rotations, translations, hall) RESULT(nsym) BIND(C)
+         IMPORT :: c_int, c_double
+         INTEGER(c_int), INTENT(OUT) :: rotations(3, 3, 192)
+         REAL(c_double), INTENT(OUT) :: translations(3, 192)
+         INTEGER(c_int), VALUE, INTENT(IN) :: hall
+         INTEGER(c_int) :: nsym
+      END FUNCTION spg_get_symmetry_from_database
+   END INTERFACE
+#endif
+   all_settings = .FALSE.
+   DO iarg = 1, COMMAND_ARGUMENT_COUNT()
+      CALL GET_COMMAND_ARGUMENT(iarg, argument)
+      IF (argument == '--all-settings') THEN
+         all_settings = .TRUE.
+      ELSE IF (argument(:1) == '-') THEN
+         ERROR STOP 'Unknown reciprocal-strata test option'
+      END IF
+   END DO
+   CALL analytic_tests()
+   CALL refinement_tests()
+   CALL star_analytic_tests()
