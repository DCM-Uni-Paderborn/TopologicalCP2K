index 0000000000000000000000000000000000000000..0026e5320198ee0023b9d48092a2032a0b425fb0
--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer/TEST_FILES.toml
@@ -0,0 +1,57 @@
+# Finite AO positions, GPW/GAPW, scans and Kubo coexistence.
+"kubo-projected-gpw.inp" = [{matcher="Kubo_sigma_iso", tol=2e-6, ref=5.02019468e-1}]
+"kubo-projected-gapw.inp" = [{matcher="Kubo_sigma_iso", tol=2e-6, ref=5.02109726e-1}]
+"kubo-projected-uks.inp" = [{matcher="Kubo_sigma_iso", tol=2e-6, ref=5.02019468e-1}]
+"h2-gpw.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                {matcher="LOCALIZER_GAP", tol=2e-6, ref=4.32887629475349e-3},
+                {matcher="Kubo_sigma_iso", tol=2e-6, ref=2.28714501e-1}]
+"h2-gapw.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                 {matcher="LOCALIZER_GAP", tol=2e-6, ref=4.33424780376943e-3}]
+"h2-all-electron.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                         {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.06186032815457e-3}]
+"h2-unresolved.inp" = [{matcher="LOCALIZER_UNRESOLVED", tol=0, ref=1}]
+# Physical spinful TR with GTH SOC, not an inversion-parity shortcut.
+"neon-soc.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                  {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.80754534002269e-1},
+                  {matcher="Kubo_sigma_iso", tol=2e-6, ref=1.05255090e-1}]
+"bismuth-soc.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                     {matcher="LOCALIZER_GAP", tol=2e-6, ref=6.81101299873304e-2},
+                     {matcher="Kubo_sigma_iso", tol=2e-6, ref=1.41028628e1}]
+# One-image k-point SOC must retain offsite blocks on the neighbour-list MPI owners.
+# References independently diagonalized from the printed finite AO H, S and SOC.
+"soc-export-gpw.inp" = [{matcher="TOPOLOGY_INDIRECT_GAP", tol=2e-6, ref=1.05772662796903}]
+"soc-export-gapw.inp" = [{matcher="TOPOLOGY_INDIRECT_GAP", tol=2e-6, ref=1.05772662796903}]
+# Periodic Berry-integral torus, spinor SOC, cell-plane permutation and cell-vector origin shift.
+"periodic-xz.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                     {matcher="LOCALIZER_GAP", tol=2e-6, ref=6.61776847639247e-2}]
+"periodic-xy-shift.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                           {matcher="LOCALIZER_GAP", tol=2e-6, ref=6.61776847639247e-2}]
+"periodic-yz-gapw.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                          {matcher="LOCALIZER_GAP", tol=2e-6, ref=6.65284047966709e-2}]
+"periodic-displaced.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                            {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.07852346273944e-1}]
+"torus-kpoints.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                       {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.80937263188252e-1}]
+"torus-reduced.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                       {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.80937263188252e-1}]
+"torus-shifted.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                       {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.80937263188252e-1}]
+# Independent SCFs at modest plane-wave cutoff need not have identical potentials.
+# Separate PBE convergence runs at 800/2000 Ry compare supercell and explicit mesh.
+"torus-supercell.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                         {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.80956383610632e-1}]
+"torus-gamma-potential.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                              {matcher="LOCALIZER_GAP", tol=2e-6, ref=3.81033305146695e-1}]
+# All 52 spinor bands and full neighbour overlaps independently reproduce this small torus.
+"stanene-soc.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                     {matcher="LOCALIZER_GAP", tol=2e-6, ref=9.66375577896045e-4}]
+# All-band exact-sign Bloch reference; coordinate overlaps are not unitarized.
+"stanene-flattened.inp" = [{matcher="LOCALIZER_Z2", tol=0, ref=0},
+                           {matcher="LOCALIZER_GAP", tol=2e-6, ref=5.94648185248214e-1}]
+# Spectral-sign references formed independently from exported H, S and AO positions.
+"h2-flattened-gpw.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                         {matcher="LOCALIZER_GAP", tol=2e-6, ref=8.33447166247184e-1}]
+"h2-flattened-gapw.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                          {matcher="LOCALIZER_GAP", tol=2e-6, ref=8.33459503672673e-1}]
+"h2-flattened-ae.inp" = [{matcher="LOCALIZER_CHERN", tol=0, ref=0},
+                        {matcher="LOCALIZER_GAP", tol=2e-6, ref=8.44626330848677e-1}]
diff --git a/tests/QS/regtest-spectral-localizer/bismuth-common.inc b/tests/QS/regtest-spectral-localizer/bismuth-common.inc
