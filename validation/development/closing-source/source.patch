index 0000000000000000000000000000000000000000..195f2f7031094c144a009a3475a946412ad14829
--- /dev/null
+++ b/tests/QS/regtest-spectral-localizer/torus-common.inc
@@ -0,0 +1,81 @@
+&GLOBAL
+  PRINT_LEVEL LOW
+  PROJECT torus-localizer
+  RUN_TYPE ENERGY
+&END GLOBAL
+&FORCE_EVAL
+  METHOD QUICKSTEP
+  &DFT
+    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
+    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
+    &QS
+      METHOD GPW
+      EPS_DEFAULT 1.0E-12
+      EPS_PPNL 1.0E-14
+    &END QS
+    &MGRID
+      CUTOFF ${TORUS_CUTOFF}
+      NGRIDS 1
+      REL_CUTOFF 40
+    &END MGRID
+    &POISSON
+      PERIODIC XZ
+      POISSON_SOLVER ANALYTIC
+    &END POISSON
+    @IF ${SCF_K} == T
+      &KPOINTS
+        SCHEME MONKHORST-PACK 3 1 2
+        GAMMA_CENTERED T
+        WAVEFUNCTIONS COMPLEX
+        SYMMETRY ${SCF_SYMMETRY}
+        INVERSION_SYMMETRY_ONLY T
+      &END KPOINTS
+    @ENDIF
+    &SCF
+      EPS_SCF 1.0E-10
+      MAX_SCF 80
+      SCF_GUESS ATOMIC
+      &DIAGONALIZATION
+      &END DIAGONALIZATION
+      &MIXING
+        METHOD BROYDEN_MIXING
+        ALPHA 0.4
+      &END MIXING
+    &END SCF
+    &XC
+      &XC_FUNCTIONAL ${TORUS_XC}
+      &END XC_FUNCTIONAL
+    &END XC
+  &END DFT
+  &PROPERTIES
+    &SPECTRAL_LOCALIZER ON
+      FORMULATION PERIODIC
+      MP_GRID ${TORUS_GRID}
+      SOLVER ${TORUS_SOLVER}
+      INVARIANT ${TORUS_INDEX}
+      SOC T
+      TIME_REVERSAL T
+      PLANE XZ
+      POSITION [angstrom] ${TORUS_ORIGIN}
+      ENERGY [hartree] -0.1
+      ETA [hartree] 0.5
+    &END SPECTRAL_LOCALIZER
+  &END PROPERTIES
+  &SUBSYS
+    &CELL
+      ABC 6.0 6.0 6.0
+      PERIODIC XZ
+      MULTIPLE_UNIT_CELL ${SUPER_CELL}
+    &END CELL
+    &TOPOLOGY
+      MULTIPLE_UNIT_CELL ${SUPER_CELL}
+    &END TOPOLOGY
+    &COORD
+      Ne 3.0 3.0 3.0
+    &END COORD
+    &KIND Ne
+      BASIS_SET DZVP-MOLOPT-GGA-GTH-q8
+      POTENTIAL GTH-PBE-q8
+    &END KIND
+  &END SUBSYS
+&END FORCE_EVAL
