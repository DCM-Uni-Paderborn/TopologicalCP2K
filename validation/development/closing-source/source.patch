+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Metric-aware Bloch velocities without eigenvector derivatives or band-gap divisions.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE kubo_bloch
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE kinds,                           ONLY: dp
+   USE kubo_projected,                  ONLY: projected_eigensystem
+
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: bloch_current, bloch_current_from_frame, fermi_slope
+CONTAINS
+! **************************************************************************************************
+!> \brief Evaluate v_nm = C^H(dH - E_n*dS)C + i*(E_n-E_m)*C^H*D*C.
+!> \param h Full covariant Hamiltonian, including SOC when applicable
+!> \param s Overlap in the same Bloch convention
+!> \param dh Cartesian k derivatives of h, in Ha*bohr
+!> \param ds Cartesian k derivatives of s, in bohr
+!> \param d Cell-gauge image first moments, satisfying D-D^H=-i*dS, in bohr
+!> \param energies Generalized spectrum
+!> \param current Anti-Hermitian current -i*v in the eigenbasis, including diagonal velocities
+!> \param status 0 success; -1 invalid data; -2 metric failure; -3 connection failure; positive LAPACK failure
+!> \param coefficients Optional complete eigenframe for symmetry reconstruction
+!> \note For a general k-dependent basis D transforms as B^H*D*B-i*(dB)^H*S*B.
+!>       The connection terms are essential even when the spectrum is accurately reproduced.
+! **************************************************************************************************
+   SUBROUTINE bloch_current(h, s, dh, ds, d, energies, current, status, coefficients)
+      COMPLEX(dp), INTENT(IN)                            :: h(:, :), s(:, :), dh(:, :, :), &
+                                                            ds(:, :, :), d(:, :, :)
+      REAL(dp), INTENT(OUT)                              :: energies(:)
+      COMPLEX(dp), INTENT(OUT)                           :: current(:, :, :)
+      INTEGER, INTENT(OUT)                               :: status
+      COMPLEX(dp), INTENT(OUT), OPTIONAL                 :: coefficients(:, :)
+
+      COMPLEX(dp), ALLOCATABLE                           :: c(:, :)
+      INTEGER                                            :: n
+      REAL(dp)                                           :: residuals(2)
+
+      n = SIZE(h, 1)
+      status = -1
+      energies = 0.0_dp
+      current = 0.0_dp
+      IF (PRESENT(coefficients)) THEN
+         coefficients = 0.0_dp
+         IF (ANY(SHAPE(coefficients) /= [n, n])) RETURN
+      END IF
+      ALLOCATE (c(n, n))
+      CALL projected_eigensystem(h, s, energies, c, status)
+      IF (status /= 0) RETURN
+      CALL bloch_current_from_frame(h, s, dh, ds, d, energies, c, current, 1.e-8_dp, residuals, status)
+      IF (status == 0 .AND. PRESENT(coefficients)) coefficients = c
+   END SUBROUTINE bloch_current
+! **************************************************************************************************
+!> \brief Evaluate the current in a validated reconstructed eigenframe, without rediagonalization.
+!> \param h Target Hamiltonian
+!> \param s Target AO metric
+!> \param dh Cartesian Hamiltonian derivatives
+!> \param ds Cartesian overlap derivatives
+!> \param d Cell-gauge image first moments
+!> \param energies Source spectrum, including complete degenerate blocks
+!> \param c Candidate target eigenframe
+!> \param current Target current in exactly the supplied gauge
+!> \param tolerance Maximum orthonormality and relative projected-eigenproblem errors
+!> \param residuals Metric error and energy-scaled projected-Hamiltonian error
+!> \param status 0 success; -1 invalid data; -3 connection failure; -4 invalid eigenframe
+! **************************************************************************************************
+   SUBROUTINE bloch_current_from_frame(h, s, dh, ds, d, energies, c, current, tolerance, residuals, status)
+      COMPLEX(dp), INTENT(IN)                            :: h(:, :), s(:, :), dh(:, :, :), &
+                                                            ds(:, :, :), d(:, :, :)
+      REAL(dp), INTENT(IN)                               :: energies(:)
+      COMPLEX(dp), INTENT(IN)                            :: c(:, :)
+      COMPLEX(dp), INTENT(OUT)                           :: current(:, :, :)
+      REAL(dp), INTENT(IN)                               :: tolerance
+      REAL(dp), INTENT(OUT)                              :: residuals(2)
+      INTEGER, INTENT(OUT)                               :: status
+
+      COMPLEX(dp), PARAMETER                             :: iu = (0.0_dp, 1.0_dp)
+
+      COMPLEX(dp), ALLOCATABLE                           :: dc(:, :), hc(:, :), sc(:, :), v(:, :)
+      INTEGER                                            :: axis, i, j, n
+      REAL(dp)                                           :: scale
+
+      status = -1
+      current = 0.0_dp
+      residuals = HUGE(1.0_dp)
+      n = SIZE(h, 1)
+      IF (n < 1 .OR. ANY(SHAPE(h) /= [n, n]) .OR. ANY(SHAPE(s) /= [n, n])) RETURN
+      IF (SIZE(energies) /= n .OR. ANY(SHAPE(current) /= [n, n, 3])) RETURN
+      IF (ANY(SHAPE(dh) /= [n, n, 3]) .OR. ANY(SHAPE(ds) /= [n, n, 3])) RETURN
+      IF (ANY(SHAPE(d) /= [n, n, 3])) RETURN
+      IF (ANY(SHAPE(c) /= [n, n])) RETURN
+      IF (.NOT. ieee_is_finite(tolerance) .OR. tolerance <= 0.0_dp .OR. tolerance >= 1.0_dp) RETURN
+      IF (.NOT. ALL(ieee_is_finite(energies))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(c, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(c)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(h, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(h)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(s, dp))) .OR. .NOT. ALL(ieee_is_finite(AIMAG(s)))) RETURN
+      IF (MAXVAL(ABS(h - CONJG(TRANSPOSE(h)))) > 1.e-9_dp*MAX(1.0_dp, MAXVAL(ABS(h)))) RETURN
+      IF (MAXVAL(ABS(s - CONJG(TRANSPOSE(s)))) > 1.e-9_dp*MAX(1.0_dp, MAXVAL(ABS(s)))) RETURN
+      IF (.NOT. finite(dh) .OR. .NOT. finite(ds) .OR. .NOT. finite(d)) RETURN
+      DO axis = 1, 3
+         scale = MAX(TINY(1.0_dp), MAXVAL(ABS(dh(:, :, axis))))
+         IF (MAXVAL(ABS(dh(:, :, axis) - CONJG(TRANSPOSE(dh(:, :, axis))))) > 1.e-9_dp*scale) RETURN
+         scale = MAX(TINY(1.0_dp), MAXVAL(ABS(ds(:, :, axis))))
+         IF (MAXVAL(ABS(ds(:, :, axis) - CONJG(TRANSPOSE(ds(:, :, axis))))) > 1.e-9_dp*scale) RETURN
+         status = -3
+         scale = MAX(1.0_dp, MAXVAL(ABS(ds(:, :, axis))), MAXVAL(ABS(d(:, :, axis))))
+         IF (MAXVAL(ABS(d(:, :, axis) - CONJG(TRANSPOSE(d(:, :, axis))) + iu*ds(:, :, axis))) &
+             > 1.e-9_dp*scale) RETURN
+         status = -1
+      END DO
+      ALLOCATE (hc(n, n), sc(n, n), dc(n, n), v(n, n))
+      sc = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(s, c))
+      hc = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(h, c))
+      DO i = 1, n
+         sc(i, i) = sc(i, i) - 1.0_dp
+         hc(i, i) = hc(i, i) - energies(i)
+      END DO
+      residuals = [MAXVAL(ABS(sc)), MAXVAL(ABS(hc))/MAX(1.0_dp, MAXVAL(ABS(energies)))]
+      status = -4
+      IF (.NOT. ALL(ieee_is_finite(residuals)) .OR. MAXVAL(residuals) > tolerance) RETURN
+      status = -1
+      DO axis = 1, 3
+         hc = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(dh(:, :, axis), c))
+         sc = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(ds(:, :, axis), c))
+         dc = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(d(:, :, axis), c))
+         DO j = 1, n
+            DO i = 1, n
+               v(i, j) = hc(i, j) - energies(i)*sc(i, j) + iu*(energies(i) - energies(j))*dc(i, j)
+            END DO
+         END DO
+         current(:, :, axis) = -iu*v
+      END DO
+      IF (.NOT. finite(current)) RETURN
+      status = 0
+   END SUBROUTINE bloch_current_from_frame
+! **************************************************************************************************
+!> \brief Finite check on all components, including connection matrices which are not Hermitian.
+!> \param a Matrix triplet
+!> \return Whether all entries are finite
+! **************************************************************************************************
+   LOGICAL FUNCTION finite(a)
+      COMPLEX(dp), INTENT(IN)                            :: a(:, :, :)
+
+      finite = ALL(ieee_is_finite(REAL(a, dp))) .AND. ALL(ieee_is_finite(AIMAG(a)))
+   END FUNCTION finite
+! **************************************************************************************************
+!> \brief Stable Fermi divided difference including the intraband and degenerate limits.
+!> \param ea First energy
+!> \param eb Second energy
+!> \param mu Chemical potential
+!> \param kt Positive temperature in energy units
+!> \return (f(ea)-f(eb))/(ea-eb) for unit occupation, nonpositive
+! **************************************************************************************************
+   PURE REAL(dp) FUNCTION fermi_slope(ea, eb, mu, kt) RESULT(slope)
+      REAL(dp), INTENT(IN) :: ea, eb, mu, kt
+      REAL(dp) :: delta, f
+
+      delta = ea - eb
+      IF (ABS(delta) < 1.e-4_dp*kt) THEN
+         f = occupation((ea + eb)*0.5_dp)
+         slope = -f*(1.0_dp - f)/kt*(1.0_dp + (delta/kt)**2*(1.0_dp - 6*f + 6*f*f)/24.0_dp)
+      ELSE
+         slope = (occupation(ea) - occupation(eb))/delta
+      END IF
+   CONTAINS
+! **************************************************************************************************
+!> \brief Stable logistic occupation.
+!> \param e Energy
+!> \return Unit-occupation Fermi function
+! **************************************************************************************************
+      PURE REAL(dp) FUNCTION occupation(e) RESULT(f)
+      REAL(dp), INTENT(IN)                               :: e
+
+      REAL(dp)                                           :: x
+
+         x = EXP(-ABS((e - mu)/kt))
+         f = x/(1 + x)
+         IF (e < mu) f = 1.0_dp - f
+      END FUNCTION occupation
+   END FUNCTION fermi_slope
+END MODULE kubo_bloch
diff --git a/src/kubo_bloch_unittest.F b/src/kubo_bloch_unittest.F
new file mode 100644
index 0000000000000000000000000000000000000000..0480cdd1f26ecc849360c044f8d2fbdf899389b4
--- /dev/null
+++ b/src/kubo_bloch_unittest.F
@@ -0,0 +1,121 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+PROGRAM kubo_bloch_unittest
+   USE kinds,                           ONLY: dp
+   USE kubo_bloch,                      ONLY: bloch_current,&
+                                              bloch_current_from_frame,&
+                                              fermi_slope
+   USE kubo_projected,                  ONLY: projected_current
+
+   IMPLICIT NONE
+   COMPLEX(dp), PARAMETER :: iu = (0.0_dp, 1.0_dp)
+   COMPLEX(dp) :: h(2, 2), s(2, 2), dh(2, 2, 3), ds(2, 2, 3), d(2, 2, 3)
+   COMPLEX(dp) :: b(2, 2), db(2, 2), h2(2, 2), s2(2, 2), dh2(2, 2, 3), ds2(2, 2, 3), d2(2, 2, 3)
+   COMPLEX(dp) :: j(2, 2, 3), j2(2, 2, 3), expected(2, 2), frame(2, 2)
+   REAL(dp) :: residuals(2)
+   REAL(dp) :: e(2), e2(2), k, root, speed, strength, strength2, shift
+   INTEGER :: i, status, ik
+
+   s = 0.0_dp
+   s(1, 1) = 1.0_dp
+   s(2, 2) = 1.0_dp
+   DO ik = -7, 7
+      k = REAL(ik, dp)/5
+      h = k*k*s
+      h(1, 1) = h(1, 1) + 0.3_dp
+      h(2, 2) = h(2, 2) - 0.3_dp
+      h(1, 2) = 0.4_dp*SIN(k) - iu*0.2_dp*COS(k)
+      h(2, 1) = CONJG(h(1, 2))
+      dh = 0.0_dp
+      dh(:, :, 1) = 2*k*s
+      dh(1, 2, 1) = 0.4_dp*COS(k) + iu*0.2_dp*SIN(k)
+      dh(2, 1, 1) = CONJG(dh(1, 2, 1))
+      ds = 0.0_dp
+      d = 0.0_dp
+      CALL bloch_current(h, s, dh, ds, d, e, j, status, frame)
+      IF (status /= 0) ERROR STOP 'Bloch current failed'
+      CALL bloch_current_from_frame(h, s, dh, ds, d, e, frame, j2, 1.e-9_dp, residuals, status)
+      IF (status /= 0 .OR. MAXVAL(ABS(j2 - j)) > 1.e-12_dp) ERROR STOP 'Reused eigenframe failed'
+      CALL bloch_current_from_frame(h, s, dh, ds, d, e + 0.1_dp, frame, j2, 1.e-9_dp, residuals, status)
+      IF (status /= -4) ERROR STOP 'Wrong frame eigenvalues accepted'
+      CALL bloch_current_from_frame(h, s, dh, ds, d, e, 1.1_dp*frame, j2, 1.e-9_dp, residuals, status)
+      IF (status /= -4) ERROR STOP 'Nonorthonormal frame accepted'
+      root = SQRT(0.09_dp + 0.16_dp*SIN(k)**2 + 0.04_dp*COS(k)**2)
+      IF (MAXVAL(ABS(e - [k*k - root, k*k + root])) > 1.e-12_dp) ERROR STOP 'Analytic bands failed'
+      speed = 0.12_dp*SIN(k)*COS(k)/root
+      IF (ABS(iu*j(1, 1, 1) - (2*k - speed)) > 1.e-12_dp) ERROR STOP 'Lower band velocity failed'
+      IF (ABS(iu*j(2, 2, 1) - (2*k + speed)) > 1.e-12_dp) ERROR STOP 'Upper band velocity failed'
+      IF (MAXVAL(ABS(j(:, :, 1) + CONJG(TRANSPOSE(j(:, :, 1))))) > 1.e-12_dp) THEN
+         ERROR STOP 'Bloch current not anti-Hermitian'
+      END IF
+
+      ! A k-dependent nonunitary AO change requires both overlap and connection derivatives.
+      db = 0.0_dp
+      db(1, 1) = 0.13_dp
+      db(2, 1) = CMPLX(0.17_dp, 0.23_dp, dp)
+      db(1, 2) = CMPLX(-0.09_dp, 0.11_dp, dp)
+      b = s + k*db
+      h2 = MATMUL(CONJG(TRANSPOSE(b)), MATMUL(h, b))
+      s2 = MATMUL(CONJG(TRANSPOSE(b)), b)
+      dh2 = 0.0_dp
+      ds2 = 0.0_dp
+      d2 = 0.0_dp
+      dh2(:, :, 1) = MATMUL(CONJG(TRANSPOSE(b)), MATMUL(dh(:, :, 1), b)) + &
+                     MATMUL(CONJG(TRANSPOSE(db)), MATMUL(h, b)) + MATMUL(CONJG(TRANSPOSE(b)), MATMUL(h, db))
+      ds2(:, :, 1) = MATMUL(CONJG(TRANSPOSE(db)), b) + MATMUL(CONJG(TRANSPOSE(b)), db)
+      d2(:, :, 1) = -iu*MATMUL(CONJG(TRANSPOSE(db)), b) + 7*s2
+      CALL bloch_current(h2, s2, dh2, ds2, d2, e2, j2, status)
+      IF (status /= 0 .OR. MAXVAL(ABS(e - e2)) > 1.e-12_dp) ERROR STOP 'Bloch basis covariance failed'
+      DO i = 1, 2
+         IF (ABS(j(i, i, 1) - j2(i, i, 1)) > 1.e-11_dp) ERROR STOP 'Band velocity basis dependence'
+      END DO
+      IF (MAXVAL(ABS(ABS(j) - ABS(j2))) > 1.e-11_dp) ERROR STOP 'Interband velocity gauge dependence'
+      ! An energy-zero shift must include the k derivative of the metric.
+      shift = 4.2_dp
+      CALL bloch_current(h2 + shift*s2, s2, dh2 + shift*ds2, ds2, d2, e2, j2, status)
+      IF (status /= 0 .OR. MAXVAL(ABS(e + shift - e2)) > 1.e-11_dp) ERROR STOP 'Energy shift failed'
+      IF (MAXVAL(ABS(ABS(j) - ABS(j2))) > 1.e-10_dp) ERROR STOP 'Velocity energy-zero dependence'
+      d2(:, :, 1) = 0.0_dp
+      CALL bloch_current(h2, s2, dh2, ds2, d2, e2, j2, status)
+      IF (status /= -3) ERROR STOP 'Inconsistent connection accepted'
+   END DO
+
+   dh = 0.0_dp
+   ds = 0.0_dp
+   d = 0.0_dp
+   d(1, 2, 1) = iu
+   d(2, 1, 1) = -iu
+   CALL bloch_current(h, s, dh, ds, d, e, j, status)
+   IF (status /= 0) ERROR STOP 'Finite Bloch limit failed'
+   CALL projected_current(h, s, d, e2, j2, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(j - j2)) > 1.e-12_dp) ERROR STOP 'Finite commutator limit failed'
+
+   ! Every matrix element within an exactly degenerate block has the same Fermi weight.
+   h = 0.0_dp
+   dh = 0.0_dp
+   d = 0.0_dp
+   dh(:, :, 1) = s
+   dh(1, 2, 1) = iu
+   dh(2, 1, 1) = -iu
+   CALL bloch_current(h, s, dh, ds, d, e, j, status)
+   IF (status /= 0) ERROR STOP 'Degenerate Bloch block failed'
+   strength = SUM(ABS(j(:, :, 1))**2)*(-fermi_slope(0.0_dp, 0.0_dp, 0.0_dp, 0.1_dp))
+   IF (ABS(strength - 10.0_dp) > 1.e-12_dp) ERROR STOP 'Intraband Drude weight failed'
+   b = RESHAPE([iu, (1.0_dp, 0.0_dp), (1.0_dp, 0.0_dp), iu], [2, 2])/SQRT(2.0_dp)
+   expected = MATMUL(CONJG(TRANSPOSE(b)), MATMUL(dh(:, :, 1), b))
+   dh(:, :, 1) = expected
+   CALL bloch_current(h, s, dh, ds, d, e, j, status)
+   strength2 = SUM(ABS(j(:, :, 1))**2)*(-fermi_slope(0.0_dp, 0.0_dp, 0.0_dp, 0.1_dp))
+   IF (status /= 0 .OR. ABS(strength - strength2) > 1.e-12_dp) ERROR STOP 'Degenerate response gauge failed'
+   IF (ABS(fermi_slope(1.e-9_dp, -1.e-9_dp, 0.0_dp, 0.1_dp) + 2.5_dp) > 1.e-12_dp) THEN
+      ERROR STOP 'Fermi near-degeneracy limit failed'
+   END IF
+   IF (ABS(fermi_slope(0.1_dp, -0.1_dp, 0.0_dp, 0.1_dp) + TANH(0.5_dp)/0.2_dp) > 1.e-12_dp) THEN
+      ERROR STOP 'Fermi divided difference failed'
+   END IF
+   PRINT *, 'Bloch metric/connection, band velocity, gauge, degeneracy and Drude tests passed.'
+END PROGRAM kubo_bloch_unittest
diff --git a/src/kubo_hall.F b/src/kubo_hall.F
new file mode 100644
index 0000000000000000000000000000000000000000..9569ca78a86aef3bd45f4863540765add0a45dd2
--- /dev/null
+++ b/src/kubo_hall.F
@@ -0,0 +1,78 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Antisymmetric DC charge response with a scalar relaxation rate.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE kubo_hall
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE kinds,                           ONLY: dp
+   USE kubo_bloch,                      ONLY: fermi_slope
+
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: hall_response
+CONTAINS
+! **************************************************************************************************
+!> \brief Hall tensor, with first index the current and second index the electric field.
+!> \param energies Complete eigenvalue list for one spin channel and k point
+!> \param current Anti-Hermitian -i*hbar*v matrix triplet, in exactly the same eigenframe
+!> \param mu Chemical potential
+!> \param kt Positive temperature in energy units
+!> \param gamma Positive relaxation rate in energy units
+!> \param hall Antisymmetric tensor before e^2/hbar, volume, spin and k weights
+!> \param status Zero on success; negative for invalid input or nonfinite arithmetic
+!> \note The trace uses (gamma+i[H,.])^-1. Pairing n,m gives
+!>       2*f[en,em]*(en-em)*Im[J_a(m,n)*J_b(n,m)]/(gamma^2+(en-em)^2).
+!>       Equal-energy blocks contribute zero without a band-gap division.
+! **************************************************************************************************
+   SUBROUTINE hall_response(energies, current, mu, kt, gamma, hall, status)
+      REAL(dp), INTENT(IN)                               :: energies(:)
+      COMPLEX(dp), INTENT(IN)                            :: current(:, :, :)
+      REAL(dp), INTENT(IN)                               :: mu, kt, gamma
+      REAL(dp), INTENT(OUT)                              :: hall(3, 3)
+      INTEGER, INTENT(OUT)                               :: status
+
+      INTEGER                                            :: a, b, m, n, nstate
+      REAL(dp)                                           :: delta, factor, scale, total(3, 3)
+
+      hall = 0.0_dp
+      status = -1
+      nstate = SIZE(energies)
+      IF (nstate < 1 .OR. ANY(SHAPE(current) /= [nstate, nstate, 3])) RETURN
+      IF (.NOT. ALL(ieee_is_finite([mu, kt, gamma]))) RETURN
+      IF (kt <= 0.0_dp .OR. gamma <= 0.0_dp) RETURN
+      IF (.NOT. ALL(ieee_is_finite(energies))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(current, dp))) .OR. &
+          .NOT. ALL(ieee_is_finite(AIMAG(current)))) RETURN
+      DO a = 1, 3
+         scale = MAX(1.0_dp, MAXVAL(ABS(current(:, :, a))))
+         IF (MAXVAL(ABS(current(:, :, a) + CONJG(TRANSPOSE(current(:, :, a))))) > 1.e-9_dp*scale) RETURN
+      END DO
+      total = 0.0_dp
+      DO n = 1, nstate
+         DO m = n + 1, nstate
+            delta = energies(n) - energies(m)
+            IF (.NOT. ieee_is_finite(delta)) RETURN
+            IF (delta == 0.0_dp) CYCLE
+            scale = MAX(gamma, ABS(delta))
+            factor = 2.0_dp*fermi_slope(energies(n), energies(m), mu, kt)* &
+                     (delta/scale)/scale/((gamma/scale)**2 + (delta/scale)**2)
+            IF (.NOT. ieee_is_finite(factor)) RETURN
+            DO b = 2, 3
+               DO a = 1, b - 1
+                  total(a, b) = total(a, b) + factor*AIMAG(current(m, n, a)*current(n, m, b))
+               END DO
+            END DO
+         END DO
+      END DO
+      IF (.NOT. ALL(ieee_is_finite(total))) RETURN
+      hall = total - TRANSPOSE(total)
+      status = 0
+   END SUBROUTINE hall_response
+END MODULE kubo_hall
diff --git a/src/kubo_hall_unittest.F b/src/kubo_hall_unittest.F
new file mode 100644
index 0000000000000000000000000000000000000000..f37ba3226e8bb644f97d52c266449c2f05c9930a
--- /dev/null
+++ b/src/kubo_hall_unittest.F
@@ -0,0 +1,276 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+PROGRAM kubo_hall_unittest
+   USE ieee_arithmetic,                 ONLY: ieee_quiet_nan,&
+                                              ieee_value
+   USE kinds,                           ONLY: dp
+   USE kubo_bloch,                      ONLY: bloch_current,&
+                                              fermi_slope
+   USE kubo_hall,                       ONLY: hall_response
+
+   IMPLICIT NONE
+   COMPLEX(dp), PARAMETER :: iu = (0.0_dp, 1.0_dp)
+   REAL(dp), PARAMETER :: pi = 3.1415926535897932384626433832795_dp
+   REAL(dp) :: energies(4), hall(3, 3), check(3, 3), reference(3, 3), rotation(3, 3)
+   REAL(dp) :: analytic, error, gauge_error, mass, kx, ky, radius, omega, integrated, curvature, gamma
+   REAL(dp) :: e2(2), masses(3), expected(3), unit(3)
+   COMPLEX(dp) :: current(4, 4, 3), changed(4, 4, 3), u(4, 4)
+   COMPLEX(dp) :: h2(2, 2), s2(2, 2), dh2(2, 2, 3), ds2(2, 2, 3), d2(2, 2, 3), j2(2, 2, 3)
+   INTEGER :: a, b, i, j, imass, ix, iy, status
+   INTEGER, PARAMETER :: mesh = 48
+
+   ! A two-level response fixes the sign, occupation factor and relaxation denominator.
+   j2 = 0.0_dp
+   j2(1, 2, 1) = -iu
+   j2(2, 1, 1) = -iu
+   j2(1, 2, 2) = -1.0_dp
+   j2(2, 1, 2) = 1.0_dp
+   CALL hall_response([-0.7_dp, 0.7_dp], j2, 0.0_dp, 0.2_dp, 0.3_dp, hall, status)
+   analytic = 2.0_dp*TANH(0.7_dp/0.4_dp)/(1.4_dp**2 + 0.3_dp**2)
+   IF (status /= 0 .OR. ABS(hall(1, 2) - analytic) > 1.e-13_dp) ERROR STOP 'Two-level Hall sign or scale'
+   IF (MAXVAL(ABS(hall + TRANSPOSE(hall))) /= 0.0_dp) ERROR STOP 'Hall not antisymmetric'
+   CALL hall_response([0.0_dp, 0.0_dp], j2, 0.0_dp, 0.2_dp, 0.3_dp, hall, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall)) /= 0.0_dp) ERROR STOP 'Degenerate Hall block'
+   DO i = 2, 14, 2
+      radius = 10.0_dp**(-i)
+      CALL hall_response([-radius, radius], j2, 0.0_dp, 0.2_dp, 0.3_dp, hall, status)
+      analytic = 2.0_dp*TANH(radius/0.4_dp)/(4*radius**2 + 0.3_dp**2)
+      IF (status /= 0 .OR. ABS(hall(1, 2)/analytic - 1.0_dp) > 1.e-12_dp) THEN
+         ERROR STOP 'Near-degenerate Hall limit'
+      END IF
+   END DO
+
+   energies = [-0.9_dp, -0.9_dp, 0.8_dp, 0.8_dp]
+   DO a = 1, 3
+      DO j = 1, 4
+         DO i = 1, 4
+            current(i, j, a) = CMPLX(SIN(REAL(i + 3*j + a, dp)), COS(REAL(2*i - j + a, dp)), dp)
+         END DO
+      END DO
+      current(:, :, a) = current(:, :, a) - CONJG(TRANSPOSE(current(:, :, a)))
+   END DO
+   CALL hall_response(energies, current, 0.1_dp, 0.15_dp, 0.07_dp, hall, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall)) < 0.1_dp) ERROR STOP 'Nontrivial four-band response'
+   CALL liouville_reference(energies, current, 0.1_dp, 0.15_dp, 0.07_dp, reference)
+   error = MAXVAL(ABS(hall - 0.5_dp*(reference - TRANSPOSE(reference))))
+   IF (error > 2.e-12_dp) ERROR STOP 'Full Liouvillian reference mismatch'
+   PRINT '(A,ES14.6)', 'Hall Liouvillian residual: ', error
+   DO a = 1, 3
+      unit = 0.0_dp
+      unit(a) = 1.0_dp
+      IF (DOT_PRODUCT(unit, MATMUL(reference, unit)) < -1.e-12_dp) ERROR STOP 'Dissipation sign'
+   END DO
+
+   u = 0.0_dp
+   u(1:2, 1:2) = RESHAPE([iu, (1.0_dp, 0.0_dp), (1.0_dp, 0.0_dp), iu], [2, 2])/SQRT(2.0_dp)
+   u(3:4, 3:4) = RESHAPE([(0.6_dp, 0.0_dp), (0.0_dp, 0.8_dp), (0.0_dp, 0.8_dp), &
+                          (0.6_dp, 0.0_dp)], [2, 2])
+   DO a = 1, 3
+      changed(:, :, a) = MATMUL(CONJG(TRANSPOSE(u)), MATMUL(current(:, :, a), u))
+   END DO
+   CALL hall_response(energies, changed, 0.1_dp, 0.15_dp, 0.07_dp, check, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall - check)) > 2.e-12_dp) ERROR STOP 'Degenerate gauge covariance'
+   CALL hall_response(energies + 2.3_dp, current, 2.4_dp, 0.15_dp, 0.07_dp, check, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall - check)) > 2.e-12_dp) ERROR STOP 'Energy zero covariance'
+   changed = current([3, 1, 4, 2], [3, 1, 4, 2], :)
+   CALL hall_response(energies([3, 1, 4, 2]), changed, 0.1_dp, 0.15_dp, 0.07_dp, check, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall - check)) > 2.e-12_dp) ERROR STOP 'Band permutation covariance'
+   CALL hall_response(energies, CONJG(current), 0.1_dp, 0.15_dp, 0.07_dp, check, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(hall + check)) > 2.e-12_dp) ERROR STOP 'Time-reversed Hall sign'
+   rotation = RESHAPE([0.6_dp, 0.8_dp, 0.0_dp, -0.8_dp, 0.6_dp, 0.0_dp, &
+                       0.0_dp, 0.0_dp, -1.0_dp], [3, 3])
+   changed = 0.0_dp
+   DO a = 1, 3
+      DO b = 1, 3
+         changed(:, :, a) = changed(:, :, a) + rotation(a, b)*current(:, :, b)
+      END DO
+   END DO
+   CALL hall_response(energies, changed, 0.1_dp, 0.15_dp, 0.07_dp, check, status)
+   reference = MATMUL(rotation, MATMUL(hall, TRANSPOSE(rotation)))
+   IF (status /= 0 .OR. MAXVAL(ABS(reference - check)) > 2.e-12_dp) ERROR STOP 'Cartesian tensor covariance'
+
+   CALL hall_response(energies, current, 0.0_dp, 0.0_dp, 0.1_dp, check, status)
+   IF (status == 0) ERROR STOP 'Zero temperature accepted'
+   CALL hall_response(energies, current, 0.0_dp, 0.1_dp, 0.0_dp, check, status)
+   IF (status == 0) ERROR STOP 'Zero relaxation accepted'
+   CALL hall_response(energies, current, ieee_value(0.0_dp, ieee_quiet_nan), 0.1_dp, 0.1_dp, check, status)
+   IF (status == 0) ERROR STOP 'NaN chemical potential accepted'
+   changed = current
+   changed(1, 2, 1) = changed(1, 2, 1) + 0.1_dp
+   CALL hall_response(energies, changed, 0.0_dp, 0.1_dp, 0.1_dp, check, status)
+   IF (status == 0) ERROR STOP 'Non-anti-Hermitian current accepted'
+
+   ! Two-band lattice model: compare every point against analytic Berry curvature,
+   ! then integrate its two opposite Chern phases and a trivial phase.
+   masses = [-1.0_dp, 1.0_dp, 3.0_dp]
+   expected = [-1.0_dp, 1.0_dp, 0.0_dp]
+   s2 = 0.0_dp
+   s2(1, 1) = 1.0_dp
+   s2(2, 2) = 1.0_dp
+   ds2 = 0.0_dp
+   d2 = 0.0_dp
+   gamma = 1.e-3_dp
+   DO imass = 1, 3
+      mass = masses(imass)
+      integrated = 0.0_dp
+      curvature = 0.0_dp
+      error = 0.0_dp
+      gauge_error = 0.0_dp
+      DO iy = 0, mesh - 1
+         ky = 2*pi*REAL(iy, dp)/mesh
+         DO ix = 0, mesh - 1
+            kx = 2*pi*REAL(ix, dp)/mesh
+            h2(1, 1) = mass + COS(kx) + COS(ky)
+            h2(2, 2) = -h2(1, 1)
+            h2(1, 2) = SIN(kx) - iu*SIN(ky)
+            h2(2, 1) = CONJG(h2(1, 2))
+            dh2 = 0.0_dp
+            dh2(1, 1, 1) = -SIN(kx)
+            dh2(2, 2, 1) = SIN(kx)
+            dh2(1, 2, 1) = COS(kx)
+            dh2(2, 1, 1) = COS(kx)
+            dh2(1, 1, 2) = -SIN(ky)
+            dh2(2, 2, 2) = SIN(ky)
+            dh2(1, 2, 2) = -iu*COS(ky)
+            dh2(2, 1, 2) = iu*COS(ky)
+            CALL bloch_current(h2, s2, dh2, ds2, d2, e2, j2, status)
+            IF (status /= 0) ERROR STOP 'Chern-model Bloch current'
+            CALL hall_response(e2, j2, 0.0_dp, 0.01_dp, gamma, check, status)
+            IF (status /= 0) ERROR STOP 'Chern-model Hall kernel'
+            radius = SQRT(SIN(kx)**2 + SIN(ky)**2 + (mass + COS(kx) + COS(ky))**2)
+            omega = (COS(kx) + COS(ky) + mass*COS(kx)*COS(ky))/(2*radius**3)
+            analytic = -omega*4*radius**2/(4*radius**2 + gamma**2)*TANH(radius/0.02_dp)
+            error = MAX(error, ABS(check(1, 2) - analytic))
+            CALL ao_gauge_reference(kx, ky, h2, dh2, gamma, reference)
+            gauge_error = MAX(gauge_error, MAXVAL(ABS(check - reference)))
+            integrated = integrated + check(1, 2)*2*pi/mesh**2
+            curvature = curvature + omega*2*pi/mesh**2
+         END DO
+      END DO
+      IF (error > 1.e-12_dp) ERROR STOP 'Analytic Berry-curvature response mismatch'
+      IF (ABS(integrated - expected(imass)) > 1.e-6_dp) ERROR STOP 'Chern Hall limit'
+      IF (ABS(curvature + expected(imass)) > 1.e-10_dp) ERROR STOP 'Independent Chern integral'
+      IF (gauge_error > 1.e-12_dp) ERROR STOP 'Nonorthogonal AO Hall covariance'
+      PRINT '(A,F5.1,3ES18.10)', 'Hall Chern model mass, sigma, Chern, residual: ', mass, integrated, curvature, error
+      PRINT '(A,ES14.6)', 'Hall k-dependent nonorthogonal AO residual: ', gauge_error
+   END DO
+   PRINT *, 'Hall sign, Liouvillian, gauge, time reversal, degeneracy and Chern tests passed.'
+CONTAINS
+! **************************************************************************************************
+!> \brief Transform the lattice model to a k-dependent nonorthogonal AO frame.
+!> \param kx First wave-vector component
+!> \param ky Second wave-vector component
+!> \param h Orthogonal Hamiltonian
+!> \param dh Its Cartesian derivatives
+!> \param gamma Relaxation energy
+!> \param hall Hall response in the transformed AO frame
+! **************************************************************************************************
+   SUBROUTINE ao_gauge_reference(kx, ky, h, dh, gamma, hall)
+      REAL(dp), INTENT(IN)                               :: kx, ky
+      COMPLEX(dp), INTENT(IN)                            :: h(2, 2), dh(2, 2, 3)
+      REAL(dp), INTENT(IN)                               :: gamma
+      REAL(dp), INTENT(OUT)                              :: hall(3, 3)
+
+      COMPLEX(dp)                                        :: basis(2, 2), db(2, 2, 3), dhx(2, 2, 3), &
+                                                            dsx(2, 2, 3), dx(2, 2, 3), hx(2, 2), &
+                                                            jx(2, 2, 3), sx(2, 2)
+      INTEGER                                            :: a, status
+      REAL(dp)                                           :: e(2)
+
+      basis = 0.0_dp
+      basis(1, 1) = 1.1_dp + 0.1_dp*COS(kx)
+      basis(2, 2) = 0.9_dp + 0.1_dp*SIN(ky)
+      basis(1, 2) = 0.13_dp*EXP(iu*(kx + ky))
+      basis(2, 1) = 0.07_dp*EXP(iu*(2*kx - ky))
+      db = 0.0_dp
+      db(1, 1, 1) = -0.1_dp*SIN(kx)
+      db(2, 2, 2) = 0.1_dp*COS(ky)
+      db(1, 2, 1:2) = iu*basis(1, 2)
+      db(2, 1, 1) = 2*iu*basis(2, 1)
+      db(2, 1, 2) = -iu*basis(2, 1)
+      hx = MATMUL(CONJG(TRANSPOSE(basis)), MATMUL(h, basis))
+      sx = MATMUL(CONJG(TRANSPOSE(basis)), basis)
+      DO a = 1, 3
+         dhx(:, :, a) = MATMUL(CONJG(TRANSPOSE(basis)), MATMUL(dh(:, :, a), basis)) + &
+                        MATMUL(CONJG(TRANSPOSE(db(:, :, a))), MATMUL(h, basis)) + &
+                        MATMUL(CONJG(TRANSPOSE(basis)), MATMUL(h, db(:, :, a)))
+         dsx(:, :, a) = MATMUL(CONJG(TRANSPOSE(db(:, :, a))), basis) + &
+                        MATMUL(CONJG(TRANSPOSE(basis)), db(:, :, a))
+         dx(:, :, a) = -iu*MATMUL(CONJG(TRANSPOSE(db(:, :, a))), basis) + REAL(a, dp)*sx
+      END DO
+      CALL bloch_current(hx, sx, dhx, dsx, dx, e, jx, status)
+      IF (status /= 0) ERROR STOP 'Nonorthogonal AO Chern model'
+      CALL hall_response(e, jx, 0.0_dp, 0.01_dp, gamma, hall, status)
+      IF (status /= 0) ERROR STOP 'Nonorthogonal AO Hall kernel'
+   END SUBROUTINE ao_gauge_reference
+
+! **************************************************************************************************
+!> \brief Invert the full complex Liouvillian in a nondiagonal four-level frame.
+!> \param e Eigenvalues
+!> \param currents Anti-Hermitian currents in the diagonal frame
+!> \param mu Chemical potential
+!> \param kt Temperature
+!> \param gamma Relaxation rate
+!> \param sigma Complete real DC tensor without physical prefactors
+! **************************************************************************************************
+   SUBROUTINE liouville_reference(e, currents, mu, kt, gamma, sigma)
+      REAL(dp), INTENT(IN)                               :: e(4)
+      COMPLEX(dp), INTENT(IN)                            :: currents(4, 4, 3)
+      REAL(dp), INTENT(IN)                               :: mu, kt, gamma
+      REAL(dp), INTENT(OUT)                              :: sigma(3, 3)
+
+      COMPLEX(dp)                                        :: basis(4, 4), drive(4, 4), h(4, 4), &
+                                                            liouvillian(16, 16), response(4, 4), &
+                                                            rhs(16, 3), trace, v(4, 4, 3)
+      INTEGER                                            :: a, b, column, i, info, j, k, l, &
+                                                            pivot(16), row
+
+      DO j = 1, 4
+         DO i = 1, 4
+            basis(i, j) = EXP(iu*2*pi*REAL((i - 1)*(j - 1), dp)/4)/2
+         END DO
+      END DO
+      h = 0.0_dp
+      DO i = 1, 4
+         h(i, i) = e(i)
+      END DO
+      h = MATMUL(basis, MATMUL(h, CONJG(TRANSPOSE(basis))))
+      DO a = 1, 3
+         v(:, :, a) = MATMUL(basis, MATMUL(iu*currents(:, :, a), CONJG(TRANSPOSE(basis))))
+         DO j = 1, 4
+            DO i = 1, 4
+               drive(i, j) = fermi_slope(e(i), e(j), mu, kt)*iu*currents(i, j, a)
+            END DO
+         END DO
+         drive = MATMUL(basis, MATMUL(drive, CONJG(TRANSPOSE(basis))))
+         rhs(:, a) = RESHAPE(drive, [16])
+      END DO
+      liouvillian = 0.0_dp
+      DO j = 1, 4
+         DO i = 1, 4
+            row = i + 4*(j - 1)
+            liouvillian(row, row) = gamma
+            DO l = 1, 4
+               DO k = 1, 4
+                  column = k + 4*(l - 1)
+                  IF (j == l) liouvillian(row, column) = liouvillian(row, column) + iu*h(i, k)
+                  IF (i == k) liouvillian(row, column) = liouvillian(row, column) - iu*h(l, j)
+               END DO
+            END DO
+         END DO
+      END DO
+      CALL zgesv(16, 3, liouvillian, 16, pivot, rhs, 16, info)
+      IF (info /= 0) ERROR STOP 'Liouvillian solve failed'
+      DO b = 1, 3
+         response = RESHAPE(rhs(:, b), [4, 4])
+         DO a = 1, 3
+            trace = SUM(v(:, :, a)*TRANSPOSE(response))
+            sigma(a, b) = -REAL(trace, dp)
+         END DO
+      END DO
+   END SUBROUTINE liouville_reference
+END PROGRAM kubo_hall_unittest
diff --git a/src/kubo_projected.F b/src/kubo_projected.F
new file mode 100644
index 0000000000000000000000000000000000000000..8c3db65bb3f3e9fcddb9a8f2535ecc88926e2d75
--- /dev/null
+++ b/src/kubo_projected.F
@@ -0,0 +1,139 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Finite projected-Hamiltonian current in a nonorthogonal, possibly spinor AO basis.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE kubo_projected
+   USE ieee_arithmetic, ONLY: ieee_is_finite
+#if defined(__HAS_IEEE_EXCEPTIONS)
+   USE ieee_exceptions, ONLY: IEEE_ALL, ieee_get_halting_mode, ieee_set_halting_mode
+#endif
+   USE kinds, ONLY: dp
+   IMPLICIT NONE
+   PRIVATE
+   PUBLIC :: projected_current, projected_eigensystem
+CONTAINS
+! **************************************************************************************************
+!> \brief Compute C^dagger (H S^-1 X - X S^-1 H) C without forming S^-1.
+!> \param h Complete scalar/spinor covariant Hamiltonian, not an occupied-state projection
+!> \param s Positive definite overlap, with explicit spin blocks when applicable
+!> \param positions Three analytic covariant Cartesian first moments
+!> \param energies Eigenvalues of H C = S C E
+!> \param current Anti-Hermitian commutators in the eigenbasis; velocity is i*current in atomic units
+!> \param status 0 success; -1 invalid matrices; -2 ill-conditioned metric; positive LAPACK failure
+!> \note This is the commutator of projected operators. It is not the projection of the
+!>       continuum commutator in an incomplete basis, nor a periodic Berry velocity.
+! **************************************************************************************************
+   SUBROUTINE projected_current(h, s, positions, energies, current, status)
+      COMPLEX(dp), INTENT(IN)                            :: h(:, :), s(:, :), positions(:, :, :)
+      REAL(dp), INTENT(OUT)                              :: energies(:)
+      COMPLEX(dp), INTENT(OUT)                           :: current(:, :, :)
+      INTEGER, INTENT(OUT)                               :: status
+
+      COMPLEX(dp), ALLOCATABLE                           :: c(:, :), moment(:, :)
+      INTEGER                                            :: axis, i, j, n
+
+      status = -1
+      energies = 0.0_dp
+      current = 0.0_dp
+      n = SIZE(h, 1)
+      IF (n < 1 .OR. SIZE(h, 2) /= n .OR. ANY(SHAPE(s) /= [n, n])) RETURN
+      IF (SIZE(energies) /= n .OR. ANY(SHAPE(current) /= [n, n, 3])) RETURN
+      IF (ANY(SHAPE(positions) /= [n, n, 3])) RETURN
+      IF (.NOT. valid_hermitian(h) .OR. .NOT. valid_hermitian(s)) RETURN
+      DO axis = 1, 3
+         IF (.NOT. valid_hermitian(positions(:, :, axis))) RETURN
+      END DO
+      ALLOCATE (c(n, n), moment(n, n))
+      CALL projected_eigensystem(h, s, energies, c, status)
+      IF (status /= 0) RETURN
+      status = -1
+      DO axis = 1, 3
+         moment = MATMUL(CONJG(TRANSPOSE(c)), MATMUL(positions(:, :, axis), c))
+         DO j = 1, n
+            DO i = 1, n
+               current(i, j, axis) = (energies(i) - energies(j))*moment(i, j)
+            END DO
+         END DO
+      END DO
+      IF (.NOT. ALL(ieee_is_finite(REAL(current, dp)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(AIMAG(current)))) RETURN
+      status = 0
+   END SUBROUTINE projected_current
+! **************************************************************************************************
+!> \brief Complete generalized eigensystem with a positive, well-conditioned AO metric.
+!> \param h Hermitian covariant Hamiltonian
+!> \param s Hermitian positive definite overlap
+!> \param energies Complete spectrum
+!> \param c Metric-orthonormal eigenvectors
+!> \param status 0 success; -1 invalid matrices; -2 metric failure; positive LAPACK failure
+! **************************************************************************************************
+   SUBROUTINE projected_eigensystem(h, s, energies, c, status)
+      COMPLEX(dp), INTENT(IN) :: h(:, :), s(:, :)
+      REAL(dp), INTENT(OUT) :: energies(:)
+      COMPLEX(dp), INTENT(OUT) :: c(:, :)
+      INTEGER, INTENT(OUT) :: status
+
+      COMPLEX(dp), ALLOCATABLE :: b(:, :), work(:)
+      REAL(dp), ALLOCATABLE :: rwork(:)
+      INTEGER :: n, info
+#if defined(__HAS_IEEE_EXCEPTIONS)
+      LOGICAL :: halt(SIZE(IEEE_ALL))
+#endif
+
+      status = -1
+      energies = 0.0_dp
+      c = 0.0_dp
+      n = SIZE(h, 1)
+      IF (n < 1 .OR. SIZE(h, 2) /= n .OR. ANY(SHAPE(s) /= [n, n])) RETURN
+      IF (SIZE(energies) /= n .OR. ANY(SHAPE(c) /= [n, n])) RETURN
+      IF (.NOT. valid_hermitian(h) .OR. .NOT. valid_hermitian(s)) RETURN
+      ALLOCATE (b(n, n), work(MAX(1, 2*n)), rwork(MAX(1, 3*n)))
+      b = s
+#if defined(__HAS_IEEE_EXCEPTIONS)
+      CALL ieee_get_halting_mode(IEEE_ALL, halt)
+      CALL ieee_set_halting_mode(IEEE_ALL, .FALSE.)
+#endif
+      CALL zheev('N', 'U', n, b, n, energies, work, SIZE(work), rwork, info)
+#if defined(__HAS_IEEE_EXCEPTIONS)
+      CALL ieee_set_halting_mode(IEEE_ALL, halt)
+#endif
+      status = ABS(info) + 1
+      IF (info /= 0 .OR. .NOT. ALL(ieee_is_finite(energies))) RETURN
+      status = -2
+      IF (MAXVAL(energies) <= 0.0_dp) RETURN
+      IF (MINVAL(energies) <= 1.e-10_dp*MAXVAL(energies)) RETURN
+      c = h
+      b = s
+#if defined(__HAS_IEEE_EXCEPTIONS)
+      CALL ieee_set_halting_mode(IEEE_ALL, .FALSE.)
+#endif
+      CALL zhegv(1, 'V', 'U', n, c, n, b, n, energies, work, SIZE(work), rwork, info)
+#if defined(__HAS_IEEE_EXCEPTIONS)
+      CALL ieee_set_halting_mode(IEEE_ALL, halt)
+#endif
+      status = ABS(info) + 1
+      IF (info /= 0 .OR. .NOT. ALL(ieee_is_finite(energies))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(REAL(c, dp)))) RETURN
+      IF (.NOT. ALL(ieee_is_finite(AIMAG(c)))) RETURN
+      status = 0
+   END SUBROUTINE projected_eigensystem
+! **************************************************************************************************
+!> \brief Reject nonfinite or non-Hermitian data instead of discarding a triangle.
+!> \param a Covariant matrix
+!> \return Whether both components are finite and Hermitian within tolerance
+! **************************************************************************************************
+   LOGICAL FUNCTION valid_hermitian(a) RESULT(valid)
+      COMPLEX(dp), INTENT(IN)                            :: a(:, :)
+
+      valid = ALL(ieee_is_finite(REAL(a, dp))) .AND. ALL(ieee_is_finite(AIMAG(a)))
+      IF (.NOT. valid) RETURN
+      valid = MAXVAL(ABS(a - CONJG(TRANSPOSE(a)))) <= 1.e-10_dp*MAX(TINY(1.0_dp), MAXVAL(ABS(a)))
+   END FUNCTION valid_hermitian
+END MODULE kubo_projected
diff --git a/src/kubo_projected_unittest.F b/src/kubo_projected_unittest.F
new file mode 100644
index 0000000000000000000000000000000000000000..f7e0c5d6aa77ea473af9e3016f84b50e13186649
--- /dev/null
+++ b/src/kubo_projected_unittest.F
@@ -0,0 +1,77 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+PROGRAM kubo_projected_unittest
+   USE kinds,                           ONLY: dp
+   USE kubo_projected,                  ONLY: projected_current
+
+   IMPLICIT NONE
+   COMPLEX(dp) :: h(4, 4), s(4, 4), x(4, 4, 3), b(4, 4), h2(4, 4), s2(4, 4), x2(4, 4, 3)
+   COMPLEX(dp) :: j(4, 4, 3), j2(4, 4, 3), norm(3, 3), norm2(3, 3)
+   REAL(dp) :: e(4), e2(4)
+   INTEGER :: a, c, i, status
+
+   h = 0.0_dp
+   s = 0.0_dp
+   x = 0.0_dp
+   DO i = 1, 4
+      s(i, i) = 1.0_dp
+   END DO
+   ! Kramers-degenerate spinor model with imaginary SOC matrix elements.
+   h(2, 2) = 0.8_dp
+   h(4, 4) = 0.8_dp
+   h(1, 2) = CMPLX(0.0_dp, 0.3_dp, dp)
+   h(2, 1) = CONJG(h(1, 2))
+   h(3, 4) = CONJG(h(1, 2))
+   h(4, 3) = h(1, 2)
+   x(1, 2, 1) = 1.0_dp
+   x(2, 1, 1) = 1.0_dp
+   x(3, 4, 1) = 1.0_dp
+   x(4, 3, 1) = 1.0_dp
+   x(1, 1, 2) = -0.5_dp
+   x(2, 2, 2) = 0.5_dp
+   x(3, 3, 2) = -0.5_dp
+   x(4, 4, 2) = 0.5_dp
+   x(:, :, 3) = 2*x(:, :, 1) - x(:, :, 2)
+   CALL projected_current(h, s, x, e, j, status)
+   IF (status /= 0) ERROR STOP 'Spinor current failed'
+   IF (MAXVAL(ABS(e - [-0.1_dp, -0.1_dp, 0.9_dp, 0.9_dp])) > 1.e-12_dp) ERROR STOP 'Spinor spectrum failed'
+   DO a = 1, 3
+      IF (MAXVAL(ABS(j(:, :, a) + CONJG(TRANSPOSE(j(:, :, a))))) > 1.e-12_dp) ERROR STOP 'Current is not anti-Hermitian'
+      DO c = 1, 3
+         norm(a, c) = SUM(CONJG(j(:, :, a))*j(:, :, c))
+      END DO
+   END DO
+   IF (ABS(norm(1, 1) - 4.0_dp) > 1.e-12_dp) ERROR STOP 'Analytic current strength failed'
+   ! Complex nonorthogonal basis mixing spin and orbitals, including a degenerate subspace.
+   b = s
+   b(1, 1) = 1.7_dp
+   b(2, 2) = 0.8_dp
+   b(3, 1) = CMPLX(0.2_dp, 0.4_dp, dp)
+   b(1, 4) = CMPLX(-0.3_dp, 0.1_dp, dp)
+   b(2, 3) = 0.4_dp
+   h2 = MATMUL(CONJG(TRANSPOSE(b)), MATMUL(h, b))
+   s2 = MATMUL(CONJG(TRANSPOSE(b)), b)
+   DO a = 1, 3
+      x2(:, :, a) = MATMUL(CONJG(TRANSPOSE(b)), MATMUL(x(:, :, a), b)) + REAL(a, dp)*s2
+   END DO
+   CALL projected_current(h2, s2, x2, e2, j2, status)
+   IF (status /= 0 .OR. MAXVAL(ABS(e - e2)) > 1.e-12_dp) ERROR STOP 'Nonorthogonal current spectrum failed'
+   DO a = 1, 3
+      DO c = 1, 3
+         norm2(a, c) = SUM(CONJG(j2(:, :, a))*j2(:, :, c))
+      END DO
+   END DO
+   IF (MAXVAL(ABS(norm - norm2)) > 1.e-11_dp) ERROR STOP 'Basis/origin/gauge invariance failed'
+   s(1, 1) = -1.0_dp
+   CALL projected_current(h, s, x, e, j, status)
+   IF (status /= -2) ERROR STOP 'Indefinite overlap accepted'
+   s(1, 1) = 1.0_dp
+   x(1, 2, 1) = 2.0_dp
+   CALL projected_current(h, s, x, e, j, status)
+   IF (status /= -1) ERROR STOP 'Non-Hermitian position accepted'
+   PRINT *, 'Projected spinor current, metric and gauge tests passed.'
+END PROGRAM kubo_projected_unittest
diff --git a/src/localizer_sparse_inertia.F b/src/localizer_sparse_inertia.F
new file mode 100644
index 0000000000000000000000000000000000000000..9979240ceccfe91000e1b28a0c2efb1dc3aee3b7
--- /dev/null
+++ b/src/localizer_sparse_inertia.F
@@ -0,0 +1,347 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations                              !
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>                                   !
+!                                                                                                  !
+!   SPDX-License-Identifier: GPL-2.0-or-later                                                      !
+!--------------------------------------------------------------------------------------------------!
+
+! **************************************************************************************************
+!> \brief Optional distributed sparse LDL inertia with reusable symbolic analysis.
+!> \author Thomas D. Kuehne, tkuehne@cp2k.org
+! **************************************************************************************************
+MODULE localizer_sparse_inertia
+   USE ieee_arithmetic,                 ONLY: ieee_is_finite
+   USE kinds,                           ONLY: dp,&
+                                              int_8
+   USE message_passing,                 ONLY: mp_para_env_type
+
+   IMPLICIT NONE
+   PRIVATE
+#if defined(__MUMPS)
+   INCLUDE 'dmumps_struc.h'
+#endif
+   PUBLIC :: sparse_inertia_type, sparse_inertia_available, sparse_inertia_start, &
+             sparse_inertia_count, sparse_inertia_finish
+   PUBLIC :: sparse_metric_start, sparse_metric_solve
+
+   TYPE sparse_inertia_type
+#if defined(__MUMPS)
+      TYPE(DMUMPS_STRUC) :: solver
+#endif
+      LOGICAL :: initialized = .FALSE.
+      LOGICAL :: factor_valid = .FALSE.
+      INTEGER :: order = 0, factorizations = 0, error_code = 0, error_detail = 0, workspace_retries = 0
+      INTEGER(KIND=int_8) :: factor_entries = 0, input_entries = 0, factor_workspace_entries = 0
+      REAL(KIND=dp) :: peak_memory_mb = 0.0_dp
+   END TYPE sparse_inertia_type
+
+CONTAINS
+
+! **************************************************************************************************
+!> \brief Whether the optional sparse inertia backend is linked.
+!> \return Backend availability
+! **************************************************************************************************
+   LOGICAL FUNCTION sparse_inertia_available()
+      sparse_inertia_available = .FALSE.
+#if defined(__MUMPS)
+      sparse_inertia_available = .TRUE.
+#endif
+   END FUNCTION sparse_inertia_available
+
+! **************************************************************************************************
+!> \brief Analyze one distributed, lower-triangular coordinate pattern. Duplicates are summed.
+!> \param state Caller-owned factorization context
+!> \param order Real matrix order
+!> \param rows Local one-based row coordinates
+!> \param cols Local one-based column coordinates
+!> \param para_env Communicator for collective calls
+!> \param status Zero on success; negative for invalid input or unavailable backend
+!> \param positive_definite Use the non-pivoting SPD path, with negative-pivot checks still required
+! **************************************************************************************************
+   SUBROUTINE sparse_inertia_start(state, order, rows, cols, para_env, status, positive_definite)
+      TYPE(sparse_inertia_type), INTENT(INOUT) :: state
+      INTEGER, INTENT(IN) :: order, rows(:), cols(:)
+      TYPE(mp_para_env_type), POINTER :: para_env
+      INTEGER, INTENT(OUT) :: status
+      LOGICAL, INTENT(IN), OPTIONAL :: positive_definite
+#if defined(__MUMPS)
+      INTEGER :: invalid
+
+      invalid = 0
+      IF (state%initialized .OR. order < 1 .OR. SIZE(rows) /= SIZE(cols)) invalid = 1
+      IF (ANY(rows < 1) .OR. ANY(rows > order) .OR. ANY(cols < 1)) invalid = 1
+      IF (SIZE(rows) == SIZE(cols)) THEN
+         IF (ANY(cols > rows)) invalid = 1
+      END IF
+      CALL para_env%max(invalid)
+      status = -1
+      IF (invalid /= 0) RETURN
+      state%solver%COMM = para_env%get_handle()
+      state%solver%PAR = 1
+      state%solver%SYM = 2
+      IF (PRESENT(positive_definite)) THEN
+         IF (positive_definite) state%solver%SYM = 1
+      END IF
+      state%solver%JOB = -1
+      CALL dmumps(state%solver)
+      state%error_code = state%solver%INFOG(1)
+      state%error_detail = state%solver%INFOG(2)
+      status = -4
+      IF (state%error_code /= 0) RETURN
+      state%initialized = .TRUE.
+      state%order = order
+      state%factorizations = 0
+      state%workspace_retries = 0
+      state%factor_entries = 0
+      state%factor_workspace_entries = 0
+      state%peak_memory_mb = 0.0_dp
+      state%input_entries = INT(SIZE(rows), int_8)
+      CALL para_env%sum(state%input_entries)
+      state%solver%N = order
+      state%solver%NZ_LOC = SIZE(rows)
+      ALLOCATE (state%solver%IRN_LOC(SIZE(rows)), state%solver%JCN_LOC(SIZE(rows)), &
+                state%solver%A_LOC(SIZE(rows)))
+      state%solver%IRN_LOC = rows
+      state%solver%JCN_LOC = cols
+      state%solver%A_LOC = 0.0_dp
+      state%solver%ICNTL(1:3) = -1
+      state%solver%ICNTL(4) = 0
+      state%solver%ICNTL(6) = 0
+      state%solver%ICNTL(8) = 0
+      ! The ScaLAPACK root-node LU does not report its inertia: force root LDL, retain other MPI work.
+      state%solver%ICNTL(13) = 1
+      state%solver%ICNTL(18) = 3
+      state%solver%ICNTL(24) = 0
+      state%solver%ICNTL(35) = 0
+      state%solver%CNTL(1) = 0.01_dp
+      state%solver%CNTL(4) = -1.0_dp
+      state%solver%JOB = 1
+      CALL dmumps(state%solver)
+      state%error_code = state%solver%INFOG(1)
+      state%error_detail = state%solver%INFOG(2)
+      status = 0
+      IF (state%error_code /= 0) status = -4
+#else
+      status = -5
+#endif
+   END SUBROUTINE sparse_inertia_start
+
+! **************************************************************************************************
+!> \brief Numerically factor the same pattern, with no static pivot perturbation or compression.
+!> \param state Analyzed factorization context
+!> \param values Local lower-triangle values
+!> \param para_env Communicator for collective calls
+!> \param negative Number of negative eigenvalues of the real matrix
+!> \param status 0 success, 1 singular, -4 numerical failure, -5 backend unavailable
+! **************************************************************************************************
+   SUBROUTINE sparse_inertia_count(state, values, para_env, negative, status)
+      TYPE(sparse_inertia_type), INTENT(INOUT) :: state
+      REAL(KIND=dp), INTENT(IN) :: values(:)
+      TYPE(mp_para_env_type), POINTER :: para_env
+      INTEGER, INTENT(OUT) :: negative, status
+#if defined(__MUMPS)
+      INTEGER :: invalid, entries, attempt, i
+      INTEGER, ALLOCATABLE :: row_support(:)
+
+      negative = 0
+      state%factor_valid = .FALSE.
+      invalid = 0
+      IF (.NOT. state%initialized) invalid = 1
+      IF (state%initialized) THEN
+         IF (SIZE(values) /= state%solver%NZ_LOC) invalid = 1
+      END IF
+      IF (.NOT. ALL(ieee_is_finite(values))) invalid = 1
+      CALL para_env%max(invalid)
+      status = -4
+      IF (invalid /= 0) RETURN
+      ! At an exact gap endpoint a shifted pencil may contain whole zero rows.
+      ! Detect these before delayed pivots consume MUMPS's workspace. Additive
+      ! duplicate cancellation may hide other zero rows, but cannot give a false one.
+      ALLOCATE (row_support(state%order))
+      row_support = 0
+      DO i = 1, SIZE(values)
+         IF (values(i) == 0.0_dp) CYCLE
+         row_support(state%solver%IRN_LOC(i)) = 1
+         row_support(state%solver%JCN_LOC(i)) = 1
+      END DO
+      CALL para_env%max(row_support)
+      IF (ANY(row_support == 0)) THEN
+         status = 1
+         RETURN
+      END IF
+      state%solver%A_LOC = values
+      state%solver%JOB = 2
+      DO attempt = 1, 6
+         CALL dmumps(state%solver)
+         state%error_code = state%solver%INFOG(1)
+         state%error_detail = state%solver%INFOG(2)
+         state%factorizations = state%factorizations + 1
+         ! Numerical fill can exceed the symbolic estimate; MUMPS permits retrying JOB=2.
+         IF (.NOT. ANY(state%error_code == [-8, -9, -17, -20])) EXIT
+         IF (attempt == 6 .OR. state%solver%ICNTL(14) >= 640) EXIT
+         state%solver%ICNTL(14) = MIN(640, MAX(40, 2*state%solver%ICNTL(14)))
+         state%workspace_retries = state%workspace_retries + 1
+      END DO
+      IF (state%solver%INFOG(1) == -10) THEN
+         status = 1
+         RETURN
+      END IF
+      IF (state%solver%INFOG(1) /= 0) RETURN
+      negative = state%solver%INFOG(12)
+      entries = state%solver%INFOG(9)
+      IF (entries >= 0) THEN
+         state%factor_workspace_entries = MAX(state%factor_workspace_entries, INT(entries, int_8))
+      ELSE
+         state%factor_workspace_entries = MAX(state%factor_workspace_entries, -INT(entries, int_8)*1000000_int_8)
+      END IF
+      entries = state%solver%INFOG(29)
+      IF (entries >= 0) THEN
+         state%factor_entries = MAX(state%factor_entries, INT(entries, int_8))
+      ELSE
+         state%factor_entries = MAX(state%factor_entries, -INT(entries, int_8)*1000000_int_8)
+      END IF
+      state%peak_memory_mb = MAX(state%peak_memory_mb, REAL(state%solver%INFOG(22), dp))
+      state%factor_valid = .TRUE.
+      status = 0
+#else
+      negative = 0
+      status = -5
+#endif
+   END SUBROUTINE sparse_inertia_count
+
+! **************************************************************************************************
+!> \brief Validate a sparse SPD metric and retain its factors for repeated right hand sides.
+!> \param state New factorization context
+!> \param order Matrix dimension
+!> \param rows Distributed lower COO rows
+!> \param cols Distributed lower COO columns
+!> \param values Additive metric entries
+!> \param identity Identity on the same COO pattern
+!> \param tolerance Lower condition-ratio threshold
+!> \param para_env Communicator
+!> \param ratio Conservative lower eigenvalue/row-norm ratio
+!> \param status 0 success, -2 invalid metric, -4 solver failure, -5 unavailable
+! **************************************************************************************************
+   SUBROUTINE sparse_metric_start(state, order, rows, cols, values, identity, tolerance, para_env, ratio, status)
+      TYPE(sparse_inertia_type), INTENT(INOUT)           :: state
+      INTEGER, INTENT(IN)                                :: order, rows(:), cols(:)
+      REAL(dp), INTENT(IN)                               :: values(:), identity(:), tolerance
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      REAL(dp), INTENT(OUT)                              :: ratio
+      INTEGER, INTENT(OUT)                               :: status
+
+      INTEGER                                            :: i, info, invalid, negative
+      REAL(dp)                                           :: lower, upper
+      REAL(dp), ALLOCATABLE                              :: shifted(:), sums(:)
+
+      ratio = 0.0_dp
+      invalid = 0
+      IF (SIZE(values) /= SIZE(rows) .OR. SIZE(identity) /= SIZE(rows)) invalid = 1
+      IF (.NOT. ieee_is_finite(tolerance)) invalid = 1
+      IF (tolerance <= 0.0_dp .OR. tolerance >= 1.0_dp) invalid = 1
+      IF (.NOT. ALL(ieee_is_finite(values)) .OR. .NOT. ALL(ieee_is_finite(identity))) invalid = 1
+      CALL para_env%max(invalid)
+      status = -2
+      IF (invalid /= 0) RETURN
+      CALL sparse_inertia_start(state, order, rows, cols, para_env, status, positive_definite=.TRUE.)
+      IF (status /= 0) RETURN
+      ALLOCATE (sums(order), shifted(SIZE(values)))
+      sums = 0.0_dp
+      DO i = 1, SIZE(values)
+         sums(rows(i)) = sums(rows(i)) + ABS(values(i))
+         IF (rows(i) /= cols(i)) sums(cols(i)) = sums(cols(i)) + ABS(values(i))
+      END DO
+      CALL para_env%sum(sums)
+      upper = MAXVAL(sums)
+      status = -2
+      IF (.NOT. ieee_is_finite(upper) .OR. upper <= TINY(1.0_dp)) RETURN
+      CALL sparse_inertia_count(state, values, para_env, negative, info)
+      IF (info < 0) status = info
+      IF (info /= 0 .OR. negative /= 0) RETURN
+      lower = 0.5_dp*upper
+      DO i = 1, 100
+         lower = MAX(lower, tolerance*upper*(1.0_dp + 16.0_dp*EPSILON(lower)))
+         shifted = values - lower*identity
+         CALL sparse_inertia_count(state, shifted, para_env, negative, info)
+         IF (info < 0) THEN
+            status = info
+            RETURN
+         END IF
+         IF (info == 0 .AND. negative == 0) THEN
+            ratio = lower/upper
+            EXIT
+         END IF
+         IF (lower <= tolerance*upper*(1.0_dp + 16.0_dp*EPSILON(lower))) RETURN
+         lower = lower*0.5_dp
+      END DO
+      IF (ratio <= tolerance) RETURN
+      CALL sparse_inertia_count(state, values, para_env, negative, status)
+      IF (status == 0 .AND. negative /= 0) status = -2
+   END SUBROUTINE sparse_metric_start
+
+! **************************************************************************************************
+!> \brief Collective repeated solves using existing MUMPS factors, without refactorization.
+!> \param state Successfully factored metric
+!> \param rhs Replicated right hand sides, replaced by replicated solutions
+!> \param para_env Communicator (MUMPS host is communicator rank zero)
+!> \param status 0 success, -4 failure, -5 unavailable
+! **************************************************************************************************
+   SUBROUTINE sparse_metric_solve(state, rhs, para_env, status)
+      TYPE(sparse_inertia_type), INTENT(INOUT) :: state
+      REAL(dp), CONTIGUOUS, INTENT(INOUT) :: rhs(:, :)
+      TYPE(mp_para_env_type), POINTER :: para_env
+      INTEGER, INTENT(OUT) :: status
+#if defined(__MUMPS)
+      INTEGER :: invalid, count
+      invalid = 0
+      IF (.NOT. state%factor_valid .OR. .NOT. state%initialized) invalid = 1
+      IF (SIZE(rhs, 1) /= state%order .OR. SIZE(rhs, 2) < 1) invalid = 1
+      IF (SIZE(rhs, KIND=int_8) > HUGE(count)) invalid = 1
+      IF (.NOT. ALL(ieee_is_finite(rhs))) invalid = 1
+      CALL para_env%max(invalid)
+      status = -4
+      IF (invalid /= 0) RETURN
+      state%solver%NRHS = SIZE(rhs, 2)
+      state%solver%LRHS = state%order
+      state%solver%ICNTL(20) = 0
+      state%solver%ICNTL(21) = 0
+      IF (para_env%mepos == 0) THEN
+         ALLOCATE (state%solver%RHS(SIZE(rhs)))
+         state%solver%RHS = RESHAPE(rhs, [SIZE(rhs)])
+      END IF
+      state%solver%JOB = 3
+      CALL dmumps(state%solver)
+      state%error_code = state%solver%INFOG(1)
+      state%error_detail = state%solver%INFOG(2)
+      IF (para_env%mepos == 0) THEN
+         rhs = RESHAPE(state%solver%RHS, SHAPE(rhs))
+         DEALLOCATE (state%solver%RHS)
+         NULLIFY (state%solver%RHS)
+      END IF
+      IF (state%error_code /= 0) RETURN
+      CALL para_env%bcast(rhs, 0)
+      IF (.NOT. ALL(ieee_is_finite(rhs))) RETURN
+      status = 0
+#else
+      status = -5
+#endif
+   END SUBROUTINE sparse_metric_solve
+
+! **************************************************************************************************
+!> \brief Release factors and caller-owned coordinate buffers collectively.
+!> \param state Factorization context, including a failed analysis
+! **************************************************************************************************
+   SUBROUTINE sparse_inertia_finish(state)
+      TYPE(sparse_inertia_type), INTENT(INOUT) :: state
+#if defined(__MUMPS)
+      IF (.NOT. state%initialized) RETURN
+      DEALLOCATE (state%solver%IRN_LOC, state%solver%JCN_LOC, state%solver%A_LOC)
+      NULLIFY (state%solver%IRN_LOC, state%solver%JCN_LOC, state%solver%A_LOC)
+      state%solver%JOB = -2
+      CALL dmumps(state%solver)
+#endif
+      state%initialized = .FALSE.
+      state%factor_valid = .FALSE.
+   END SUBROUTINE sparse_inertia_finish
+
+END MODULE localizer_sparse_inertia
